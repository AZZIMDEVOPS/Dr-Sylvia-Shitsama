---
// ClinicLocations.astro
const clinic = {
  name: 'Nairobi Clinic',
  status: 'Consultations Available',
  location: 'KNH Doctors\' Plaza, Suite 43',
  sublocation: 'Nairobi, Kenya',
  hours: 'Monday – Friday\n8:00 AM – 5:00 PM',
  mapUrl: 'https://maps.google.com/?q=KNH+Doctors+Plaza+Nairobi',
  bookUrl: '/contact?clinic=nairobi',
};
---

<section class="clinic-section relative bg-bg-primary overflow-hidden py-24 lg:py-32" id="clinic-locations">
  <!-- Subtle Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary z-0 pointer-events-none"></div>
  
  <!-- Subtle Radial Glow -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
    <div class="w-[80vw] h-[80vw] max-w-4xl max-h-4xl bg-accent/5 rounded-full blur-[100px]"></div>
  </div>

  <!-- 3D Location Visual Background -->
  <div class="absolute inset-0 z-0 flex items-center justify-center opacity-0 transition-opacity duration-1000" id="clinic-map-visual">
    <img 
      src="/images/premium_clinic_map.png" 
      alt="Abstract 3D location topography" 
      class="w-full h-full object-cover opacity-20 mix-blend-screen"
      loading="lazy"
      aria-hidden="true"
    />
  </div>

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- LEFT: Editorial Heading -->
      <div class="lg:col-span-5 clinic-fade-up">
        <span class="font-mono-label text-accent tracking-[0.2em] uppercase mb-6 block">Clinic Locations</span>
        
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-text-primary leading-[1.1] mb-6">
          Expert Care,<br />
          <span class="text-text-secondary">Close to You.</span>
        </h2>
        
        <p class="text-text-secondary text-lg leading-relaxed max-w-md font-light">
          Consultations available in Nairobi. Self-referrals and physician referrals are welcome.
        </p>
      </div>

      <!-- RIGHT: Elevated Clinic Card -->
      <div class="lg:col-span-7 flex justify-end">
        <div class="clinic-card-wrapper w-full max-w-[600px] clinic-fade-up" style="animation-delay: 150ms;">
          
          <div class="clinic-card bg-bg-secondary border border-border-subtle rounded-2xl p-8 sm:p-10 relative overflow-hidden transition-all duration-300 shadow-2xl backdrop-blur-sm">
            <!-- Subtle Orange Top Accent -->
            <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent opacity-50 card-accent-line transition-opacity duration-300"></div>
            
            <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-8 pb-8 border-b border-border-subtle">
              <div>
                <span class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase block mb-3">Clinic</span>
                <div class="flex items-center gap-3">
                  <!-- Animated Location Pin Icon -->
                  <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center card-icon-wrapper transition-colors duration-300">
                    <svg class="w-4 h-4 text-accent card-icon transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                    </svg>
                  </div>
                  <h3 class="font-display text-2xl font-semibold text-text-primary">{clinic.name}</h3>
                </div>
              </div>
              
              <!-- Status Label -->
              <div class="flex items-center gap-2 bg-accent/10 border border-accent/20 px-3 py-1.5 rounded-full">
                <div class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></div>
                <span class="font-mono-label text-[9px] text-accent tracking-widest uppercase">{clinic.status}</span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-10">
              <!-- Location Info -->
              <div>
                <span class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase block mb-3 flex items-center gap-2">
                  <svg class="w-3 h-3 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                  </svg>
                  Location
                </span>
                <p class="text-text-primary font-medium mb-1">{clinic.location}</p>
                <p class="text-text-secondary text-sm font-light">{clinic.sublocation}</p>
              </div>
              
              <!-- Hours Info -->
              <div>
                <span class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase block mb-3 flex items-center gap-2">
                  <svg class="w-3 h-3 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Consultation Hours
                </span>
                {clinic.hours.split('\n').map(line => (
                  <p class="text-text-primary font-medium text-sm leading-relaxed">{line}</p>
                ))}
              </div>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 w-full">
              <!-- Primary: Book Appointment -->
              <a href={clinic.bookUrl} class="btn-primary group flex-1 justify-center relative overflow-hidden focus-visible:ring-2 focus-visible:ring-accent outline-none">
                <span class="relative z-10 flex items-center justify-center gap-2">
                  Book Appointment
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
              </a>
              
              <!-- Secondary: Get Directions -->
              <a href={clinic.mapUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost-dark group flex-1 justify-center focus-visible:ring-2 focus-visible:ring-accent outline-none border border-border-strong hover:border-accent hover:bg-accent/5">
                <span class="flex items-center justify-center gap-2">
                  Get Directions
                  <svg class="w-4 h-4 text-accent transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/>
                  </svg>
                </span>
              </a>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Base structural styles */
  .clinic-section {
    perspective: 1000px;
  }

  .clinic-card {
    transform: translateY(0);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.4);
  }

  /* Hover micro-interactions */
  .clinic-card-wrapper:hover .clinic-card {
    transform: translateY(-5px);
    border-color: rgba(138, 155, 176, 0.4); /* Brighter border */
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.5);
  }

  .clinic-card-wrapper:hover .card-accent-line {
    opacity: 1;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }

  .clinic-card-wrapper:hover .card-icon-wrapper {
    background-color: rgba(193, 122, 62, 0.2);
  }

  .clinic-card-wrapper:hover .card-icon {
    transform: translateY(-2px);
  }

  /* Scroll Animations */
  .clinic-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .clinic-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .clinic-fade-up {
      transform: translateY(0);
      transition: opacity 0.8s ease-out;
    }
    
    .clinic-card-wrapper:hover .clinic-card {
      transform: translateY(0);
    }
    
    .clinic-card-wrapper:hover .card-icon {
      transform: translateY(0);
    }
    
    .group:hover svg {
      transform: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Intersection Observer for scroll animations
    const section = document.getElementById('clinic-locations');
    const mapVisual = document.getElementById('clinic-map-visual');
    const animatedElements = document.querySelectorAll('.clinic-fade-up');
    
    if (section) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Fade in background visual
            if (mapVisual) mapVisual.style.opacity = '1';
            
            // Trigger staggered fade ups
            animatedElements.forEach(el => {
              el.classList.add('is-visible');
            });
            
            // Stop observing once animated
            observer.disconnect();
          }
        });
      }, { rootMargin: '-10% 0px -10% 0px' });
      
      observer.observe(section);
    }
  });
</script>
