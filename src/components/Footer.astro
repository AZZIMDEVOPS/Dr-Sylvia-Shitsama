---
const currentYear = new Date().getFullYear();
const quickLinks = [
  { href: '/about', label: 'About' },
  { href: '/expertise', label: 'Specialisations' },
  { href: '/blog', label: 'Insights' },
  { href: '/about#recognition', label: 'Recognition' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-midnight-light text-text-secondary border-t border-border-subtle transition-colors duration-300">
  <!-- Main Footer Content -->
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Column 1: Brand + Social -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <!-- Sage Clinic Logo Graphic -->
          <div class="w-10 h-12 flex items-center justify-center relative shrink-0">
            <svg viewBox="0 0 75 120" class="w-full h-full drop-shadow-md text-ivory" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Silhouette Outline -->
              <path d="M45,2 C25,2 15,15 15,35 C15,50 25,60 15,90 C10,105 5,115 5,115" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none" />
              <path d="M45,2 C60,2 65,10 65,20 C65,25 60,28 65,33 C68,36 65,42 62,42 C58,42 58,48 62,52 C65,55 60,62 55,62" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <!-- Brain -->
              <path d="M30,12 C20,15 20,28 28,32 C35,36 45,36 50,30 C55,24 55,15 45,12 C40,10 35,10 30,12 Z" fill="none" stroke="#D4A853" stroke-width="2" stroke-linejoin="round"/>
              <path d="M28,20 C32,16 38,20 40,15 M32,26 C36,22 42,26 48,22 M25,25 C30,22 35,28 40,24" stroke="#D4A853" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <!-- Spine Dots -->
              <circle cx="23" cy="45" r="2.5" fill="#D4A853"/>
              <circle cx="25" cy="57" r="3.5" fill="#D4A853"/>
              <circle cx="25.5" cy="71" r="4.5" fill="#D4A853"/>
              <circle cx="22" cy="85" r="4" fill="#D4A853"/>
              <circle cx="16" cy="98" r="3" fill="#D4A853"/>
              <circle cx="9" cy="110" r="2" fill="#D4A853"/>
            </svg>
          </div>
          <!-- Logo Text -->
          <div class="flex flex-col justify-center mt-1">
            <span class="text-ivory font-display text-2xl font-bold leading-[0.85] tracking-tight uppercase transition-colors">SAGE</span>
            <span class="font-display text-copper text-[10px] tracking-widest font-semibold leading-[1] uppercase py-[3px]">Brain & Spine</span>
            <span class="text-ivory font-display text-2xl font-bold leading-[0.85] tracking-tight uppercase transition-colors">CLINIC</span>
          </div>
        </div>
        <p class="text-sm text-sage leading-relaxed mb-6">
          Neurosurgeon &middot; Educator &middot; Researcher &middot; Advocate
        </p>
        <!-- Social Icons -->
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/sylvia-shitsama" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.researchgate.net/profile/Sylvia-Shitsama" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="ResearchGate">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.586 0c-2.018 0-3.64 1.636-3.64 3.654 0 1.61 1.048 2.972 2.502 3.449v.005c-.075.278-.483 1.558-1.775 2.463-.793.556-1.724.842-2.765.842a4.83 4.83 0 01-.758-.06c-.828-.131-1.614-.524-2.156-1.1-.545-.578-.887-1.35-.946-2.145-.003-.05-.005-.113-.005-.18V3.654C10.043 1.636 8.421 0 6.403 0 4.385 0 2.763 1.636 2.763 3.654c0 1.768 1.252 3.239 2.914 3.587v6.412c0 3.547 2.414 6.542 5.69 7.384a7.558 7.558 0 002.236.337c1.372 0 2.666-.36 3.81-1.027 1.89-1.1 3.133-3.02 3.357-5.18.031-.303.047-.594.047-.873V7.241c1.664-.348 2.916-1.82 2.916-3.587C23.733 1.636 22.111 0 20.093 0h-.507zM6.403 5.308c-.907 0-1.654-.747-1.654-1.654 0-.907.747-1.654 1.654-1.654.907 0 1.654.747 1.654 1.654 0 .907-.747 1.654-1.654 1.654zm13.69 0c-.907 0-1.654-.747-1.654-1.654 0-.907.747-1.654 1.654-1.654.907 0 1.654.747 1.654 1.654 0 .907-.747 1.654-1.654 1.654z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="X (Twitter)">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-sage hover:text-copper transition-colors flex items-center gap-2">
                <svg class="w-3 h-3 text-copper/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Clinic Hours -->
      <div>
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Clinic Hours</h3>
        <div class="space-y-5">
          <div>
            <p class="font-mono-label text-copper text-[11px] mb-2">Nairobi — KNH Doctors Plaza, Suite 43, Hospital Road</p>
            <p class="text-sm text-sage">Monday – Friday</p>
            <p class="text-sm text-ivory font-medium">8:00 AM – 5:00 PM</p>
          </div>
        </div>
      </div>

      <!-- Column 4: Disclaimer -->
      <div>
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Credentials</h3>
        <div class="space-y-3 mb-6">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11px] text-gold px-2 py-1 bg-gold/10 rounded font-semibold">MBChB</span>
            <span class="font-mono text-[11px] text-gold px-2 py-1 bg-gold/10 rounded font-semibold">MMed</span>
            <span class="font-mono text-[11px] text-gold px-2 py-1 bg-gold/10 rounded font-semibold">FCS</span>
          </div>
        </div>
        <p class="text-xs text-text-muted leading-relaxed">
          This website is for informational purposes only and does not constitute medical advice. 
          Always consult a qualified healthcare professional for diagnosis and treatment. 
          In case of a medical emergency, please call your local emergency services.
        </p>
      </div>
    </div>
  </div>

  <!-- Copyright Bar -->
  <div class="border-t border-border-subtle">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="flex flex-col md:flex-row justify-between items-center gap-2">
        <p class="text-xs text-sage">
          &copy; {currentYear} Dr. Sylvia V. Shitsama &middot; drsylviashitsama.com
        </p>
        <p class="text-xs text-text-muted">
          Consultant Neurosurgeon &middot; KNH &middot; JKUAT &middot; Sage Brain & Spine
        </p>
      </div>
    </div>
  </div>
</footer>
