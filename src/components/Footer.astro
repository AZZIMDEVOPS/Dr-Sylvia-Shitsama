---
const currentYear = new Date().getFullYear();
const quickLinks = [
  { href: '/about', label: 'About' },
  { href: '/expertise', label: 'Expertise' },
  { href: '/research', label: 'Research' },
  { href: '/insights', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-midnight-light text-text-secondary border-t border-border-subtle transition-colors duration-300">
  <!-- Main Footer Content -->
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 md:gap-8 lg:gap-8 xl:gap-12">
      <!-- Column 1: Brand + Social -->
      <div class="md:col-span-1 lg:col-span-4 space-y-4">
        <a href="/" class="inline-block group" aria-label="Sage Brain & Spine Clinic - Home">
          <img
            src="/images/sage-clinic-official-logo.png"
            alt="Sage Brain & Spine Clinic"
            class="h-20 sm:h-24 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
            width="670"
            height="506"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-sage leading-relaxed font-light max-w-sm">
          Dr. Sylvia Shitsama &middot; Neurosurgeon
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a href="https://www.linkedin.com/in/sylvia-shitsama" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://scholar.google.com/citations?user=-4d8jNkAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="Google Scholar">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
          </a>
          <a href="https://www.researchgate.net/profile/Sylvia-Shitsama" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-surface border border-border-subtle flex items-center justify-center text-sage hover:text-copper hover:bg-copper/10 transition-colors" aria-label="ResearchGate">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.586 0c-2.018 0-3.64 1.636-3.64 3.654 0 1.61 1.048 2.972 2.502 3.449v.005c-.075.278-.483 1.558-1.775 2.463-.793.556-1.724.842-2.765.842a4.83 4.83 0 01-.758-.06c-.828-.131-1.614-.524-2.156-1.1-.545-.578-.887-1.35-.946-2.145-.003-.05-.005-.113-.005-.18V3.654C10.043 1.636 8.421 0 6.403 0 4.385 0 2.763 1.636 2.763 3.654c0 1.768 1.252 3.239 2.914 3.587v6.412c0 3.547 2.414 6.542 5.69 7.384a7.558 7.558 0 002.236.337c1.372 0 2.666-.36 3.81-1.027 1.89-1.1 3.133-3.02 3.357-5.18.031-.303.047-.594.047-.873V7.241c1.664-.348 2.916-1.82 2.916-3.587C23.733 1.636 22.111 0 20.093 0h-.507zM6.403 5.308c-.907 0-1.654-.747-1.654-1.654 0-.907.747-1.654 1.654-1.654.907 0 1.654.747 1.654 1.654 0 .907-.747 1.654-1.654 1.654zm13.69 0c-.907 0-1.654-.747-1.654-1.654 0-.907.747-1.654 1.654-1.654.907 0 1.654.747 1.654 1.654 0 .907-.747 1.654-1.654 1.654z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2 (Info 1): Quick Links -->
      <div class="md:col-span-1 lg:col-span-2 lg:pl-2">
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Navigation</h3>
        <ul class="space-y-3.5">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-sage hover:text-copper transition-colors inline-flex items-center gap-2 group">
                <svg class="w-3 h-3 text-copper/50 group-hover:text-copper transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3 (Info 2): Clinic Location -->
      <div class="md:col-span-1 lg:col-span-3 lg:pl-4">
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Clinic Location</h3>
        <div class="space-y-3 text-sm text-sage">
          <p class="font-medium text-ivory">Sage Brain &amp; Spine Clinic</p>
          <p class="font-light">KNH Doctors Plaza, Suite 43</p>
          <p class="font-light">Hospital Road, Nairobi, Kenya</p>
        </div>
      </div>

      <!-- Column 4 (Info 3): Hours & Contact -->
      <div class="md:col-span-1 lg:col-span-3 lg:pl-2">
        <h3 class="font-display text-ivory text-lg font-semibold mb-6">Hours &amp; Contact</h3>
        <div class="space-y-4 text-sm text-sage">
          <div>
            <p class="font-mono-label text-copper text-[11px] uppercase tracking-wider mb-1">Hours</p>
            <p class="text-ivory font-medium">Monday – Friday: 8:00 AM – 5:00 PM</p>
          </div>
          <div>
            <p class="font-mono-label text-copper text-[11px] uppercase tracking-wider mb-1">Direct Contact</p>
            <p><a href="tel:+254110090116" class="text-ivory font-mono text-sm hover:text-copper transition-colors inline-block">0110 090 116</a></p>
            <p class="text-xs font-light mt-1"><a href="https://wa.me/254110090116" target="_blank" rel="noopener noreferrer" class="text-sage hover:text-copper transition-colors inline-block">WhatsApp: +254 110 090 116</a></p>
            <p class="text-xs font-light mt-0.5"><a href="mailto:info@drsylviashitsama.com" class="text-sage hover:text-copper transition-colors inline-block">info@drsylviashitsama.com</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Bar -->
  <div class="border-t border-border-subtle">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="flex flex-col md:flex-row justify-between items-center gap-2">
        <p class="text-xs text-sage">
          &copy; {currentYear} Dr. Sylvia Shitsama &middot; Sage Brain &amp; Spine Clinic
        </p>
        <p class="text-xs text-text-muted">
          KNH Doctors Plaza, Suite 43 &middot; Nairobi, Kenya
        </p>
      </div>
    </div>
  </div>
</footer>
