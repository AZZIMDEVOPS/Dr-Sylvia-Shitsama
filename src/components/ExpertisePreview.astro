---
const specialties = [
  {
    id: 'brain-tumours',
    num: '01',
    title: 'Brain Tumours',
    description: 'Advanced surgical management of benign and malignant brain neoplasms with precision techniques.',
    image: '/images/specialties/brain_tumour.png',
    href: '/expertise#brain-tumours',
  },
  {
    id: 'hydrocephalus',
    num: '02',
    title: 'Hydrocephalus',
    description: 'Expert management including VP shunt placement and endoscopic third ventriculostomy, for paediatric and adult cases.',
    image: '/images/specialties/hydrocephalus.png',
    href: '/expertise#hydrocephalus',
  },
  {
    id: 'spinal-conditions',
    num: '03',
    title: 'Spinal Conditions',
    description: 'Degenerative disc disease, spinal stenosis, and complex spinal pathologies treated with modern approaches.',
    image: '/images/specialties/spinal_conditions.png',
    href: '/expertise#spinal-conditions',
  },
  {
    id: 'head-trauma',
    num: '04',
    title: 'Head Injury & Trauma',
    description: 'Emergency and elective neurosurgical intervention for traumatic brain injuries and road traffic accidents.',
    image: '/images/specialties/head_injury.png',
    href: '/expertise#head-trauma',
  },
  {
    id: 'spina-bifida',
    num: '05',
    title: 'Spina Bifida & Congenital',
    description: 'Paediatric neurosurgical care for neural tube defects and congenital neurological conditions.',
    image: '/images/specialties/spina_bifida.png',
    href: '/expertise#spina-bifida',
  },
  {
    id: 'oncology',
    num: '06',
    title: 'Neurological Oncology',
    description: 'Comprehensive neuro-oncology care from diagnosis through surgical treatment and post-operative management.',
    image: '/images/specialties/neuro_oncology.png',
    href: '/expertise#oncology',
  },
];
---

<section class="section-padding bg-midnight" id="expertise-preview">
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    
    <!-- Header -->
    <div class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div class="max-w-2xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-8 h-[1px] bg-copper"></div>
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase">Specialisations</span>
        </div>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold text-ivory leading-[1.1] mb-6">
          What I Treat
        </h2>
        <p class="text-lg text-sage max-w-xl leading-relaxed">
          Dr. Sylvia Shitsama provides expert, precise, and compassionate care across a comprehensive range of neurosurgical conditions.
        </p>
      </div>
      <div>
        <a href="/expertise" class="inline-flex items-center gap-2 text-ivory hover:text-copper transition-colors font-medium border-b border-copper/30 hover:border-copper pb-1">
          View all expertise
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Interactive Directory (Alpine.js) -->
    <div x-data="{ activeSpecialty: 'brain-tumours' }" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
      
      <!-- Left Column: Navigation Directory -->
      <div class="lg:col-span-5 flex flex-col">
        {specialties.map((specialty) => (
          <div class="border-t border-ivory/10 last:border-b">
            
            <!-- Desktop Layout (Hover triggers update, click navigates) -->
            <a 
              href={specialty.href}
              @mouseenter={`activeSpecialty = '${specialty.id}'`}
              @focus={`activeSpecialty = '${specialty.id}'`}
              class="hidden lg:flex items-center justify-between py-6 group relative overflow-hidden"
              :class={`activeSpecialty === '${specialty.id}' ? 'text-ivory' : 'text-sage'`}
            >
              <!-- Subtle background highlight on active -->
              <div 
                class="absolute inset-0 bg-gradient-to-r from-copper/5 to-transparent transition-opacity duration-400 ease-in-out"
                :class={`activeSpecialty === '${specialty.id}' ? 'opacity-100' : 'opacity-0'`}
              ></div>

              <div class="flex items-center gap-8 relative z-10">
                <span 
                  class="font-display text-xl transition-colors duration-300"
                  :class={`activeSpecialty === '${specialty.id}' ? 'text-copper' : 'text-sage'`}
                >{specialty.num}</span>
                <h3 class="text-2xl font-display font-medium tracking-wide">{specialty.title}</h3>
              </div>
              
              <div 
                class="relative z-10 transition-transform duration-400 ease-out"
                :class={`activeSpecialty === '${specialty.id}' ? 'translate-x-0 text-copper' : '-translate-x-4 opacity-0 text-sage'`}
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </a>

            <!-- Mobile Layout (Accordion) -->
            <div class="lg:hidden block">
              <button 
                @click={`activeSpecialty = activeSpecialty === '${specialty.id}' ? '' : '${specialty.id}'`}
                class="w-full flex items-center justify-between py-6 text-left"
                :class={`activeSpecialty === '${specialty.id}' ? 'text-ivory' : 'text-sage'`}
              >
                <div class="flex items-center gap-6">
                  <span 
                    class="font-display text-lg transition-colors duration-300"
                    :class={`activeSpecialty === '${specialty.id}' ? 'text-copper' : 'text-sage'`}
                  >{specialty.num}</span>
                  <h3 class="text-xl sm:text-2xl font-display font-medium">{specialty.title}</h3>
                </div>
                <div class="transition-transform duration-300" :class={`activeSpecialty === '${specialty.id}' ? 'rotate-180 text-copper' : 'text-sage/50'`}>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </button>

              <!-- Mobile Content Expansion -->
              <div 
                x-show={`activeSpecialty === '${specialty.id}'`}
                x-collapse
                class="pb-6"
                style="display: none;"
              >
                <div class="rounded-xl overflow-hidden aspect-[16/9] mb-5 relative">
                  <img src={specialty.image} alt={specialty.title} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-midnight/30 mix-blend-multiply"></div>
                </div>
                <p class="text-sage mb-4 text-base leading-relaxed">{specialty.description}</p>
                <a href={specialty.href} class="inline-flex items-center gap-2 text-copper text-sm font-medium hover:text-ivory transition-colors">
                  Explore condition
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Right Column: Dynamic Content & Visual (Desktop Only) -->
      <div class="hidden lg:block lg:col-span-7 relative min-h-[500px]">
        {specialties.map((specialty) => (
          <div 
            x-show={`activeSpecialty === '${specialty.id}'`}
            x-transition:enter="transition ease-out duration-500"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-300 absolute inset-0"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="h-full flex flex-col"
            style="display: none;"
          >
            <div class="relative w-full h-[400px] xl:h-[450px] rounded-2xl overflow-hidden shadow-2xl mb-8 group">
              <!-- Image with subtle scale on hover for premium feel -->
              <img 
                src={specialty.image} 
                alt={specialty.title} 
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" 
                loading="eager" 
              />
              <!-- Subtle dark overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-midnight/80 via-midnight/20 to-transparent mix-blend-multiply"></div>
              
              <!-- Content overlaid at bottom -->
              <div class="absolute bottom-0 left-0 w-full p-8 xl:p-10 z-10">
                <span class="font-mono-label text-copper tracking-[0.1em] block mb-3">{specialty.num} / {specialty.title.toUpperCase()}</span>
                <p class="text-xl text-ivory max-w-lg leading-relaxed mb-6">
                  {specialty.description}
                </p>
                <a 
                  href={specialty.href} 
                  class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white backdrop-blur-sm px-6 py-3 rounded-full text-sm font-medium transition-all"
                >
                  Explore condition
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
