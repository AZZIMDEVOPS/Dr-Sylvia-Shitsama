---
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/expertise', label: 'Expertise' },
  { href: '/research', label: 'Research' },
  { href: '/insights', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  x-data="{ scrolled: false, mobileOpen: false }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 })"
  :class="scrolled ? 'bg-white/95 backdrop-blur-xl shadow-xs border-b border-border-subtle' : 'bg-transparent'"
>
  <nav class="container-custom mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Name -->
      <a href="/" class="flex items-center group py-1" aria-label="Sage Brain & Spine Clinic - Home">
        <img
          src="/images/sage-clinic-original-logo.png"
          alt="Sage Brain & Spine Clinic"
          class="h-14 sm:h-16 md:h-17 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
          width="764"
          height="1013"
          loading="eager"
        />
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden lg:flex items-center gap-7">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || 
            (link.href !== '/' && currentPath.startsWith(link.href)) ||
            (link.href === '/insights' && currentPath.startsWith('/blog'));
          return (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors duration-200 relative whitespace-nowrap',
                isActive
                  ? 'text-copper font-semibold'
                  : 'text-primary-navy hover:text-copper',
              ]}
            >
              {link.label}
              {isActive && (
                <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-copper rounded-full" />
              )}
            </a>
          );
        })}
      </div>

      <!-- Right: Consultation CTA + Mobile Menu -->
      <div class="flex items-center gap-3">
        <!-- CTA Button (Desktop) -->
        <a href="/contact" class="!hidden lg:!inline-flex btn-primary text-sm !py-2.5 !px-5 whitespace-nowrap">
          Book a Consultation
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          @click="mobileOpen = !mobileOpen"
          class="lg:hidden p-2 text-primary-navy hover:text-copper transition-colors focus:outline-none"
          :aria-expanded="mobileOpen"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" x-show="!mobileOpen" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" x-show="mobileOpen" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display: none;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-4"
      class="lg:hidden hidden pb-6 border border-slate-200/80 mt-2 bg-white/98 backdrop-blur-xl px-4 rounded-2xl shadow-xl"
      @click.outside="mobileOpen = false"
    >
      <div class="flex flex-col gap-1 pt-4">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || 
            (link.href !== '/' && currentPath.startsWith(link.href)) ||
            (link.href === '/insights' && currentPath.startsWith('/blog'));
          return (
            <a
              href={link.href}
              class:list={[
                'px-4 py-3 rounded-lg text-sm font-medium transition-colors',
                isActive
                  ? 'text-copper bg-copper/10 font-semibold'
                  : 'text-primary-navy hover:text-copper hover:bg-slate-50',
              ]}
            >
              {link.label}
            </a>
          );
        })}
        <div class="px-4 pt-3">
          <a href="/contact" class="btn-primary w-full text-center text-sm">
            Book a Consultation
          </a>
        </div>
      </div>
    </div>
  </nav>

  <script is:inline>
    (function() {
      function setupMenu() {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        var hamburger = document.getElementById('hamburger-icon');
        var closeIcon = document.getElementById('close-icon');

        if (!btn || !menu) return;

        btn.addEventListener('click', function(e) {
          // If Alpine is active, it handles x-show reactively.
          // Native fallback in case Alpine hasn't attached:
          if (typeof window.Alpine === 'undefined') {
            e.stopPropagation();
            var isHidden = menu.classList.contains('hidden');
            if (isHidden) {
              menu.classList.remove('hidden');
              if (hamburger) hamburger.classList.add('hidden');
              if (closeIcon) {
                closeIcon.classList.remove('hidden');
                closeIcon.style.display = 'block';
              }
              btn.setAttribute('aria-expanded', 'true');
            } else {
              menu.classList.add('hidden');
              if (hamburger) hamburger.classList.remove('hidden');
              if (closeIcon) {
                closeIcon.classList.add('hidden');
                closeIcon.style.display = 'none';
              }
              btn.setAttribute('aria-expanded', 'false');
            }
          }
        });

        // Close on navigation click inside menu
        menu.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', function() {
            if (window.Alpine) {
              var el = btn.closest('[x-data]');
              if (el && el._x_dataStack && el._x_dataStack[0]) {
                el._x_dataStack[0].mobileOpen = false;
              }
            }
            menu.classList.add('hidden');
            if (hamburger) hamburger.classList.remove('hidden');
            if (closeIcon) {
              closeIcon.classList.add('hidden');
              closeIcon.style.display = 'none';
            }
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMenu);
      } else {
        setupMenu();
      }
    })();
  </script>
</header>
