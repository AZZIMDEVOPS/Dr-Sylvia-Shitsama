---

<section class="py-16 sm:py-24 bg-white transition-colors duration-300" id="specialities">
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-[2px] bg-copper"></span>
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Clinical Services</span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 leading-[1.1] tracking-tight">
          Specialities
        </h2>
        <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed font-normal">
          Specialist care for conditions of the brain, spine, and nervous system — delivered with clinical precision, authentic patient empathy, and modern surgical techniques.
        </p>
      </div>

      <div class="shrink-0 flex items-center gap-4">
        <a 
          href="#clinical-photo-gallery"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-copper/10 hover:bg-copper/20 text-copper font-medium text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          View Clinical Showcase ({allUploadedPhotos.length})
        </a>
        <a 
          href="/expertise" 
          class="inline-flex items-center gap-2 text-slate-800 hover:text-copper transition-colors font-medium border-b border-copper/40 hover:border-copper pb-1 text-sm sm:text-base group"
        >
          All conditions & expertise
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 3-Column Specialities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {specialities.map((item, index) => (
        <div 
          class="speciality-card group flex flex-col bg-white rounded-2xl border border-slate-200/90 hover:border-copper/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
          data-card-id={item.id}
        >
          <!-- Main Image Container with Lightbox Trigger -->
          <div class="relative w-full aspect-[4/3] rounded-t-xl sm:rounded-xl overflow-hidden bg-slate-100 mb-4">
            <img
              id={`card-img-${item.id}`}
              src={item.primaryImage}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out cursor-pointer"
              loading="lazy"
              width="600"
              height="450"
              onclick={`openPhotoLightbox('${item.primaryImage}', '${item.title.replace(/'/g, "\\'")}')`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity pointer-events-none"></div>
            
            <!-- Category Tag -->
            <div class="absolute top-3 left-3 pointer-events-none">
              <span class="inline-block px-3 py-1 rounded-full bg-white/95 backdrop-blur-md text-[11px] font-mono font-medium text-slate-900 border border-slate-200/80 shadow-sm">
                {item.category}
              </span>
            </div>

            <!-- Photo Count Badge if multiple -->
            {item.gallery.length > 1 && (
              <div class="absolute top-3 right-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur-md text-[11px] font-medium text-white shadow-sm">
                  <svg class="w-3.5 h-3.5 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {item.gallery.length} Photos
                </span>
              </div>
            )}
          </div>

          <!-- Interactive Mini-Thumbnail Switcher if multiple photos -->
          {item.gallery.length > 1 && (
            <div class="px-4 mb-3 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
              <span class="text-[11px] font-mono text-slate-400 shrink-0 uppercase tracking-wider">Preview:</span>
              <div class="flex items-center gap-1.5">
                {item.gallery.map((photo, pIdx) => (
                  <button
                    type="button"
                    class={`thumb-btn text-xs px-2.5 py-1 rounded-md border text-slate-700 hover:border-copper hover:text-copper transition-all duration-150 flex items-center gap-1.5 ${pIdx === 0 ? 'border-copper bg-copper/10 font-semibold text-copper' : 'border-slate-200 bg-slate-50'}`}
                    onclick={`switchCardPhoto('${item.id}', '${photo.src}', this)`}
                    title={photo.label}
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    <span>{photo.label}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Content Below Image -->
          <div class="flex flex-col flex-grow px-4 pb-4">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-copper transition-colors duration-200 mb-2 leading-snug">
              {item.title}
            </h3>
            
            <p class="text-slate-600 text-sm leading-relaxed mb-5 flex-grow font-normal">
              {item.description}
            </p>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-sm font-semibold text-copper">
              <a href={item.href} class="hover:underline flex items-center gap-1">
                <span>Explore condition</span>
                <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              <button 
                type="button"
                onclick={`openPhotoLightbox(document.getElementById('card-img-${item.id}').src, '${item.title.replace(/'/g, "\\'")}')`}
                class="text-xs text-slate-400 hover:text-slate-800 flex items-center gap-1 transition-colors"
                title="Enlarge photo"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
                Zoom
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ========================================================================= -->
    <!-- DEDICATED VISUAL GALLERY: ALL 13 UPLOADED CLINICAL & THEATRE PHOTOS       -->
    <!-- ========================================================================= -->
    <div class="mt-20 sm:mt-28 pt-16 border-t border-slate-200" id="clinical-photo-gallery">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-[2px] bg-copper"></span>
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Authentic Clinical Showcase</span>
          </div>
          <h3 class="font-display text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
            Clinical Care in Action
          </h3>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl font-normal">
            Authentic clinical care encompassing real neurosurgical operating theatres, emergency trauma triage, hydrocephalus management, and paediatric patient support (with patient faces softly blurred for privacy).
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2" id="gallery-filter-tabs">
          <button 
            type="button" 
            class="filter-tab active px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-900 text-white shadow-sm transition-all"
            data-filter="all"
          >
            All Photos ({allUploadedPhotos.length})
          </button>
          <button 
            type="button" 
            class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
            data-filter="trauma"
          >
            Head Trauma (4)
          </button>
          <button 
            type="button" 
            class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
            data-filter="paediatric"
          >
            Paediatric (5)
          </button>
          <button 
            type="button" 
            class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
            data-filter="surgery"
          >
            Theatre & Spine (4)
          </button>
          <button 
            type="button" 
            class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 transition-all"
            data-filter="hydrocephalus"
          >
            Hydrocephalus (1)
          </button>
        </div>
      </div>

      <!-- Photo Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="photo-grid-container">
        {allUploadedPhotos.map((photo) => (
          <div 
            class="photo-card group bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:border-copper/50 transition-all duration-300 flex flex-col"
            data-category={photo.category}
          >
            <div 
              class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100 cursor-pointer"
              onclick={`openPhotoLightbox('${photo.src}', '${photo.title.replace(/'/g, "\\'")}', '${photo.description.replace(/'/g, "\\'")}')`}
            >
              <img 
                src={photo.src} 
                alt={photo.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                width="400"
                height="300"
              />
              <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-3 py-1.5 rounded-full bg-white/95 text-slate-900 text-xs font-semibold shadow-md flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                  Click to Expand
                </span>
              </div>
              <div class="absolute top-2.5 left-2.5">
                <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-mono font-medium text-slate-900 border border-slate-200/80 shadow-sm">
                  {photo.badge}
                </span>
              </div>
            </div>

            <div class="p-3.5 flex flex-col flex-grow">
              <h4 class="font-display text-sm font-bold text-slate-900 leading-snug group-hover:text-copper transition-colors mb-1.5">
                {photo.title}
              </h4>
              <p class="text-slate-500 text-xs leading-relaxed flex-grow">
                {photo.description}
              </p>
              <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>{photo.categoryLabel}</span>
                <span class="text-copper group-hover:underline">View photo →</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Quick Action Strip -->
    <div class="mt-14 sm:mt-18 pt-10 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6">
      <p class="text-slate-600 text-sm sm:text-base text-center sm:text-left">
        Have questions regarding a diagnosis, scan review, or specialist consultation?
      </p>
      <div class="flex items-center gap-4 shrink-0">
        <a href="/contact" class="btn-primary text-sm !py-2.5 !px-5">
          Book Consultation
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Lightbox Modal for Enlarge View -->
<div 
  id="photo-lightbox-modal" 
  class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4 sm:p-6"
  onclick="closePhotoLightbox(event)"
>
  <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center" onclick="event.stopPropagation()">
    <!-- Close Button -->
    <button 
      type="button" 
      onclick="closePhotoLightbox(null)"
      class="absolute -top-10 right-0 sm:top-2 sm:right-2 z-10 w-9 h-9 rounded-full bg-white/20 hover:bg-white/40 text-white flex items-center justify-center transition-colors"
      aria-label="Close lightbox"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Main Lightbox Image -->
    <img 
      id="lightbox-img" 
      src="" 
      alt="" 
      class="max-h-[75vh] w-auto max-w-full rounded-lg shadow-2xl object-contain"
    />

    <!-- Caption -->
    <div class="mt-4 text-center max-w-2xl px-4">
      <h4 id="lightbox-title" class="!text-white font-display text-lg sm:text-xl font-bold"></h4>
      <p id="lightbox-desc" class="!text-slate-200 text-sm mt-1"></p>
    </div>
  </div>
</div>

<script is:inline>
  // Interactive thumbnail switcher on speciality cards
  function switchCardPhoto(cardId, newSrc, btnEl) {
    const cardImg = document.getElementById(`card-img-${cardId}`);
    if (!cardImg) return;
    
    // Smooth fade effect
    cardImg.style.opacity = '0.5';
    setTimeout(() => {
      cardImg.src = newSrc;
      cardImg.style.opacity = '1';
    }, 150);

    // Update active button state
    const card = document.querySelector(`[data-card-id="${cardId}"]`);
    if (card) {
      const buttons = card.querySelectorAll('.thumb-btn');
      buttons.forEach(b => {
        b.classList.remove('border-copper', 'bg-copper/10', 'font-semibold', 'text-copper');
        b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700');
      });
      if (btnEl) {
        btnEl.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-700');
        btnEl.classList.add('border-copper', 'bg-copper/10', 'font-semibold', 'text-copper');
      }
    }
  }

  // Lightbox functions
  function openPhotoLightbox(src, title, desc) {
    const modal = document.getElementById('photo-lightbox-modal');
    const img = document.getElementById('lightbox-img');
    const titleEl = document.getElementById('lightbox-title');
    const descEl = document.getElementById('lightbox-desc');
    
    if (!modal || !img) return;

    img.src = src;
    img.alt = title || '';
    if (titleEl) titleEl.textContent = title || '';
    if (descEl) descEl.textContent = desc || '';

    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closePhotoLightbox(e) {
    if (e && e.target.id !== 'photo-lightbox-modal' && !e.target.closest('button')) return;
    const modal = document.getElementById('photo-lightbox-modal');
    if (!modal) return;

    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 250);
  }

  // Filter tabs logic
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#gallery-filter-tabs .filter-tab');
    const photoCards = document.querySelectorAll('#photo-grid-container .photo-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab styles
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        // Filter cards
        photoCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePhotoLightbox(null);
    });
  });
</script>
