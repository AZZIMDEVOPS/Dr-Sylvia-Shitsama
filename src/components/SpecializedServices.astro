---
// SpecializedServices.astro
// Core Clinical Practice Areas for Dr. Sylvia Shitsama
// Structured for seamless future insertion of doctor-provided clinical copy and neuroimaging scans.

interface ClinicalSpecialty {
  id: string;
  slug: string;
  title: string;
  category: string;
  summary: string;
  clinicalScope: string[];
  image: string;
  imageAlt: string;
  href: string;
}

const specialties: ClinicalSpecialty[] = [
  {
    id: 'brain-trauma',
    slug: 'brain-trauma',
    title: 'Brain Trauma',
    category: 'Neurotrauma & Emergency Care',
    summary: 'Clinical assessment, surgical intervention, and post-traumatic management for traumatic brain injuries, skull fractures, and intracranial hematomas.',
    clinicalScope: [
      'Traumatic Brain Injury (TBI)',
      'Subdural & Epidural Hematomas',
      'Depressed Skull Fractures',
      'Cranial Reconstruction & Cranioplasty',
    ],
    image: '/images/services/head_injury_trauma_1.jpg',
    imageAlt: 'Clinical management of acute head injury and cranial trauma',
    href: '/expertise#brain-trauma',
  },
  {
    id: 'brain-tumors',
    slug: 'brain-tumors',
    title: 'Brain Tumors',
    category: 'Cranial Surgery & Neuro-Oncology',
    summary: 'Microsurgical resection and multidisciplinary management of benign and malignant brain tumours, meningiomas, and skull base lesions.',
    clinicalScope: [
      'Gliomas & Glioblastomas',
      'Meningiomas & Skull Base Tumours',
      'Metastatic Brain Lesions',
      'Pituitary & Intraventricular Lesions',
    ],
    image: '/images/dr-sylvia-neurosurgery-theatre.jpg',
    imageAlt: 'Dr. Sylvia Shitsama performing microsurgical cranial surgery in theatre',
    href: '/expertise#brain-tumors',
  },
  {
    id: 'spine',
    slug: 'spine',
    title: 'Spine',
    category: 'Spinal Surgery & Reconstruction',
    summary: 'Comprehensive evaluation, conservative therapy coordination, and specialist surgical decompression and stabilization for spinal conditions.',
    clinicalScope: [
      'Cervical & Lumbar Disc Herniation',
      'Spinal Stenosis & Neural Compression',
      'Degenerative Disc Disease & Spondylolisthesis',
      'Spinal Trauma & Vertebral Stabilization',
    ],
    image: '/images/services/spine_surgery.jpg',
    imageAlt: 'Specialist spinal decompression and surgical stabilisation',
    href: '/expertise#spine',
  },
  {
    id: 'hydrocephalus',
    slug: 'hydrocephalus',
    title: 'Hydrocephalus',
    category: 'CSF Circulation Disorders',
    summary: 'Evaluation and surgical diversion of cerebrospinal fluid (CSF) in pediatric and adult patients, emphasizing evidence-based, long-term management.',
    clinicalScope: [
      'Ventriculoperitoneal (VP) Shunt Placement',
      'Endoscopic Third Ventriculostomy (ETV)',
      'Normal Pressure Hydrocephalus (NPH)',
      'Congenital & Acquired CSF Blockages',
    ],
    image: '/images/services/hydrocephalus_patient.jpg',
    imageAlt: 'Clinical examination and care for hydrocephalus',
    href: '/expertise#hydrocephalus',
  },
  {
    id: 'congenital-conditions',
    slug: 'congenital-conditions',
    title: 'Congenital Conditions',
    category: 'Developmental Anomalies',
    summary: 'Diagnosis and delicate surgical repair of congenital neural tube and cranio-vertebral junction anomalies across infancy through adulthood.',
    clinicalScope: [
      'Spina Bifida & Myelomeningocele',
      'Encephaloceles & Cranial Defects',
      'Tethered Cord Syndrome',
      'Chiari Malformations',
    ],
    image: '/images/services/delicate_surgery.jpg',
    imageAlt: 'Precision microsurgery for congenital neurological malformations',
    href: '/expertise#congenital-conditions',
  },
  {
    id: 'pediatric-neurosurgery',
    slug: 'pediatric-neurosurgery',
    title: 'Pediatric Neurosurgery',
    category: 'Paediatric Specialist Care',
    summary: 'Dedicated neurosurgical care tailored specifically to infants, children, and adolescents with compassionate patient-and-family communication.',
    clinicalScope: [
      'Infant Head Shape & Craniosynostosis',
      'Pediatric Hydrocephalus Management',
      'Neonatal Neural Tube Defect Repair',
      'Pediatric Cranial & Spinal Trauma',
    ],
    image: '/images/services/paediatric_neurosurgery_1.jpg',
    imageAlt: 'Paediatric neurosurgical consultation and clinical assessment',
    href: '/expertise#pediatric-neurosurgery',
  },
];
---

<section class="py-16 lg:py-20 bg-slate-50 dark:bg-midnight-light border-y border-slate-200 dark:border-ivory/5 transition-colors duration-300" id="clinical-expertise">
  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 fade-up">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-[2px] bg-copper"></span>
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Areas of Practice</span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-slate-900 dark:text-ivory tracking-tight">
          Clinical Expertise
        </h2>
        <p class="text-slate-600 dark:text-sage text-base sm:text-lg mt-3 font-light leading-relaxed">
          Specialist neurosurgical care delivered with surgical precision, deep clinical judgment, and dedicated patient support across Nairobi and East Africa.
        </p>
      </div>
      <div>
        <a 
          href="/expertise" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-copper hover:text-copper-dark dark:hover:text-ivory transition-colors group font-mono uppercase tracking-wider"
        >
          View Full Clinical Scope
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 6 Clinical Expertise Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {specialties.map((item) => (
        <article class="bg-white dark:bg-midnight rounded-2xl overflow-hidden border border-slate-200 dark:border-ivory/10 shadow-sm hover:shadow-xl dark:hover:border-copper/40 transition-all duration-300 flex flex-col group hover:-translate-y-1">
          
          <!-- Image Container -->
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <img 
              src={item.image} 
              alt={item.imageAlt} 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent pointer-events-none"></div>
            
            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
              <span class="text-[10px] font-mono uppercase tracking-widest text-white/90 bg-slate-900/70 backdrop-blur-sm px-2.5 py-1 rounded-md border border-white/10">
                {item.category}
              </span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-display text-2xl font-bold text-slate-900 dark:text-ivory mb-3 group-hover:text-copper transition-colors">
                {item.title}
              </h3>
              
              <p class="text-slate-600 dark:text-sage text-sm font-light leading-relaxed mb-6">
                {item.summary}
              </p>

              <!-- Clinical Scope Bullet Points -->
              <div class="border-t border-slate-100 dark:border-ivory/5 pt-4 mb-6">
                <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-sage/60 block mb-2">Scope of Care</span>
                <ul class="space-y-1.5">
                  {item.clinicalScope.map((scope) => (
                    <li class="text-xs text-slate-700 dark:text-ivory/90 flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-copper shrink-0"></span>
                      <span>{scope}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <div class="pt-4 border-t border-slate-100 dark:border-ivory/5 flex items-center justify-between mt-auto">
              <a 
                href={item.href} 
                class="text-xs font-semibold text-copper hover:text-copper-dark dark:hover:text-ivory transition-colors uppercase tracking-wider font-mono inline-flex items-center gap-1.5"
              >
                Learn More
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>

              <a 
                href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20enquire%20about%20a%20consultation%20regarding%20" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs text-slate-500 hover:text-copper dark:text-sage/80 dark:hover:text-white transition-colors"
                title="Book consultation for this area"
              >
                Book Consultation &rarr;
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Clear Section Guidance Note -->
    <div class="mt-16 p-6 rounded-2xl bg-white dark:bg-midnight border border-slate-200 dark:border-ivory/10 max-w-4xl mx-auto text-center shadow-sm">
      <p class="text-sm text-slate-600 dark:text-sage font-light leading-relaxed">
        Consultations are held at Sage Brain &amp; Spine Clinic at <strong>KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi</strong>. Both self-referrals and physician referrals are welcome.
      </p>
    </div>

  </div>
</section>
