---
import NeuralNetwork from './NeuralNetwork.astro';
---

<section class="relative min-h-screen flex flex-col justify-center bg-midnight overflow-hidden pt-24 pb-12" id="hero">
  <!-- Neural Network Background -->
  <NeuralNetwork />

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

      <!-- Left Column (55%) -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Eyebrow Label -->
        <div class="font-mono-label text-copper mb-6 tracking-[0.2em]">
          Neurosurgeon · Kenya · East Africa
        </div>

        <!-- Main Headline -->
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-ivory leading-[1.1] mb-6">
          Precision Care.<br />
          <span class="text-copper">Compassionate</span> Healing.<br />
          Pioneering Surgery.
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-sage max-w-xl mb-10 leading-relaxed">
          Dr. Sylvia Shitsama — Kenya's first female neurosurgeon, transforming brain and spine care across East Africa.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn-primary text-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Book a Consultation
          </a>
          <a href="/about" class="btn-ghost text-center">
            Meet Dr. Shitsama
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column (45%) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
        <!-- Portrait Image -->
        <div class="relative w-full max-w-md lg:max-w-lg">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-midnight/50">
            <img
              src="/images/dr-shitsama-headshot.jpg"
              alt="Dr. Sylvia Shitsama Nyamweya, Kenya's first qualified female neurosurgeon"
              class="w-full h-auto block"
              width="800"
              height="909"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-indicator hidden lg:block">
      <svg class="w-6 h-6 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>
</section>
