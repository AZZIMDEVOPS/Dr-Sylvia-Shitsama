---
---

<section class="relative min-h-[92vh] lg:min-h-screen flex flex-col justify-center bg-white overflow-hidden pt-28 pb-16 lg:py-24" id="hero">
  <!-- Subtle Static Ambient Glow (Non-animated, Warm Gold/Amber tint on pure white) -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(252,174,24,0.10),rgba(255,255,255,0))] pointer-events-none"></div>

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 my-auto">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">

      <!-- Eyebrow Badge & Clinic Identity -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-copper/15 border border-copper/30 text-copper text-xs font-mono uppercase tracking-widest font-medium">
          <span class="w-2 h-2 rounded-full bg-copper animate-pulse"></span>
          Sage Brain &amp; Spine Clinic
        </span>
        <span class="font-mono text-text-secondary text-xs tracking-wider uppercase font-medium">
          Dr. Sylvia Shitsama &middot; Neurosurgeon
        </span>
      </div>

      <!-- Primary Tagline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-text-primary leading-[1.08] mb-6 tracking-tight max-w-3xl">
        Excellence Every Patient <span class="text-copper block sm:inline">Every Time</span>
      </h1>

      <!-- Supporting Copy -->
      <p class="text-lg sm:text-xl text-text-secondary max-w-2xl mb-8 leading-relaxed font-light">
        Delivering the highest quality neurosurgical care with unmatched compassion and outstanding clinical service.
      </p>

      <!-- Physical Clinic Location Prominence -->
      <div class="inline-flex items-center gap-3.5 mb-10 p-3 sm:p-3.5 px-4 sm:px-6 rounded-2xl bg-white border border-slate-200/90 shadow-md max-w-xl text-left">
        <div class="w-10 h-10 rounded-xl bg-copper/15 border border-copper/30 flex items-center justify-center shrink-0 text-copper">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <div class="text-[11px] font-mono uppercase tracking-wider text-copper font-medium">Consultation Clinic &middot; Nairobi</div>
          <div class="text-sm font-medium text-text-primary">KNH Doctors Plaza, 4th Floor Suite 43, Hospital Road</div>
          <div class="text-xs text-text-secondary mt-0.5 font-light">Adjacent to National Bank</div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center mb-12 w-full sm:w-auto">
        <a 
          href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-primary text-center flex items-center justify-center gap-2.5 shadow-lg shadow-copper/25 w-full sm:w-auto px-7 py-3.5"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Book a Consultation
        </a>
        <a href="/expertise" class="btn-ghost text-center inline-flex items-center justify-center gap-2 w-full sm:w-auto px-7 py-3.5">
          Clinical Expertise
          <svg class="w-4 h-4 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Key Clinical Trust Highlights -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 max-w-3xl w-full pt-6 border-t border-slate-200">
        <div class="flex items-center justify-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-text-secondary">
          <span class="w-1.5 h-1.5 rounded-full bg-copper shrink-0"></span>
          <span>General Neurosurgery Fellowship &middot; Toronto</span>
        </div>
        <div class="flex items-center justify-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-text-secondary">
          <span class="w-1.5 h-1.5 rounded-full bg-copper shrink-0"></span>
          <span>Senior Lecturer &middot; JKUAT Medical School</span>
        </div>
        <div class="flex items-center justify-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-text-secondary">
          <span class="w-1.5 h-1.5 rounded-full bg-copper shrink-0"></span>
          <span>Lead Neurosurgeon &middot; Sage Brain &amp; Spine</span>
        </div>
      </div>

    </div>

    <!-- Clean Downward Scroll Cue -->
    <div class="text-center mt-12 lg:mt-14 hidden sm:block">
      <a href="#clinical-expertise" class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-text-muted hover:text-copper transition-colors">
        <span>Explore Clinical Practice</span>
        <svg class="w-4 h-4 text-copper animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
