---
// Pull Quote Section
---

<section class="section-padding bg-ivory dark:bg-midnight-light relative overflow-hidden" id="pull-quote">
  <!-- Subtle Neural Network Background -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 800 400" fill="none" style="opacity: 0.04;" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <path d="M100,200 C200,50 400,350 500,200" stroke="#D4A853" stroke-width="1" fill="none"/>
    <path d="M500,200 C600,50 700,300 750,200" stroke="#C17A3E" stroke-width="1" fill="none"/>
    <circle cx="100" cy="200" r="3" fill="#D4A853"/>
    <circle cx="500" cy="200" r="4" fill="#C17A3E"/>
    <circle cx="750" cy="200" r="3" fill="#D4A853"/>
    <path d="M200,100 C300,80 400,120 500,200" stroke="#D4A853" stroke-width="0.5" fill="none"/>
  </svg>

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Decorative Quote Mark -->
    <div class="text-copper/20 text-8xl font-display leading-none mb-4" aria-hidden="true">"</div>

    <!-- Quote -->
    <blockquote class="max-w-3xl mx-auto">
      <p class="font-display text-2xl sm:text-3xl lg:text-4xl font-medium italic text-midnight dark:text-ivory leading-snug">
        Surgery is the most visible form of care.
        <span class="text-copper">But the invisible work</span> — the research, the teaching, the advocacy — is what changes a system.
      </p>
    </blockquote>

    <!-- Attribution -->
    <div class="mt-8 flex items-center justify-center gap-3">
      <div class="w-12 h-px bg-copper/40"></div>
      <cite class="text-sage not-italic text-sm">
        Dr. Sylvia Shitsama, <span class="text-copper">JKUAT School of Medicine</span>
      </cite>
      <div class="w-12 h-px bg-copper/40"></div>
    </div>
  </div>
</section>
