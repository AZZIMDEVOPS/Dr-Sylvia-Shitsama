---
// Consultation CTA - Final conversion section
---

<section class="py-24 sm:py-32 bg-midnight relative overflow-hidden" id="consultation-cta">
  
  <!-- Subtle Radial Glow & Background Word -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-copper/5 rounded-full blur-[120px] mix-blend-screen"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[15rem] sm:text-[25rem] font-display font-bold text-ivory/[0.015] select-none whitespace-nowrap">
      CARE
    </div>
  </div>

  <!-- Anatomical/Neurological Line Illustration (Subtle SVG Pattern) -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-neurological-pattern animate-drift"></div>

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-16 fade-up">
      <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-4 block">Get In Touch</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory mb-6">
        Book a Consultation
      </h2>
      <p class="text-sage text-lg sm:text-xl max-w-2xl mx-auto mb-2 leading-relaxed">
        Consultations available in Nairobi. Self-referrals and physician referrals are welcome.
      </p>
      <p class="text-ivory/70 text-sm sm:text-base font-light max-w-xl mx-auto">
        Take the next step towards expert neurological and neurosurgical care.
      </p>
    </div>

    <!-- Split-Layout CTA -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center max-w-6xl mx-auto">
      
      <!-- Left: Consultation Message -->
      <div class="fade-up order-2 lg:order-1 text-center lg:text-left">
        <h3 class="font-display text-3xl sm:text-4xl font-medium text-ivory mb-6 leading-tight">
          Expert care starts <br class="hidden lg:block"/>with a conversation.
        </h3>
        <p class="text-sage text-lg leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0 font-light">
          Reach out to enquire about consultation availability, referrals, and appointments. Our team is here to guide you through the process.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 sm:gap-6">
          <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-lg font-medium transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-copper/20 group">
            Book a Consultation
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 border border-ivory/20 hover:border-ivory/50 text-ivory px-8 py-4 rounded-lg font-medium transition-all hover:bg-ivory/5">
            Contact the Practice
          </a>
        </div>
      </div>

      <!-- Right: Consultation Card -->
      <div class="fade-up order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md group">
          <!-- Fine decorative lines around card -->
          <div class="absolute -inset-4 border border-ivory/5 rounded-3xl -z-10 group-hover:border-ivory/10 transition-colors duration-500 hidden sm:block"></div>
          
          <div class="bg-midnight-light border border-ivory/10 p-8 sm:p-10 rounded-2xl shadow-2xl transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-copper/5 group-hover:border-copper/20">
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-8 block text-sm">Consultations</span>
            
            <div class="space-y-6 mb-10">
              <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-sage shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <div>
                  <p class="text-ivory font-medium text-lg">Nairobi, Kenya</p>
                  <p class="text-sage text-sm font-light">KNH Doctors' Plaza, Suite 43</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-sage shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
                <p class="text-ivory font-medium pt-1">Self-referrals welcome</p>
              </div>

              <div class="flex items-start gap-4">
                <svg class="w-6 h-6 text-sage shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <p class="text-ivory font-medium pt-1">Physician referrals welcome</p>
              </div>
            </div>

            <a href="/contact" class="flex items-center justify-between w-full border-t border-ivory/10 pt-6 text-copper font-medium group/link">
              Request an Appointment
              <svg class="w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Trust Element -->
    <div class="mt-16 text-center fade-up">
      <div class="inline-flex items-center gap-3 text-sage/70">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
        </svg>
        <span class="text-sm font-light tracking-wide">Your enquiry is handled with professionalism and discretion.</span>
      </div>
    </div>
    
  </div>
</section>

<style>
  .bg-neurological-pattern {
    background-image: 
      radial-gradient(circle at 50% 50%, rgba(243, 239, 230, 0.1) 1px, transparent 1px),
      radial-gradient(circle at 25% 75%, rgba(193, 122, 62, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: 0 0, 20px 20px;
  }
  
  @keyframes drift {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-10px) scale(1.02); }
    100% { transform: translateY(0) scale(1); }
  }
  
  .animate-drift {
    animation: drift 20s ease-in-out infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      document.querySelectorAll('.fade-up').forEach(el => {
        if (el instanceof HTMLElement) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      });
      return;
    }

    gsap.utils.toArray<HTMLElement>('#consultation-cta .fade-up').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0,
          duration: 0.8,
          delay: i * 0.1, // Stagger effect
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            once: true,
          },
        }
      );
    });
  });
</script>
