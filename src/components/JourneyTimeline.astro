---
// JourneyTimeline.astro
// Interactive, scroll-animated career milestones timeline for Dr. Sylvia Shitsama
// Features scroll-powered dynamic beam progression, luminous active nodes, and alternating entrance animations

const milestones = [
  {
    id: '01',
    title: 'Bachelor of Medicine & Surgery (MBChB)',
    institution: 'University of Nairobi',
    description: 'Undergraduate medical training graduating with MBChB, establishing a rigorous clinical foundation in anatomy, diagnostic medicine, surgical principles, and dedicated patient care.',
    year: 'Medical School',
    badge: 'Undergraduate Medical Foundation',
    icon: 'academic'
  },
  {
    id: '02',
    title: 'Master of Medicine in Neurosurgery (MMed)',
    institution: 'University of Nairobi',
    description: 'Completed comprehensive postgraduate residency and specialist surgical training in neurosurgery, earning the Master of Medicine in Neurosurgery (MMed) in 2015.',
    year: 'Completed in 2015',
    badge: 'Specialist Surgical Degree',
    icon: 'specialist'
  },
  {
    id: '03',
    title: 'Senior Lecturer in Neurosurgery',
    institution: 'Jomo Kenyatta University of Agriculture & Technology (JKUAT)',
    description: 'Serving as Senior Lecturer since 2016, training neurosurgery residents and medical students, guiding clinical research, and advancing peer-reviewed surgical literature.',
    year: '2016 – Present',
    badge: 'Academic & Clinical Faculty',
    icon: 'faculty'
  },
  {
    id: '04',
    title: 'Clinical & Research Fellowship in General Neurosurgery',
    institution: 'University of Toronto, Canada',
    description: 'Completed an advanced Clinical and Research Fellowship in General Neurosurgery, acquiring international specialist expertise in advanced cranial microsurgery, skull base techniques, and global surgery systems.',
    year: '2019',
    badge: 'International Fellowship',
    icon: 'fellowship'
  },
  {
    id: '05',
    title: 'Founder & Lead Neurosurgeon',
    institution: 'Sage Brain & Spine Clinic',
    description: 'Established Sage Brain & Spine Clinic in Nairobi at KNH Doctors Plaza, Suite 43, providing patient-focused, evidence-based neurosurgical consultation and operative care.',
    year: 'Practice Founder',
    badge: 'Private Specialist Practice',
    icon: 'clinic'
  }
];
---

<section class="py-20 sm:py-28 bg-midnight relative overflow-hidden" id="milestones-section">
  <!-- Subtle Ambient Glows -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-copper/5 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/3 right-1/4 w-96 h-96 bg-gold/5 rounded-full blur-[120px]"></div>
  </div>

  <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-5xl">
    
    <!-- Section Heading with Scroll Entrance -->
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-24 timeline-header opacity-0 translate-y-6 transition-all duration-700 ease-out">
      <div class="flex items-center justify-center gap-3 mb-3">
        <span class="w-8 h-[2px] bg-copper"></span>
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Career Path</span>
        <span class="w-8 h-[2px] bg-copper"></span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory tracking-tight mb-4">
        Verified Career Milestones
      </h2>
      <p class="text-sage text-base sm:text-lg font-light leading-relaxed">
        A progressive career grounded in rigorous medical education, specialist surgical training, international fellowship, academic faculty leadership, and dedicated clinical practice.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative" id="timeline-container">
      
      <!-- Static Background Guide Track -->
      <div class="absolute left-4 sm:left-1/2 top-4 bottom-4 w-[2px] bg-ivory/10 -translate-x-1/2" aria-hidden="true"></div>

      <!-- Scroll-Driven Animated Active Beam -->
      <div 
        id="timeline-active-beam"
        class="absolute left-4 sm:left-1/2 top-4 w-[2.5px] bg-gradient-to-b from-copper via-gold to-copper -translate-x-1/2 rounded-full shadow-[0_0_14px_rgba(193,122,62,0.85)] origin-top transition-[height] duration-200 ease-out z-10"
        style="height: 0px;"
        aria-hidden="true"
      ></div>

      <!-- Milestone Items List -->
      <div class="space-y-12 sm:space-y-20 relative z-20">
        {milestones.map((item, index) => {
          const isEven = index % 2 === 1;
          const slideDirection = isEven ? 'from-right' : 'from-left';
          return (
            <div 
              class={`timeline-item group relative flex flex-col sm:flex-row items-start sm:items-center ${slideDirection}`}
              data-index={index}
            >
              
              <!-- Timeline Marker Node -->
              <div 
                class="timeline-node absolute left-4 sm:left-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-midnight border-2 border-ivory/20 flex items-center justify-center z-30 transition-all duration-500 shadow-md group-hover:scale-110"
              >
                <!-- Inner indicator dot -->
                <span class="timeline-node-dot w-2.5 h-2.5 rounded-full bg-ivory/40 transition-all duration-500"></span>
                <!-- Ripple ring effect -->
                <span class="timeline-node-ripple absolute inset-0 rounded-full border border-copper opacity-0 transition-opacity duration-500 pointer-events-none"></span>
              </div>

              <!-- Content Card Container -->
              <div class={`w-full sm:w-[calc(50%-2.75rem)] pl-12 sm:pl-0 ${isEven ? 'sm:ml-auto' : 'sm:mr-auto'}`}>
                <div class="timeline-card p-6 sm:p-8 rounded-2xl bg-midnight-light/80 border border-ivory/10 hover:border-copper/40 transition-all duration-500 shadow-xl relative overflow-hidden backdrop-blur-sm hover:shadow-[0_12px_30px_-10px_rgba(193,122,62,0.15)] hover:-translate-y-1">
                  
                  <!-- Top Decorative Edge Glow -->
                  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-copper/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                  <!-- Top Badge & Year -->
                  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <span class="font-mono text-xs font-semibold text-copper tracking-wider uppercase flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-copper inline-block"></span>
                      {item.year}
                    </span>
                    <span class="text-[10px] font-mono px-3 py-1 rounded-full bg-ivory/5 text-sage border border-ivory/10 tracking-wide font-medium">
                      {item.badge}
                    </span>
                  </div>

                  <!-- Degree / Role Title -->
                  <h3 class="font-display text-xl sm:text-2xl font-bold text-ivory mb-2 group-hover:text-copper transition-colors duration-300">
                    {item.title}
                  </h3>

                  <!-- Institution -->
                  <p class="text-xs font-mono text-gold tracking-wide mb-3 flex items-center gap-1.5 font-medium">
                    <svg class="w-3.5 h-3.5 text-gold/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    {item.institution}
                  </p>

                  <!-- Narrative Description -->
                  <p class="text-sage text-sm font-light leading-relaxed">
                    {item.description}
                  </p>

                </div>
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<style>
  /* Entrance initial states */
  .timeline-header.is-inview {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-item.from-left {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .timeline-item.from-left {
      transform: translateX(-40px);
    }
    .timeline-item.from-right {
      transform: translateX(40px);
    }
  }

  .timeline-item.from-right {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Revealed states */
  .timeline-item.is-revealed {
    opacity: 1 !important;
    transform: translate(0, 0) !important;
  }

  /* Node active glowing state */
  .timeline-node.is-active {
    border-color: #C17A3E !important;
    background-color: #071522 !important;
    box-shadow: 0 0 16px rgba(193, 122, 62, 0.6) !important;
  }

  .timeline-node.is-active .timeline-node-dot {
    background-color: #C17A3E !important;
    box-shadow: 0 0 8px #C17A3E !important;
    transform: scale(1.2);
  }

  .timeline-node.is-active .timeline-node-ripple {
    opacity: 0.8;
    animation: ripple 2s infinite cubic-bezier(0, 0.2, 0.8, 1);
  }

  @keyframes ripple {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-header,
    .timeline-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .timeline-node-ripple {
      animation: none !important;
    }
  }
</style>

<script>
  function initTimelineScroll() {
    const container = document.getElementById('timeline-container');
    const activeBeam = document.getElementById('timeline-active-beam');
    const items = document.querySelectorAll('.timeline-item');
    const header = document.querySelector('.timeline-header');

    if (!container || !activeBeam) return;

    // 1. Observe header reveal
    if (header) {
      const headerObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            header.classList.add('is-inview');
            headerObserver.disconnect();
          }
        });
      }, { threshold: 0.2 });
      headerObserver.observe(header);
    }

    // 2. Observe milestone items entrance
    const itemObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    }, { rootMargin: '0px 0px -15% 0px', threshold: 0.15 });

    items.forEach(item => itemObserver.observe(item));

    // 3. Dynamic beam fill on scroll
    function updateBeam() {
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // Calculate how far down the timeline container the user has scrolled
      const startTrigger = windowHeight * 0.7; // Start beam when top of timeline is at 70% viewport
      const totalHeight = container.offsetHeight;
      const currentScroll = startTrigger - rect.top;
      
      let progress = currentScroll / totalHeight;
      progress = Math.max(0, Math.min(1, progress));

      const beamHeight = progress * totalHeight;
      activeBeam.style.height = `${beamHeight}px`;

      // Activate nodes as the beam reaches them
      items.forEach(item => {
        const node = item.querySelector('.timeline-node');
        if (!node) return;

        const nodeRect = node.getBoundingClientRect();
        // If node has passed into the active beam zone
        if (nodeRect.top <= windowHeight * 0.65) {
          node.classList.add('is-active');
        } else {
          node.classList.remove('is-active');
        }
      });
    }

    window.addEventListener('scroll', updateBeam, { passive: true });
    window.addEventListener('resize', updateBeam);
    // Initial call
    updateBeam();
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelineScroll);
  } else {
    initTimelineScroll();
  }
</script>
