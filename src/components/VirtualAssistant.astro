---
// Virtual Dr. Sylvia Chatbot Component
// Intelligent interactive clinical assistant for Sage Brain & Spine Clinic
---

<div id="virtual-assistant-root" class="relative">
  <!-- Proactive Teaser Speech Bubble -->
  <div
    id="assistant-teaser"
    class="fixed bottom-[142px] sm:bottom-[152px] right-4 sm:right-6 z-40 max-w-[270px] sm:max-w-[300px] p-3.5 rounded-2xl bg-midnight/95 backdrop-blur-md border border-copper/40 shadow-xl shadow-midnight/60 text-xs text-ivory opacity-0 pointer-events-none translate-y-3 transition-all duration-500 ease-out"
    role="dialog"
    aria-label="Virtual Assistant Greeting"
  >
    <div class="flex items-start gap-2.5">
      <div class="w-8 h-8 rounded-full overflow-hidden border border-copper/50 shrink-0">
        <img
          src="/images/dr-shitsama-headshot.jpg"
          alt="Virtual Dr. Sylvia"
          class="w-full h-full object-cover"
          width="32"
          height="32"
          loading="lazy"
        />
      </div>
      <div class="flex-1 min-w-0 pr-4 cursor-pointer" id="teaser-open-btn">
        <div class="flex items-center gap-1.5 mb-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-display font-semibold text-copper tracking-wide">Dr. Sylvia's Assistant</span>
        </div>
        <p class="text-ivory/90 leading-snug">
          Hello! Need assistance booking a consultation or exploring neurosurgical care?
        </p>
        <span class="inline-block mt-1 text-[11px] text-copper font-medium hover:underline">
          Tap to chat &rarr;
        </span>
      </div>
      <button
        id="teaser-close-btn"
        type="button"
        class="absolute top-2 right-2 text-sage/70 hover:text-ivory transition-colors p-1"
        aria-label="Dismiss greeting"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <!-- Little Speech Bubble Tail -->
    <div class="absolute -bottom-1.5 right-6 w-3 h-3 bg-midnight border-r border-b border-copper/40 transform rotate-45"></div>
  </div>

  <!-- Floating Trigger Button (Positioned Directly Above WhatsApp Button) -->
  <button
    id="assistant-toggle-btn"
    type="button"
    class="fixed bottom-[74px] sm:bottom-[86px] right-4 sm:right-6 z-40 w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-midnight-light/95 border-2 border-copper/70 text-ivory shadow-lg shadow-copper/20 hover:border-copper hover:shadow-copper/40 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center justify-center group focus:outline-none focus:ring-2 focus:ring-copper/50"
    aria-label="Open Virtual Dr. Sylvia Chatbot"
    aria-expanded="false"
    aria-controls="assistant-window"
  >
    <!-- Avatar with Online Green Dot -->
    <div class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden border border-copper/40 group-hover:border-copper">
      <img
        src="/images/dr-shitsama-headshot.jpg"
        alt="Virtual Dr. Sylvia Assistant"
        class="w-full h-full object-cover"
        width="40"
        height="40"
        loading="lazy"
      />
    </div>
    <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-midnight flex items-center justify-center">
      <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping opacity-75"></span>
    </span>
    <!-- Subtle Tooltip on Hover for Desktop -->
    <span class="hidden md:group-hover:block absolute right-full mr-3 px-2.5 py-1 rounded-md bg-midnight/90 border border-ivory/15 text-[11px] font-mono text-ivory uppercase tracking-wider whitespace-nowrap pointer-events-none shadow-md">
      Virtual Assistant
    </span>
  </button>

  <!-- Chatbot Window Modal -->
  <div
    id="assistant-window"
    class="fixed z-50 transition-all duration-300 ease-out opacity-0 pointer-events-none scale-95
           inset-x-3 bottom-3 top-auto sm:inset-auto sm:bottom-[86px] sm:right-6
           w-auto sm:w-[400px] h-[82vh] sm:h-[590px] max-h-[640px]
           bg-midnight/98 backdrop-blur-xl border border-copper/40 rounded-2xl shadow-2xl shadow-midnight/90
           flex flex-col overflow-hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="assistant-title"
  >
    <!-- Chat Header -->
    <div class="p-3.5 sm:p-4 bg-gradient-to-r from-midnight-light via-midnight to-midnight-light border-b border-ivory/10 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <div class="relative w-10 h-10 rounded-full overflow-hidden border-2 border-copper shrink-0 shadow-sm">
          <img
            src="/images/dr-shitsama-headshot.jpg"
            alt="Dr. Sylvia Shitsama Assistant"
            class="w-full h-full object-cover"
            width="40"
            height="40"
          />
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 border border-midnight"></span>
        </div>
        <div class="min-w-0">
          <h2 id="assistant-title" class="font-display font-bold text-sm sm:text-base text-ivory truncate flex items-center gap-1.5">
            Dr. Sylvia's Assistant
            <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-copper/20 text-copper font-medium tracking-wide">AI</span>
          </h2>
          <p class="text-[11px] text-sage truncate font-light">
            Sage Brain &amp; Spine Clinic &middot; Nairobi
          </p>
        </div>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-1 shrink-0">
        <!-- Reset Chat Button -->
        <button
          id="assistant-reset-btn"
          type="button"
          class="p-1.5 text-sage/70 hover:text-ivory hover:bg-ivory/5 rounded-lg transition-colors"
          title="Restart Conversation"
          aria-label="Restart Conversation"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        </button>

        <!-- Close Window Button -->
        <button
          id="assistant-close-btn"
          type="button"
          class="p-1.5 text-sage/70 hover:text-ivory hover:bg-ivory/5 rounded-lg transition-colors"
          title="Close Chat"
          aria-label="Close Chat"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Chat Messages Stream -->
    <div
      id="assistant-messages"
      class="flex-1 p-3.5 sm:p-4 overflow-y-auto space-y-3.5 overscroll-contain text-sm text-ivory/90 font-light"
    >
      <!-- Initial Welcome Message from Dr. Sylvia's Assistant -->
      <div class="flex items-start gap-2.5 message-bot">
        <div class="w-7 h-7 rounded-full overflow-hidden border border-copper/50 shrink-0 mt-0.5">
          <img
            src="/images/dr-shitsama-headshot.jpg"
            alt="Assistant"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex-1 bg-midnight-light border border-ivory/10 rounded-2xl rounded-tl-sm p-3.5 text-xs sm:text-sm text-ivory/90 leading-relaxed shadow-sm">
          <p class="font-medium text-copper mb-1.5 font-display text-sm">
            Greetings! Welcome to Sage Brain &amp; Spine Clinic.
          </p>
          <p class="mb-2">
            I am Dr. Sylvia Shitsama's Virtual Assistant. I can guide you with:
          </p>
          <ul class="list-disc pl-4 space-y-1 mb-3 text-sage text-xs">
            <li>Booking clinical consultations in Nairobi</li>
            <li>Brain &amp; spine surgical conditions</li>
            <li>Accepted insurance panels &amp; direct billing</li>
            <li>Clinic location at KNH Doctors Plaza</li>
            <li>Dr. Sylvia's qualifications &amp; research</li>
          </ul>
          <p class="text-xs text-ivory/80">
            How may I assist you today? You can choose a quick topic below or type your question.
          </p>
        </div>
      </div>

      <!-- Quick Action Suggestion Chips -->
      <div id="quick-prompts" class="pt-1 flex flex-wrap gap-1.5">
        <button type="button" class="quick-chip" data-prompt="How do I book a consultation with Dr. Sylvia?">
          📅 Book Consultation
        </button>
        <button type="button" class="quick-chip" data-prompt="Which insurance panels are accepted?">
          🛡️ Accepted Insurance
        </button>
        <button type="button" class="quick-chip" data-prompt="Where is Sage Brain & Spine Clinic located and what are the hours?">
          📍 Clinic Location &amp; Hours
        </button>
        <button type="button" class="quick-chip" data-prompt="What conditions does Dr. Sylvia treat?">
          🧠 Brain &amp; Spine Conditions
        </button>
        <button type="button" class="quick-chip" data-prompt="Tell me about Dr. Sylvia Shitsama's background and experience.">
          👩‍⚕️ About Dr. Sylvia
        </button>
      </div>
    </div>

    <!-- Typing Indicator (Hidden by default) -->
    <div id="assistant-typing" class="px-4 py-2 bg-midnight/90 border-t border-ivory/5 flex items-center gap-2 text-xs text-sage hidden">
      <span class="w-1.5 h-1.5 rounded-full bg-copper animate-bounce"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-copper animate-bounce [animation-delay:0.2s]"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-copper animate-bounce [animation-delay:0.4s]"></span>
      <span class="text-[11px] font-mono">Dr. Sylvia's Assistant is typing...</span>
    </div>

    <!-- Chat Input Form -->
    <div class="p-3 sm:p-3.5 bg-midnight-light border-t border-ivory/10 shrink-0">
      <form id="assistant-form" class="flex items-center gap-2">
        <input
          id="assistant-input"
          type="text"
          placeholder="Ask a question about Dr. Sylvia, bookings, or conditions..."
          class="flex-1 bg-midnight/80 border border-ivory/15 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-ivory placeholder-sage/50 focus:outline-none focus:border-copper/70 focus:ring-1 focus:ring-copper/40 transition-colors"
          autocomplete="off"
          maxlength="250"
        />
        <button
          type="submit"
          class="p-2.5 rounded-xl bg-copper hover:bg-copper-dark text-white shadow-md shadow-copper/20 hover:shadow-copper/40 active:scale-95 transition-all flex items-center justify-center shrink-0 disabled:opacity-50 disabled:pointer-events-none"
          aria-label="Send message"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </form>
      <!-- Disclaimer Footer -->
      <div class="mt-2 text-[10px] text-sage/60 text-center leading-tight">
        Informational clinical guide. In medical emergencies, visit the nearest emergency centre immediately.
      </div>
    </div>
  </div>
</div>

<style>
  .quick-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    font-size: 0.72rem;
    font-family: inherit;
    border-radius: 9999px;
    background-color: rgba(193, 122, 62, 0.12);
    border: 1px solid rgba(193, 122, 62, 0.35);
    color: #f6f4ee;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
  }
  .quick-chip:hover {
    background-color: rgba(193, 122, 62, 0.25);
    border-color: #c17a3e;
    transform: translateY(-1px);
  }
  .quick-chip:active {
    transform: scale(0.97);
  }

  /* Custom scrollbar for chat messages */
  #assistant-messages::-webkit-scrollbar {
    width: 5px;
  }
  #assistant-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #assistant-messages::-webkit-scrollbar-thumb {
    background: rgba(193, 122, 62, 0.3);
    border-radius: 4px;
  }
  #assistant-messages::-webkit-scrollbar-thumb:hover {
    background: rgba(193, 122, 62, 0.6);
  }
</style>

<script>
  // Virtual Assistant Comprehensive Knowledge Base & Response Engine
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('virtual-assistant-root');
    if (!root) return;

    const teaser = document.getElementById('assistant-teaser');
    const teaserOpenBtn = document.getElementById('teaser-open-btn');
    const teaserCloseBtn = document.getElementById('teaser-close-btn');
    const toggleBtn = document.getElementById('assistant-toggle-btn');
    const chatWindow = document.getElementById('assistant-window');
    const closeBtn = document.getElementById('assistant-close-btn');
    const resetBtn = document.getElementById('assistant-reset-btn');
    const messagesContainer = document.getElementById('assistant-messages');
    const typingIndicator = document.getElementById('assistant-typing');
    const form = document.getElementById('assistant-form');
    const input = document.getElementById('assistant-input') as HTMLInputElement | null;

    let isOpen = false;
    let teaserDismissed = sessionStorage.getItem('assistant_teaser_dismissed') === 'true';

    // Show proactive greeting teaser after 3 seconds if not dismissed
    if (!teaserDismissed && teaser) {
      setTimeout(() => {
        if (!isOpen && teaser) {
          teaser.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
          teaser.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        }
      }, 3000);
    }

    const hideTeaser = () => {
      if (teaser) {
        teaser.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        teaser.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
      }
      sessionStorage.setItem('assistant_teaser_dismissed', 'true');
    };

    if (teaserCloseBtn) {
      teaserCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        hideTeaser();
      });
    }

    const openChat = () => {
      isOpen = true;
      hideTeaser();
      if (chatWindow && toggleBtn) {
        chatWindow.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        chatWindow.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        toggleBtn.setAttribute('aria-expanded', 'true');
        setTimeout(() => input?.focus(), 300);
      }
    };

    const closeChat = () => {
      isOpen = false;
      if (chatWindow && toggleBtn) {
        chatWindow.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        chatWindow.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    };

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        if (isOpen) closeChat();
        else openChat();
      });
    }

    if (teaserOpenBtn) {
      teaserOpenBtn.addEventListener('click', openChat);
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeChat);
    }

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeChat();
      }
    });

    // Comprehensive Clinical & Clinic Knowledge Base Engine
    const CLINIC_INFO = {
      phone: '+254 110 090 116',
      whatsapp: '254110090116',
      email: 'info@drsylviashitsama.com',
      location: 'KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi, Kenya',
      hours: 'Monday to Friday: 8:00 AM – 5:00 PM | Saturday: 9:00 AM – 1:00 PM (Emergency care & surgeries scheduled around the clock)',
      insurances: [
        'Jubilee Insurance',
        'Britam Insurance',
        'CIC Group',
        'Old Mutual',
        'APA Insurance',
        'AAR Insurance',
        'Madison Insurance',
        'First Assurance'
      ],
      fellowship: 'University of Toronto, Canada (Clinical and Research Fellowship in General Neurosurgery, 2019)',
      credentials: 'MBChB (UoN), MMed in Neurosurgery (UoN), Senior Lecturer in Surgery at JKUAT, Neurosurgeon at Kenyatta National Referral Hospital (KNH)',
      specialties: [
        'Brain Tumors (Meningiomas, Gliomas, Pituitary Adenomas, Skull Base Tumors)',
        'Traumatic Brain Injury (TBI, Epidural & Subdural Hematomas, Skull Fractures)',
        'Spine Surgery (Herniated Discs, Spinal Stenosis, Sciatica, Decompression & Fusion)',
        'Hydrocephalus (Ventriculoperitoneal / VP Shunts, Endoscopic Third Ventriculostomy / ETV)',
        'Pediatric Neurosurgery (Spina Bifida, Encephalocele, Congenital Malformations)',
        'Neurovascular Care & Stroke-related Neurosurgical Interventions'
      ]
    };

    const scrollToBottom = () => {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    };

    const appendUserMessage = (text: string) => {
      if (!messagesContainer) return;
      const userDiv = document.createElement('div');
      userDiv.className = 'flex items-start justify-end gap-2.5 message-user animate-fade-in';
      userDiv.innerHTML = `
        <div class="bg-copper text-white rounded-2xl rounded-tr-sm p-3 max-w-[85%] text-xs sm:text-sm leading-relaxed shadow-md">
          <p>${escapeHtml(text)}</p>
        </div>
      `;
      messagesContainer.appendChild(userDiv);
      scrollToBottom();
    };

    const appendBotMessage = (htmlContent: string) => {
      if (!messagesContainer) return;
      const botDiv = document.createElement('div');
      botDiv.className = 'flex items-start gap-2.5 message-bot animate-fade-in';
      botDiv.innerHTML = `
        <div class="w-7 h-7 rounded-full overflow-hidden border border-copper/50 shrink-0 mt-0.5">
          <img src="/images/dr-shitsama-headshot.jpg" alt="Dr. Sylvia's Assistant" class="w-full h-full object-cover" />
        </div>
        <div class="flex-1 bg-midnight-light border border-ivory/10 rounded-2xl rounded-tl-sm p-3.5 text-xs sm:text-sm text-ivory/90 leading-relaxed shadow-sm">
          ${htmlContent}
        </div>
      `;
      messagesContainer.appendChild(botDiv);
      scrollToBottom();

      // Bind dynamic chip buttons within this response if any
      botDiv.querySelectorAll('.bot-action-chip').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const prompt = (e.currentTarget as HTMLElement).getAttribute('data-prompt');
          if (prompt) handleUserInput(prompt);
        });
      });
    };

    const escapeHtml = (str: string) => {
      return str.replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[m] || m));
    };

    // Intelligence Answer Matcher
    const generateBotResponse = (query: string): string => {
      const q = query.toLowerCase().trim();

      // 1. Emergency Warning Signs
      if (q.includes('emergency') || q.includes('urgent') || q.includes('unconscious') || q.includes('seizure') || q.includes('worst headache') || q.includes('paralysis') || q.includes('coma')) {
        return `
          <div class="text-rose-400 font-semibold mb-1 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Medical Emergency Guidance
          </div>
          <p class="mb-2">If you or a loved one is experiencing acute neurological signs such as sudden loss of consciousness, sudden paralysis, active convulsions, or severe head trauma, please seek <strong>immediate emergency care</strong> at the nearest hospital casualty (such as KNH Emergency, Nairobi Hospital, or Aga Khan University Hospital).</p>
          <p class="mb-3 text-sage">For immediate emergency ambulance assistance in Kenya, call <strong>999 / 112</strong>.</p>
          <div class="flex flex-wrap gap-2 pt-1">
            <a href="tel:+254110090116" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs transition-colors">
              📞 Call Clinic Emergency Line
            </a>
          </div>
        `;
      }

      // 2. Booking / Appointment
      if (q.includes('book') || q.includes('appointment') || q.includes('consult') || q.includes('see dr') || q.includes('cost') || q.includes('fee') || q.includes('schedule')) {
        return `
          <p class="font-medium text-copper mb-1.5">Consultation &amp; Appointment Booking</p>
          <p class="mb-2">Consultations with Dr. Sylvia Shitsama are conducted at <strong>Sage Brain &amp; Spine Clinic</strong>, located at <strong>KNH Doctors Plaza, Suite 43, Nairobi</strong>.</p>
          <div class="p-2.5 rounded-xl bg-midnight border border-ivory/10 space-y-1 mb-3 text-xs">
            <div class="text-ivory"><strong class="text-sage">Hours:</strong> Mon–Fri 8:00 AM – 5:00 PM | Sat 9:00 AM – 1:00 PM</div>
            <div class="text-ivory"><strong class="text-sage">Direct Line:</strong> <a href="tel:+254110090116" class="text-copper hover:underline">+254 110 090 116</a></div>
            <div class="text-ivory"><strong class="text-sage">Referrals:</strong> Both self-referrals and physician referrals are welcome.</div>
          </div>
          <p class="text-xs mb-3 text-sage">Please bring any prior MRI/CT brain or spine scans, blood tests, or previous doctors' notes to your consultation.</p>
          <div class="flex flex-wrap gap-2">
            <a href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-copper hover:bg-copper-dark text-white font-medium text-xs transition-colors shadow-sm">
