---
// Virtual Dr. Sylvia Chatbot Component
// Clean White Medical Aesthetic, Perfectly Sized & Fully Responsive
---

<div id="virtual-assistant-root" class="relative">
  <!-- Proactive Teaser Speech Bubble (White Theme) -->
  <div
    id="assistant-teaser"
    class="fixed bottom-[136px] sm:bottom-[148px] right-4 sm:right-6 z-40 max-w-[260px] sm:max-w-[280px] p-3 rounded-xl bg-white border border-[#c17a3e]/60 shadow-xl shadow-slate-900/10 text-xs text-slate-800 opacity-0 pointer-events-none translate-y-2 transition-all duration-400 ease-out"
    role="dialog"
    aria-label="Virtual Assistant Greeting"
  >
    <div class="flex items-start gap-2.5">
      <div class="w-7 h-7 rounded-full overflow-hidden border-2 border-[#c17a3e] shrink-0 shadow-sm">
        <img
          src="/images/dr-shitsama-headshot.jpg"
          alt="Virtual Dr. Sylvia"
          class="w-full h-full object-cover"
          width="28"
          height="28"
          loading="lazy"
        />
      </div>
      <div class="flex-1 min-w-0 pr-3 cursor-pointer" id="teaser-open-btn">
        <div class="flex items-center gap-1.5 mb-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-display font-bold text-[#c17a3e] text-xs tracking-wide">Dr. Sylvia's Assistant</span>
        </div>
        <p class="text-slate-600 text-[11px] leading-snug">
          Need help booking a consultation or exploring brain &amp; spine care?
        </p>
        <span class="inline-block mt-1 text-[11px] text-[#c17a3e] font-semibold hover:underline">
          Tap to chat &rarr;
        </span>
      </div>
      <button
        id="teaser-close-btn"
        type="button"
        class="text-slate-400 hover:text-slate-700 transition-colors p-1"
        aria-label="Dismiss greeting"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <!-- Speech bubble pointer -->
    <div class="absolute -bottom-1.5 right-6 w-3 h-3 bg-white border-r border-b border-[#c17a3e]/60 transform rotate-45"></div>
  </div>

  <!-- Floating Trigger Button (White Theme, Positioned Directly Above WhatsApp) -->
  <button
    id="assistant-toggle-btn"
    type="button"
    class="fixed bottom-[74px] sm:bottom-[84px] right-4 sm:right-6 z-40 w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-white border-2 border-[#c17a3e] text-slate-800 shadow-lg shadow-slate-900/15 hover:border-[#a6642e] hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center group focus:outline-none focus:ring-2 focus:ring-[#c17a3e]"
    aria-label="Open Virtual Dr. Sylvia Chatbot"
    aria-expanded="false"
    aria-controls="assistant-window"
  >
    <div class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-full overflow-hidden border border-[#c17a3e]/40">
      <img
        src="/images/dr-shitsama-headshot.jpg"
        alt="Virtual Dr. Sylvia Assistant"
        class="w-full h-full object-cover"
        width="36"
        height="36"
        loading="lazy"
      />
    </div>
    <span class="absolute top-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center shadow-xs">
      <span class="w-1 h-1 rounded-full bg-white animate-ping opacity-75"></span>
    </span>
    <!-- Tooltip on hover for desktop -->
    <span class="hidden md:group-hover:block absolute right-full mr-2.5 px-2 py-0.5 rounded bg-slate-900 text-[10px] font-mono text-white uppercase tracking-wider whitespace-nowrap pointer-events-none shadow-md">
      Virtual Assistant
    </span>
  </button>

  <!-- Clean White Responsive Chatbot Window Modal -->
  <div
    id="assistant-window"
    class="fixed z-50 transition-all duration-300 ease-out opacity-0 pointer-events-none scale-95
           inset-x-3 bottom-3 sm:inset-auto sm:bottom-5 sm:right-6
           w-auto sm:w-[360px] h-[480px] max-h-[calc(100dvh-70px)] sm:max-h-[500px]
           bg-white border border-slate-200 rounded-2xl shadow-2xl shadow-slate-900/25
           flex flex-col overflow-hidden text-slate-800"
    role="dialog"
    aria-modal="true"
    aria-labelledby="assistant-title"
  >
    <!-- Chat Header (Clean White / Off-White) -->
    <div class="px-3.5 py-3 bg-white border-b border-slate-100 flex items-center justify-between shrink-0 shadow-xs">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="relative w-8 h-8 rounded-full overflow-hidden border-2 border-[#c17a3e] shrink-0 shadow-xs">
          <img
            src="/images/dr-shitsama-headshot.jpg"
            alt="Dr. Sylvia Shitsama Assistant"
            class="w-full h-full object-cover"
            width="32"
            height="32"
          />
          <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 border-2 border-white"></span>
        </div>
        <div class="min-w-0">
          <h2 id="assistant-title" class="font-display font-bold text-sm text-slate-900 truncate">
            Dr. Sylvia's Assistant
          </h2>
          <p class="text-[10px] text-slate-500 truncate">
            Sage Brain &amp; Spine Clinic &middot; Nairobi
          </p>
        </div>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-1 shrink-0">
        <!-- Reset Chat Button -->
        <button
          id="assistant-reset-btn"
          type="button"
          class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors"
          title="Restart Conversation"
          aria-label="Restart Conversation"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        </button>

        <!-- Close Window Button -->
        <button
          id="assistant-close-btn"
          type="button"
          class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors"
          title="Close Chat"
          aria-label="Close Chat"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Chat Messages Stream (Light Grey Background) -->
    <div
      id="assistant-messages"
      class="flex-1 p-3 overflow-y-auto space-y-3 overscroll-contain bg-[#f8fafc] text-xs text-slate-800 leading-relaxed"
    >
      <!-- Initial Welcome Message from Dr. Sylvia's Assistant -->
      <div class="flex items-start gap-2 message-bot">
        <div class="w-6 h-6 rounded-full overflow-hidden border border-[#c17a3e] shrink-0 mt-0.5 shadow-xs">
          <img
            src="/images/dr-shitsama-headshot.jpg"
            alt="Assistant"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex-1 bg-white border border-slate-200/90 rounded-xl rounded-tl-sm p-3 text-xs leading-relaxed shadow-xs">
          <p class="font-bold text-[#c17a3e] mb-1 font-display">
            Greetings! Welcome to Sage Brain &amp; Spine Clinic.
          </p>
          <p class="mb-1.5 text-slate-600">
            I am Dr. Sylvia's Virtual Assistant. Ask me anything or select a topic:
          </p>
          <ul class="list-disc pl-3.5 space-y-0.5 mb-2 text-slate-500 text-[11px]">
            <li>Bookings &amp; Clinic Hours at KNH Doctors Plaza</li>
            <li>Accepted Insurance Panels &amp; Direct Billing</li>
            <li>Brain &amp; Spine Surgical Conditions</li>
            <li>Dr. Sylvia's Qualifications &amp; Research</li>
          </ul>
        </div>
      </div>

      <!-- Quick Action Suggestion Chips (Clean White Pill Styling) -->
      <div id="quick-prompts" class="pt-0.5 flex flex-wrap gap-1.5">
        <button type="button" class="quick-chip" data-prompt="How do I book a consultation with Dr. Sylvia?">
          📅 Book Consultation
        </button>
        <button type="button" class="quick-chip" data-prompt="Which insurance panels are accepted?">
          🛡️ Accepted Insurance
        </button>
        <button type="button" class="quick-chip" data-prompt="Where is Sage Brain & Spine Clinic located and what are the hours?">
          📍 Location &amp; Hours
        </button>
        <button type="button" class="quick-chip" data-prompt="What conditions does Dr. Sylvia treat?">
          🧠 Brain &amp; Spine
        </button>
        <button type="button" class="quick-chip" data-prompt="Tell me about Dr. Sylvia Shitsama's background and experience.">
          👩‍⚕️ About Dr. Sylvia
        </button>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="assistant-typing" class="px-3 py-1.5 bg-white border-t border-slate-100 flex items-center gap-2 text-[11px] text-slate-500 hidden">
      <span class="w-1.5 h-1.5 rounded-full bg-[#c17a3e] animate-bounce"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#c17a3e] animate-bounce [animation-delay:0.2s]"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#c17a3e] animate-bounce [animation-delay:0.4s]"></span>
      <span class="font-mono text-[10px]">Assistant is answering...</span>
    </div>

    <!-- Chat Input Form (Pure White) -->
    <div class="p-2.5 bg-white border-t border-slate-100 shrink-0">
      <form id="assistant-form" class="flex items-center gap-1.5">
        <input
          id="assistant-input"
          type="text"
          placeholder="Ask Dr. Sylvia's assistant..."
          class="flex-1 bg-slate-50 border border-slate-200 focus:border-[#c17a3e] focus:bg-white rounded-lg px-3 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none transition-colors"
          autocomplete="off"
          maxlength="200"
        />
        <button
          type="submit"
          class="p-2 rounded-lg bg-[#c17a3e] hover:bg-[#a6642e] text-white shadow-sm active:scale-95 transition-all flex items-center justify-center shrink-0 disabled:opacity-50"
          aria-label="Send message"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </form>
      <!-- Disclaimer Footer -->
      <div class="mt-1.5 text-[9px] text-slate-400 text-center leading-tight">
        Clinical guide. For life-threatening emergencies, visit casualty immediately.
      </div>
    </div>
  </div>
</div>

<style>
  .quick-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.2;
    border-radius: 9999px;
    background-color: #ffffff;
    border: 1px solid rgba(193, 122, 62, 0.5);
    color: #a6642e;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .quick-chip:hover {
    background-color: #c17a3e;
    color: #ffffff;
    border-color: #a6642e;
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(193, 122, 62, 0.25);
  }
  .quick-chip:active {
    transform: scale(0.97);
  }

  /* Custom scrollbar for chat messages */
  #assistant-messages::-webkit-scrollbar {
    width: 4px;
  }
  #assistant-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #assistant-messages::-webkit-scrollbar-thumb {
    background: rgba(193, 122, 62, 0.3);
    border-radius: 4px;
  }
  #assistant-messages::-webkit-scrollbar-thumb:hover {
    background: rgba(193, 122, 62, 0.6);
  }
</style>

<script>
  // Virtual Assistant Comprehensive Knowledge Base & Response Engine
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('virtual-assistant-root');
    if (!root) return;

    const teaser = document.getElementById('assistant-teaser');
    const teaserOpenBtn = document.getElementById('teaser-open-btn');
    const teaserCloseBtn = document.getElementById('teaser-close-btn');
    const toggleBtn = document.getElementById('assistant-toggle-btn');
    const chatWindow = document.getElementById('assistant-window');
    const closeBtn = document.getElementById('assistant-close-btn');
    const resetBtn = document.getElementById('assistant-reset-btn');
    const messagesContainer = document.getElementById('assistant-messages');
    const typingIndicator = document.getElementById('assistant-typing');
    const form = document.getElementById('assistant-form');
    const input = document.getElementById('assistant-input') as HTMLInputElement | null;

    let isOpen = false;
    let teaserDismissed = sessionStorage.getItem('assistant_teaser_dismissed') === 'true';

    // Show proactive greeting teaser after 3 seconds if not dismissed
    if (!teaserDismissed && teaser) {
      setTimeout(() => {
        if (!isOpen && teaser) {
          teaser.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          teaser.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        }
      }, 3000);
    }

    const hideTeaser = () => {
      if (teaser) {
        teaser.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        teaser.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
      }
      sessionStorage.setItem('assistant_teaser_dismissed', 'true');
    };

    if (teaserCloseBtn) {
      teaserCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        hideTeaser();
      });
    }

    const openChat = () => {
      isOpen = true;
      hideTeaser();
      if (chatWindow && toggleBtn) {
        chatWindow.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        chatWindow.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        toggleBtn.setAttribute('aria-expanded', 'true');
        setTimeout(() => input?.focus(), 250);
      }
    };

    const closeChat = () => {
      isOpen = false;
      if (chatWindow && toggleBtn) {
        chatWindow.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        chatWindow.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    };

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        if (isOpen) closeChat();
        else openChat();
      });
    }

    if (teaserOpenBtn) {
      teaserOpenBtn.addEventListener('click', openChat);
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeChat);
    }

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeChat();
      }
    });

    const scrollToBottom = () => {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    };

    const appendUserMessage = (text: string) => {
      if (!messagesContainer) return;
      const userDiv = document.createElement('div');
      userDiv.className = 'flex items-start justify-end gap-2 message-user';
      userDiv.innerHTML = `
        <div class="bg-[#c17a3e] text-white rounded-xl rounded-tr-sm p-2.5 max-w-[85%] text-xs leading-relaxed shadow-xs font-normal">
          <p>${escapeHtml(text)}</p>
        </div>
      `;
      messagesContainer.appendChild(userDiv);
      scrollToBottom();
    };

    const appendBotMessage = (htmlContent: string) => {
      if (!messagesContainer) return;
      const botDiv = document.createElement('div');
      botDiv.className = 'flex items-start gap-2 message-bot';
      botDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full overflow-hidden border border-[#c17a3e] shrink-0 mt-0.5 shadow-xs">
          <img src="/images/dr-shitsama-headshot.jpg" alt="Dr. Sylvia's Assistant" class="w-full h-full object-cover" />
        </div>
        <div class="flex-1 bg-white border border-slate-200/90 rounded-xl rounded-tl-sm p-3 text-xs text-slate-800 leading-relaxed shadow-xs">
          ${htmlContent}
        </div>
      `;
      messagesContainer.appendChild(botDiv);
      scrollToBottom();

      // Bind dynamic chip buttons within this response if any
      botDiv.querySelectorAll('.bot-action-chip').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const prompt = (e.currentTarget as HTMLElement).getAttribute('data-prompt');
          if (prompt) handleUserInput(prompt);
        });
      });
    };

    const escapeHtml = (str: string) => {
      return str.replace(/[&<>"']/g, (m) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[m] || m));
    };

    // Intelligence Answer Matcher
    const generateBotResponse = (query: string): string => {
      const q = query.toLowerCase().trim();

      // Remove clinic/doctor names from semantic query so words like "brain" or "spine" in the clinic name don't trigger medical condition handlers
      const cleanQ = q
        .replace(/sage brain & spine clinic/gi, '')
        .replace(/sage brain and spine clinic/gi, '')
        .replace(/sage brain & spine/gi, '')
        .replace(/sage brain and spine/gi, '')
        .replace(/sage brain/gi, '')
        .replace(/sage clinic/gi, '')
        .replace(/dr\.?\s*sylvia\s*shitsama/gi, '')
        .replace(/dr\.?\s*sylvia/gi, '')
        .replace(/shitsama/gi, '');

      // 1. Emergency Warning Signs
      if (q.includes('emergency') || q.includes('urgent') || q.includes('unconscious') || q.includes('seizure') || q.includes('worst headache') || q.includes('paralysis') || q.includes('coma')) {
        return `
          <div class="text-rose-600 font-bold mb-1 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Medical Emergency Guidance
          </div>
          <p class="mb-1.5 text-slate-700">If you or a patient is experiencing acute neurological signs (sudden loss of consciousness, sudden limb weakness, active seizures, or acute head trauma), please seek <strong>immediate emergency care</strong> at the nearest hospital casualty (e.g. KNH Emergency, Nairobi Hospital, or Aga Khan University Hospital).</p>
          <p class="mb-2 text-slate-500">In Kenya, call emergency ambulance lines at <strong>999 / 112</strong>.</p>
          <div class="flex flex-wrap gap-1.5 pt-1">
            <a href="tel:+254110090116" class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-rose-600 hover:bg-rose-700 text-white font-medium text-[11px] transition-colors shadow-xs">
              📞 Call Clinic Line
            </a>
          </div>
        `;
      }

      // 2. Clinic Location, Address, Hours & Directions (Priority Match)
      if (q.includes('where') || q.includes('location') || q.includes('address') || q.includes('hours') || q.includes('open') || q.includes('time') || q.includes('directions') || q.includes('knh') || q.includes('hospital road') || q.includes('plaza') || q.includes('suite 43')) {
        return `
          <p class="font-bold text-[#c17a3e] mb-1">Clinic Location &amp; Hours</p>
          <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 space-y-1 mb-2 text-[11px]">
            <div class="text-slate-900 font-bold">Sage Brain &amp; Spine Clinic</div>
            <div class="text-slate-700">KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi, Kenya</div>
            <div class="text-[#c17a3e] font-semibold">Monday – Friday: 8:00 AM – 5:00 PM<br/>Saturday: 9:00 AM – 1:00 PM</div>
          </div>
          <p class="text-[11px] text-slate-500 mb-2">Secure patient parking available on-site with direct elevator access to Suite 43.</p>
          <div class="flex flex-wrap gap-1.5">
            <a href="https://maps.google.com/?q=KNH+Doctors+Plaza+Nairobi" target="_blank" rel="noopener noreferrer" class="quick-chip bg-[#c17a3e] text-white hover:bg-[#a6642e]">
              🗺️ Open in Google Maps
            </a>
            <a href="/contact" class="quick-chip">
              🏥 Contact &amp; Parking Info &rarr;
            </a>
          </div>
        `;
      }

      // 3. Booking / Appointment
      if (q.includes('book') || q.includes('appointment') || q.includes('consult') || q.includes('see dr') || q.includes('cost') || q.includes('fee') || q.includes('price') || q.includes('schedule')) {
        return `
          <p class="font-bold text-[#c17a3e] mb-1">Consultation &amp; Appointment Booking</p>
          <p class="mb-1.5 text-slate-700">Consultations are conducted at <strong>Sage Brain &amp; Spine Clinic</strong> at <strong>KNH Doctors Plaza, Suite 43, Nairobi</strong>.</p>
          <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 space-y-0.5 mb-2 text-[11px]">
            <div><strong class="text-slate-600">Hours:</strong> Mon–Fri 8:00 AM – 5:00 PM | Sat 9:00 AM – 1:00 PM</div>
            <div><strong class="text-slate-600">Direct Line:</strong> <a href="tel:+254110090116" class="text-[#c17a3e] font-semibold hover:underline">+254 110 090 116</a></div>
            <div><strong class="text-slate-600">Referrals:</strong> Both self-referrals and physician referrals welcome.</div>
          </div>
          <p class="text-[11px] mb-2 text-slate-500">Please bring prior MRI/CT scans, lab reports, or doctor's notes to your review.</p>
          <div class="flex flex-wrap gap-1.5">
            <a href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." target="_blank" rel="noopener noreferrer" class="quick-chip bg-[#c17a3e] text-white hover:bg-[#a6642e]">
              💬 Book via WhatsApp
            </a>
            <a href="/contact" class="quick-chip">
              🏥 Contact Page &rarr;
            </a>
          </div>
        `;
      }

      // 4. Insurance Panels (The 3 official providers)
      if (q.includes('insurance') || q.includes('cover') || q.includes('cic') || q.includes('bupa') || q.includes('heritage') || q.includes('panel') || q.includes('direct billing') || q.includes('pay')) {
        return `
          <p class="font-bold text-[#c17a3e] mb-1">Accepted Insurance Panels</p>
          <p class="mb-1.5 text-slate-700">Sage Brain &amp; Spine Clinic accepts 3 primary insurance underwriters with direct clinical billing and pre-authorisation:</p>
          <div class="space-y-1.5 mb-2.5 text-[11px]">
            <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 flex items-start gap-2">
              <span class="text-[#c17a3e] font-bold">✓</span>
              <div>
                <strong class="text-slate-900">CIC Insurance Group</strong>
