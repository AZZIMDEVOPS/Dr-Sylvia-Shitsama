---
// insights.astro
// Patient education hub answering common brain & spine questions

import Layout from '../layouts/Layout.astro';
import { insights, categories } from '../data/insights';
---

<Layout
  title="Insights & Patient Guidance — Dr. Sylvia Shitsama | Sage Brain & Spine Clinic"
  description="Evidence-based neurosurgical perspectives and clear patient education answering common questions about hydrocephalus, head injuries, and spine conditions."
  canonicalUrl="/insights"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-midnight relative border-b border-ivory/10">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-[1px] bg-copper"></span>
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Sage Brain &amp; Spine Clinic</span>
      </div>
      
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory tracking-tight mb-6">
        Patient Insights &amp; Guidance
      </h1>
      
      <p class="text-sage text-lg sm:text-xl font-light leading-relaxed max-w-2xl mb-8">
        Answering common questions about brain and spinal health in clear, accessible language. Designed to guide patients and families when seeking specialist assessment.
      </p>

      <div class="inline-flex items-center gap-2 text-xs font-mono text-copper bg-copper/10 border border-copper/20 px-3.5 py-1.5 rounded-full">
        <span>Curated for Patients &amp; Families</span>
      </div>
    </div>
  </section>

  <!-- Articles Grid Section -->
  <section class="py-20 sm:py-28 bg-midnight-light" x-data="{ activeCategory: 'All Articles' }">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      
      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-3 overflow-x-auto pb-4 mb-12 hide-scrollbar border-b border-ivory/10">
        {categories.map((cat) => (
          <button 
            @click={`activeCategory = '${cat}'`}
            :class={`activeCategory === '${cat}' ? 'bg-copper text-white' : 'bg-midnight text-sage hover:text-ivory border border-ivory/10'`}
            class="px-4 py-2 rounded-full text-xs font-mono uppercase tracking-wider transition-colors shrink-0 cursor-pointer"
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {insights.map((article) => (
          <article 
            x-show={`activeCategory === 'All Articles' || activeCategory === '${article.category}'`}
            x-transition.opacity.duration.300ms
            class="bg-midnight border border-ivory/10 hover:border-copper/40 rounded-2xl overflow-hidden shadow-xl transition-all duration-300 flex flex-col group hover:-translate-y-1"
          >
            <div class="relative h-52 overflow-hidden bg-slate-900">
              <img 
                src={article.image} 
                alt={article.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-midnight via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4">
                <span class="text-[10px] font-mono uppercase tracking-widest text-copper bg-midnight/80 px-2.5 py-1 rounded border border-ivory/10">
                  {article.category}
                </span>
              </div>
            </div>

            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-xs font-mono text-sage/70 mb-3">
                  <span>{article.date}</span>
                  <span>&middot;</span>
                  <span>{article.readTime}</span>
                </div>

                <h2 class="font-display text-xl sm:text-2xl font-semibold text-ivory mb-3 group-hover:text-copper transition-colors leading-snug">
                  <a href={`/blog/${article.slug}`}>
                    {article.title}
                  </a>
                </h2>

                <p class="text-xs sm:text-sm text-sage font-light leading-relaxed mb-6">
                  {article.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-ivory/10 flex items-center justify-between mt-auto">
                <a 
                  href={`/blog/${article.slug}`} 
                  class="text-xs font-mono uppercase tracking-wider text-copper hover:text-white transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Read Article</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Guidance Note -->
      <div class="mt-16 p-6 rounded-2xl bg-midnight border border-ivory/10 text-center max-w-2xl mx-auto">
        <p class="text-xs text-sage font-light leading-relaxed">
          These articles provide introductory guidance and cannot replace individualized in-person medical evaluation. In case of acute trauma or severe worsening symptoms, proceed to the nearest emergency medical centre immediately.
        </p>
      </div>

    </div>
  </section>

  <!-- Consultation Banner -->
  <section class="py-20 bg-midnight text-center border-t border-ivory/10">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ivory mb-4">
        Need Specialist Neurosurgical Assessment?
      </h2>
      <p class="text-sage text-sm sm:text-base font-light mb-8 leading-relaxed">
        Consultations are conducted at KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-primary text-sm inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Book a Consultation
        </a>
        <a href="/contact" class="btn-ghost text-sm">
          Contact Details &amp; Directions
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
