const allTopics = ['All Research', 'Neurosurgery', 'Global Surgery', 'Health Policy', 'Surgical Equity'];

// Academic & Research Presentations
const presentationInsights = [
  {
    title: 'Faculty Perspectives on Mentorship & Culture in Sub-Saharan Africa',
    forum: 'AMEE International Healthcare Professions Education Conference',
    focusArea: 'Mentorship Systems & Surgical Culture',
    description: 'Presentation of qualitative research conducted with Maastricht University School of Health Professions Education and University of Nairobi examining mentorship frameworks, faculty adaptation, and institutional support across Sub-Saharan Africa.',
    status: 'Recording Link Pending (Dr. Shitsama to supply)',
    recordingAvailable: false,
    recordingUrl: '',
  },
  {
    title: 'Neurosurgical Workforce & Capacity Building in East Africa',
    forum: 'Regional Neurosurgical Academic Symposia',
    focusArea: 'Health Systems & Surgical Capacity',
    description: 'Academic presentation detailing baseline survey data on neurosurgical infrastructure, equipment availability, and training pipelines to expand specialist coverage in East Africa.',
    status: 'Recording Link Pending (Dr. Shitsama to supply)',
    recordingAvailable: false,
    recordingUrl: '',
  },
  {
    title: 'Curriculum & Faculty Development for Surgical Trainees',
    forum: 'Medical Education & Academic Faculty Panels',
    focusArea: 'Teaching & Academic Development',
    description: 'Faculty lecture addressing curriculum needs, leadership development, and structured clinical coaching for postgraduate surgical residents.',
    status: 'Recording Link Pending (Dr. Shitsama to supply)',
    recordingAvailable: false,
    recordingUrl: '',
  },
];
---

<Layout
  title="Selected Publications & Research — Dr. Sylvia Shitsama"
  description="Explore Dr. Sylvia Shitsama's peer-reviewed neurosurgical publications, clinical studies, and academic presentation insights."
  canonicalUrl="/research"
>
  <!-- Main Content Begins Directly with Selected Publications as requested in Section 9 -->
  <section class="pt-32 pb-20 bg-midnight relative border-b border-ivory/10" id="publications">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl" x-data="{ activeFilter: 'All Research' }">
      
      <!-- Direct Section Header (No excessive biography hero) -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-[1px] bg-copper"></span>
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Academic Medicine</span>
          </div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory tracking-tight">
            Selected Publications
          </h1>
          <p class="text-sage text-base sm:text-lg font-light mt-3 max-w-2xl leading-relaxed">
            Peer-reviewed publications by Dr. Sylvia Shitsama covering clinical neurosurgery, hydrocephalus outcomes, workforce capacity, and health systems.
          </p>
        </div>

        <div>
          <a 
            href="https://scholar.google.com/citations?user=-4d8jNkAAAAJ&hl=en" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-copper/40 hover:border-copper text-copper hover:text-ivory px-5 py-3 rounded-xl text-xs font-mono-label tracking-widest uppercase transition-all hover:bg-copper/10 shrink-0"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
            Google Scholar Profile
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto pb-4 mb-8 hide-scrollbar border-b border-ivory/10">
        {allTopics.map((topic) => (
          <button 
            @click={`activeFilter = '${topic}'`}
            :class={`activeFilter === '${topic}' ? 'text-copper border-b-2 border-copper' : 'text-sage hover:text-ivory border-b-2 border-transparent'`}
            class="whitespace-nowrap px-1 pb-3 text-xs sm:text-sm font-mono tracking-wide uppercase transition-colors"
          >
            {topic}
          </button>
        ))}
      </div>

      <!-- Publications List -->
      <div class="divide-y divide-ivory/10 border-t border-ivory/10">
        {publications.map((pub) => (
          <article 
            x-show={`activeFilter === 'All Research' || ${JSON.stringify(pub.topics)}.includes(activeFilter)`}
            x-transition.opacity.duration.300ms
            class="py-6 hover:bg-ivory/[0.02] transition-colors"
          >
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-start">
              
              <!-- Year -->
              <div class="md:col-span-1">
                <span class="font-mono text-copper font-medium text-base">{pub.year}</span>
              </div>
              
              <!-- Title & Journal Details -->
              <div class="md:col-span-8">
                <h2 class="font-display text-lg sm:text-xl font-medium text-ivory mb-2 leading-snug">
                  <a href={pub.link} target="_blank" rel="noopener noreferrer" class="hover:text-copper transition-colors">
                    {pub.title}
                  </a>
                </h2>
                <div class="flex flex-wrap items-center gap-2.5 text-xs text-sage font-light">
                  <span class="italic text-ivory/90 font-normal">{pub.journal}</span>
                  <span class="w-1 h-1 rounded-full bg-ivory/30"></span>
                  <span class="font-mono text-[10px] text-copper uppercase">{pub.topics.join(' · ')}</span>
                  {pub.citations > 0 && (
                    <>
                      <span class="w-1 h-1 rounded-full bg-ivory/30"></span>
                      <span class="text-ivory/70">{pub.citations} Citation{pub.citations !== 1 ? 's' : ''}</span>
                    </>
                  )}
                </div>
              </div>
              
              <!-- Link -->
              <div class="md:col-span-3 flex md:justify-end items-center mt-2 md:mt-0">
                <a 
                  href={pub.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-mono text-copper hover:text-white uppercase tracking-wider transition-colors"
                >
                  <span>View Article (DOI)</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>

            </div>
          </article>
        ))}
      </div>
      
    </div>
  </section>

  <!-- 10. DEDICATED SECTION: RESEARCH PRESENTATIONS & INSIGHTS -->
  <section class="py-24 sm:py-32 bg-midnight-light border-b border-ivory/10" id="presentations">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      
      <div class="max-w-3xl mb-16">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-[1px] bg-copper"></span>
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Academic Contributions</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-ivory tracking-tight mb-4">
          Research Presentations &amp; Insights
        </h2>
        <p class="text-sage text-base sm:text-lg font-light leading-relaxed">
          Dr. Shitsama regularly contributes to international and regional medical forums, sharing insights on faculty perspectives, surgical mentorship systems, research methodologies, and academic development in healthcare.
        </p>
      </div>

      <!-- Flexible Presentation Cards (Prepared for video/audio recording embeds) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {presentationInsights.map((pres) => (
          <div class="bg-midnight border border-ivory/10 rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-copper/30 transition-all duration-300 shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-mono text-copper uppercase tracking-wider bg-copper/10 px-2.5 py-1 rounded border border-copper/20">
                  {pres.focusArea}
                </span>
              </div>

              <h3 class="font-display text-xl font-medium text-ivory mb-2 leading-snug">
                {pres.title}
              </h3>

              <p class="text-xs font-mono text-sage/80 mb-4">
                {pres.forum}
              </p>

              <p class="text-xs text-sage font-light leading-relaxed mb-6">
                {pres.description}
              </p>
            </div>

            <!-- Future Recording Embed Placeholder Structure -->
            <div class="pt-4 border-t border-ivory/10">
              {pres.recordingAvailable ? (
                <a href={pres.recordingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-mono text-copper hover:text-white uppercase tracking-wider">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  <span>Watch Presentation</span>
                </a>
              ) : (
                <div class="flex items-center gap-2 text-[11px] font-mono text-sage/60">
                  <svg class="w-3.5 h-3.5 text-copper/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  <span>Presentation Recording Link (Pending)</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Flexible Note -->
      <div class="mt-12 p-4 rounded-xl bg-midnight/60 border border-ivory/5 text-center">
        <p class="text-xs text-sage/70 font-light">
          Official recordings and slide decks for selected presentations will be made available here upon release by conference organizers.
        </p>
      </div>

    </div>
  </section>

  <!-- Academic & Clinical Inquiry CTA -->
  <section class="py-20 bg-midnight text-center">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ivory mb-4">
        Academic Collaboration &amp; Clinical Inquiries
      </h2>
      <p class="text-sage text-sm sm:text-base font-light mb-8 leading-relaxed">
        For academic partnerships, research inquiries, or clinical consultations with Dr. Sylvia Shitsama, contact our clinic desk in Nairobi.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href="https://wa.me/254110090116?text=Hello%20Dr.%20Sylvia%20Shitsama%2C%20I%20have%20an%20academic%20or%20clinical%20enquiry." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-primary text-sm inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Clinic
        </a>
        <a href="mailto:info@drsylviashitsama.com" class="btn-ghost text-sm inline-flex items-center gap-2">
          Email: info@drsylviashitsama.com
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
