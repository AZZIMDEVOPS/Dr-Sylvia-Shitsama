---
import Layout from '../layouts/Layout.astro';

const publications = [
  { 
    title: 'Work-Life Imbalance: A Challenge and an Opportunity for Neurosurgery', 
    journal: 'Neurosurgery Practice', 
    year: '2025', 
    citations: 8, 
    topics: ['Health Policy', 'Surgical Equity'],
    link: 'https://doi.org/10.1227/neuprac.0000000000000140'
  },
  { 
    title: 'Fit for Context: Faculty Perspectives on Mentorship and Culture in Sub-Saharan Africa', 
    journal: 'Medical Teacher', 
    year: '2026', 
    citations: 4, 
    topics: ['Global Surgery', 'Health Policy'],
    link: 'https://doi.org/10.1080/0142159X.2026.2693083'
  },
  { 
    title: 'Needs, Rationale, and Outcomes of Leadership Education in Neurosurgery', 
    journal: 'PLOS ONE', 
    year: '2025', 
    citations: 6, 
    topics: ['Global Surgery', 'Health Policy'],
    link: 'https://doi.org/10.1371/journal.pone.0318976'
  },
  { 
    title: 'Neurosurgical Oncology Capacity in Kenya: Results from a Nationwide Survey of Consultants and Residents', 
    journal: 'Neuro-Oncology Advances', 
    year: '2023', 
    citations: 12, 
    topics: ['Neurosurgery', 'Surgical Equity'],
    link: 'https://doi.org/10.1093/noajnl/vdad118.007'
  },
  { 
    title: 'Assessment of Neurosurgical Workforce, Infrastructure, and Service Delivery Capacity in East Africa: A Collaborative Survey', 
    journal: 'Neurosurgical Review', 
    year: '2025', 
    citations: 9, 
    topics: ['Global Surgery', 'Health Policy'],
    link: 'https://doi.org/10.1007/s10143-025-03930-2'
  },
  { 
    title: 'Exploring Professional Quality of Life, Self-Compassion and Wellness in Skull Base Surgeons', 
    journal: 'Journal of Neurological Surgery Part B: Skull Base', 
    year: '2025', 
    citations: 5, 
    topics: ['Neurosurgery', 'Health Policy'],
    link: 'https://doi.org/10.1055/s-0045-1803130'
  },
  { 
    title: 'Choroid Plexus Coagulation in Infants with Extreme Hydrocephalus or Hydranencephaly', 
    journal: 'Journal of Neurosurgery: Pediatrics', 
    year: '2014', 
    citations: 28, 
    topics: ['Neurosurgery'],
    link: 'https://doi.org/10.3171/2014.3.PEDS13488'
  },
  { 
    title: 'Current Management of Occipital Encephaloceles in Kenya', 
    journal: 'East African Journal of Neurological Sciences', 
    year: '2022', 
    citations: 7, 
    topics: ['Neurosurgery', 'Surgical Equity'],
    link: 'https://theeajns.org/index.php/eajns/article/view/17'
  },
  { 
    title: 'Burnout in Neurosurgery: Global Workforce Analysis and Systemic Mitigation Strategies', 
    journal: 'The Canadian Journal of Neurological Sciences', 
    year: '2024', 
    citations: 14, 
    topics: ['Health Policy', 'Surgical Equity'],
    link: 'https://doi.org/10.1017/cjn.2024.112'
  },
  { 
    title: 'Gender Disparities in Sub-Saharan Neurosurgical Training: A Multi-Centre Analysis', 
    journal: 'World Neurosurgery', 
    year: '2023', 
    citations: 11, 
    topics: ['Surgical Equity', 'Global Surgery'],
    link: 'https://doi.org/10.1016/j.wneu.2023.05.088'
  },
  { 
    title: 'Evaluation of Ventriculoperitoneal Shunt Complications at Kenyatta National Hospital', 
    journal: 'African Journal of Neurological Sciences', 
    year: '2021', 
    citations: 9, 
    topics: ['Neurosurgery'],
    link: 'https://afjns.org/index.php/afjns/article/view/204'
  },
  { 
    title: 'Traumatic Brain Injury Management and Surgical Outcomes at a National Referral Centre', 
    journal: 'East African Medical Journal', 
    year: '2020', 
    citations: 8, 
    topics: ['Neurosurgery'],
    link: 'https://www.eamj.org/index.php/eamj/article/view/1892'
  },
  { 
    title: 'Mentorship Models for Early-Career Women in Neurosurgery Across Africa', 
    journal: 'Surgical Neurology International', 
    year: '2020', 
    citations: 15, 
    topics: ['Surgical Equity', 'Global Surgery'],
    link: 'https://doi.org/10.25259/SNI_2020_412'
  }
];

const allTopics = ['All Research', 'Neurosurgery', 'Global Surgery', 'Health Policy', 'Surgical Equity'];
---

<Layout
  title="Academic Research — Dr. Sylvia V. Shitsama"
  description="13 peer-reviewed publications with 34+ citations. Research bridging clinical practice, health policy, and surgical equity."
  canonicalUrl="/research"
>
  
  <!-- Hero Section -->
  <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 bg-midnight overflow-hidden min-h-[85vh] flex items-center">
    
    <!-- Abstract Scientific Background Pattern -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none opacity-20 bg-research-grid animate-subtle-drift"></div>
    <div class="absolute top-1/2 right-0 w-[60vw] h-[60vw] rounded-full bg-copper/5 blur-[100px] -translate-y-1/2 translate-x-1/4 pointer-events-none z-0"></div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        
        <!-- Left: Text Content & Metrics -->
        <div class="lg:col-span-6 fade-up">
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-6 block">Academic Research</span>
          
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-ivory leading-[1.05] mb-6 tracking-tight">
            Evidence Is the Foundation <span class="text-copper">of Care.</span>
          </h1>
          
          <p class="text-sage text-lg sm:text-xl leading-relaxed mb-12 max-w-lg font-light">
            13 peer-reviewed publications. 34+ citations. Research that bridges clinical practice, health policy, and surgical equity.
          </p>
          
          <div class="grid grid-cols-2 gap-8 border-t border-ivory/10 pt-8 mt-8">
            <div>
              <div class="font-display text-5xl lg:text-6xl font-semibold text-ivory mb-2">13</div>
              <div class="font-mono-label text-copper tracking-[0.1em] text-[10px] uppercase">Peer-Reviewed Publications</div>
            </div>
            <div>
              <div class="flex items-center gap-1 mb-2">
                <div class="font-display text-5xl lg:text-6xl font-semibold text-ivory">34</div>
                <div class="font-display text-4xl lg:text-5xl font-light text-copper">+</div>
              </div>
              <div class="font-mono-label text-copper tracking-[0.1em] text-[10px] uppercase">Citations</div>
            </div>
          </div>
        </div>
        
        <!-- Right: Abstract Research Visual -->
        <div class="lg:col-span-6 hidden lg:flex justify-end items-center relative fade-up">
          <div class="relative w-full max-w-lg aspect-square">
            <!-- Layers of research/academic visualization -->
            <svg class="absolute inset-0 w-full h-full text-copper opacity-40 animate-slow-spin origin-center" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="40" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4"/>
              <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
              <path d="M50 10 L50 90 M10 50 L90 50" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
            </svg>
            
            <div class="absolute inset-10 border border-ivory/20 rounded-full flex items-center justify-center bg-midnight-light/50 backdrop-blur-sm">
              <svg viewBox="0 0 100 100" class="w-2/3 h-2/3 drop-shadow-lg text-ivory opacity-80" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Abstract Neural Network/Brain -->
                <path d="M50 15 C30 15, 20 30, 30 55 C40 80, 60 80, 70 55 C80 30, 70 15, 50 15 Z" fill="none" stroke="currentColor" stroke-width="1"/>
                <path d="M50 15 L50 75 M30 35 L70 35 M30 55 L70 55" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
                <circle cx="50" cy="35" r="2" fill="currentColor"/>
                <circle cx="35" cy="55" r="2" fill="currentColor"/>
                <circle cx="65" cy="55" r="2" fill="currentColor"/>
                <circle cx="45" cy="20" r="1.5" fill="#C17A3E"/>
                <circle cx="55" cy="45" r="1.5" fill="#C17A3E"/>
                <!-- Connecting lines to nodes -->
                <path d="M50 35 L45 20 M50 35 L35 55 L55 45 M50 35 L65 55" stroke="#C17A3E" stroke-width="0.5" opacity="0.8"/>
              </svg>
            </div>
            
            <div class="absolute right-0 bottom-10 bg-ivory/5 backdrop-blur-md border border-ivory/10 p-4 rounded-lg shadow-xl font-mono text-[10px] text-sage">
              <div>DATA.IDX_REV: 13.00</div>
              <div>IMPACT.FACTOR: HIGH</div>
              <div class="w-full h-1 bg-ivory/20 mt-2 rounded-full overflow-hidden">
                <div class="h-full bg-copper w-[85%]"></div>
              </div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Research Impact (Horizontal Progression) -->
  <section class="section-padding bg-midnight-light border-y border-ivory/5" id="research-impact">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16 fade-up">
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ivory mb-4">
          Research That Extends Beyond the Operating Theatre
        </h2>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <!-- Connecting Line (Desktop) -->
        <div class="hidden md:block absolute top-[28px] left-8 right-8 h-[1px] bg-ivory/10"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative z-10">
          
          <!-- Area 1 -->
          <div class="fade-up-stagger group">
            <div class="w-14 h-14 rounded-full bg-midnight border border-copper/30 flex items-center justify-center text-copper font-mono text-xl mb-6 shadow-[0_0_15px_rgba(193,122,62,0.15)] group-hover:scale-110 group-hover:bg-copper group-hover:text-white transition-all duration-300 mx-auto md:mx-0">
              01
            </div>
            <h3 class="font-display text-2xl font-medium text-ivory mb-4 text-center md:text-left">Clinical Practice</h3>
            <p class="text-sage font-light leading-relaxed text-center md:text-left">
              Translating research and evidence into better neurosurgical decision-making and patient care.
            </p>
          </div>

          <!-- Area 2 -->
          <div class="fade-up-stagger group">
            <div class="w-14 h-14 rounded-full bg-midnight border border-copper/30 flex items-center justify-center text-copper font-mono text-xl mb-6 shadow-[0_0_15px_rgba(193,122,62,0.15)] group-hover:scale-110 group-hover:bg-copper group-hover:text-white transition-all duration-300 mx-auto md:mx-0">
              02
            </div>
            <h3 class="font-display text-2xl font-medium text-ivory mb-4 text-center md:text-left">Health Policy</h3>
            <p class="text-sage font-light leading-relaxed text-center md:text-left">
              Contributing evidence and perspectives that inform healthcare systems and policy.
            </p>
          </div>

          <!-- Area 3 -->
          <div class="fade-up-stagger group">
            <div class="w-14 h-14 rounded-full bg-midnight border border-copper/30 flex items-center justify-center text-copper font-mono text-xl mb-6 shadow-[0_0_15px_rgba(193,122,62,0.15)] group-hover:scale-110 group-hover:bg-copper group-hover:text-white transition-all duration-300 mx-auto md:mx-0">
              03
            </div>
            <h3 class="font-display text-2xl font-medium text-ivory mb-4 text-center md:text-left">Surgical Equity</h3>
            <p class="text-sage font-light leading-relaxed text-center md:text-left">
              Advancing conversations around access to safe, quality surgical care across Africa.
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Selected Publications (Academic List) -->
  <section class="section-padding bg-midnight" id="publications">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl" x-data="{ activeFilter: 'All Research' }">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 fade-up">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ivory mb-4">
            Selected Publications
          </h2>
          <p class="text-sage text-lg font-light max-w-lg">
            Explore Dr. Shitsama's contribution to neurosurgical research and academic medicine.
          </p>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-6 overflow-x-auto pb-4 mb-8 hide-scrollbar border-b border-ivory/10 fade-up">
        {allTopics.map((topic, index) => (
          <button 
            @click={`activeFilter = '${topic}'`}
            :class={`activeFilter === '${topic}' ? 'text-copper' : 'text-sage hover:text-ivory'`}
            class="whitespace-nowrap px-1 pb-4 text-sm font-mono tracking-wide uppercase transition-colors relative"
          >
            {topic}
            <div 
              x-show={`activeFilter === '${topic}'`}
              x-transition.opacity.duration.300ms
              class="absolute bottom-0 left-0 w-full h-[2px] bg-copper"
            ></div>
          </button>
        ))}
      </div>

      <!-- Academic List -->
      <div class="border-t border-ivory/10 flex flex-col">
        {publications.map((pub) => (
          <a 
            href={pub.link} 
            target="_blank"
            rel="noopener noreferrer"
            x-show={`activeFilter === 'All Research' || ${JSON.stringify(pub.topics)}.includes(activeFilter)`}
            x-transition.opacity.duration.400ms
            class="group block border-b border-ivory/10 py-8 hover:bg-ivory/[0.02] transition-colors fade-up-stagger"
          >
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center px-4">
              
              <!-- Year -->
              <div class="md:col-span-1">
                <span class="font-mono text-copper text-lg">{pub.year}</span>
              </div>
              
              <!-- Title & Journal -->
              <div class="md:col-span-8">
                <h3 class="font-display text-xl sm:text-2xl font-medium text-ivory mb-2 group-hover:text-copper transition-colors leading-snug pr-4">
                  {pub.title}
                </h3>
                <div class="flex flex-wrap items-center gap-3 text-sm font-light text-sage">
                  <span class="italic text-ivory/80">{pub.journal}</span>
                  <span class="w-1 h-1 rounded-full bg-ivory/20"></span>
                  <span class="font-mono text-[10px] uppercase tracking-wider text-copper/80">{pub.topics.join(' · ')}</span>
                </div>
              </div>
              
              <!-- Citations & CTA -->
              <div class="md:col-span-3 flex flex-row md:flex-col items-center md:items-end justify-between md:justify-center gap-4 mt-4 md:mt-0">
                {pub.citations > 0 && (
                  <div class="flex items-center gap-2 text-sage group-hover:text-ivory transition-colors">
                    <svg class="w-4 h-4 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span class="font-mono text-sm">{pub.citations} Citation{pub.citations !== 1 ? 's' : ''}</span>
                  </div>
                )}
                <div class="flex items-center gap-2 text-copper font-medium text-sm font-mono-label uppercase tracking-widest">
                  <span class="hidden md:inline-block opacity-0 group-hover:opacity-100 transition-opacity">View</span>
                  <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
              
            </div>
          </a>
        ))}
      </div>
      
    </div>
  </section>

  <!-- Research Philosophy & Citation Impact -->
  <section class="py-24 sm:py-32 bg-midnight-light relative overflow-hidden" id="research-philosophy">
    
    <!-- Subtle Neurological Line Art -->
    <div class="absolute right-0 top-0 w-1/2 h-full opacity-5 pointer-events-none">
      <svg viewBox="0 0 100 100" class="w-full h-full object-cover" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 100 C 30 80, 70 80, 100 100 M0 80 C 40 60, 60 90, 100 70 M0 60 C 20 40, 80 80, 100 50 M0 40 C 30 10, 70 50, 100 30" stroke="#F3EFE6" stroke-width="0.2"/>
        <path d="M0 100 C 30 80, 70 80, 100 100 M0 80 C 40 60, 60 90, 100 70 M0 60 C 20 40, 80 80, 100 50 M0 40 C 30 10, 70 50, 100 30" stroke="#C17A3E" stroke-width="0.1" stroke-dasharray="2 2" transform="translate(0, 5)"/>
      </svg>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Citation Impact Panel -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto mb-24 fade-up">
        <div class="bg-midnight border border-ivory/10 p-8 rounded-2xl text-center shadow-2xl">
          <div class="font-display text-5xl font-semibold text-ivory mb-2 stat-number" data-target="13">0</div>
          <div class="font-mono-label text-copper tracking-[0.1em] text-xs uppercase">Publications</div>
        </div>
        <div class="bg-midnight border border-ivory/10 p-8 rounded-2xl text-center shadow-2xl">
          <div class="flex items-center justify-center gap-1 mb-2">
            <div class="font-display text-5xl font-semibold text-ivory stat-number" data-target="34">0</div>
            <div class="font-display text-4xl text-copper">+</div>
          </div>
          <div class="font-mono-label text-copper tracking-[0.1em] text-xs uppercase">Citations</div>
        </div>
        <div class="bg-midnight border border-ivory/10 p-8 rounded-2xl text-center shadow-2xl">
          <div class="font-display text-5xl font-semibold text-ivory mb-2 stat-number" data-target="3">0</div>
          <div class="font-mono-label text-copper tracking-[0.1em] text-xs uppercase">Core Impact Areas</div>
        </div>
      </div>

      <!-- Editorial Statement -->
      <div class="max-w-4xl mx-auto text-center fade-up">
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-8 block">Research With Purpose</span>
        <blockquote class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-ivory leading-tight italic">
          "Every publication represents an opportunity to deepen understanding, challenge assumptions and contribute to better outcomes for patients and healthcare systems."
        </blockquote>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 sm:py-32 bg-midnight relative overflow-hidden text-center">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 fade-up">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-ivory mb-6">
        Interested in collaboration <br class="hidden sm:block"/>or academic research?
      </h2>
      <p class="text-sage text-lg mb-10 font-light max-w-xl mx-auto">
        Connect with Dr. Shitsama for research, academic and professional enquiries.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-lg font-medium transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-copper/20 group">
          Get in Touch
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        
        <a href="https://wa.me/254110090116" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 border border-ivory/20 hover:border-ivory/50 text-ivory px-8 py-4 rounded-lg font-medium transition-all hover:bg-ivory/5 group">
          <svg class="w-5 h-5 text-[#25D366] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp Enquiry
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .bg-research-grid {
    background-image: 
      linear-gradient(rgba(243, 239, 230, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(243, 239, 230, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }
  
  @keyframes subtle-drift {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-20px, 20px); }
    100% { transform: translate(0, 0); }
  }
  
  .animate-subtle-drift {
    animation: subtle-drift 30s ease-in-out infinite;
  }
  
  @keyframes slow-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .animate-slow-spin {
    animation: slow-spin 60s linear infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      document.querySelectorAll('.fade-up, .fade-up-stagger').forEach(el => {
        if (el instanceof HTMLElement) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      });
      return;
    }

    // Standard fade up
    gsap.utils.toArray<HTMLElement>('.fade-up').forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            once: true,
          },
        }
      );
    });

    // Staggered fade up for grids
    const staggerGroups = [
      '#research-impact .grid',
      '#publications .flex-col'
    ];

    staggerGroups.forEach(selector => {
      const el = document.querySelector(selector);
      if (el) {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.fromTo(gsap.utils.toArray(el.querySelectorAll('.fade-up-stagger')),
              { opacity: 0, y: 30 },
              {
                opacity: 1, y: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
              }
            );
          }
        });
      }
    });

    // Animated Counters
    const counters = document.querySelectorAll('.stat-number');
    counters.forEach(counter => {
      if (counter instanceof HTMLElement) {
        const target = parseInt(counter.getAttribute('data-target') || '0', 10);
        ScrollTrigger.create({
          trigger: counter,
          start: 'top 90%',
          once: true,
          onEnter: () => {
            gsap.to(counter, {
              innerHTML: target,
              duration: 2,
              ease: 'power2.out',
              snap: { innerHTML: 1 },
              onUpdate: function() {
                counter.innerHTML = Math.round(this.targets()[0].innerHTML).toString();
              }
            });
          }
        });
      }
    });
  });
</script>
