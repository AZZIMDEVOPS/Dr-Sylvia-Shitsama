---
// expertise.astro
// Topic-based neurosurgical expertise page across 6 primary practice areas
// Enhanced with interactive scroll animations, dynamic active spy navigation, and clinical timeline beam

import Layout from '../layouts/Layout.astro';

interface SpecialtyTopic {
  id: string;
  slug: string;
  title: string;
  shortTitle: string;
  category: string;
  intro: string;
  clinicalScope: string[];
  imaging: {
    src: string;
    alt: string;
    caption: string;
  };
  patientFaq: {
    question: string;
    answer: string;
  }[];
}

const specialties: SpecialtyTopic[] = [
  {
    id: '01',
    slug: 'brain-trauma',
    title: 'Brain Trauma',
    shortTitle: 'Brain Trauma',
    category: 'Neurotrauma & Emergency Triage',
    intro: 'Comprehensive clinical evaluation and urgent neurosurgical intervention for acute head injuries, traumatic brain injury (TBI), cranial fractures, and intracranial bleeding resulting from road traffic accidents, falls, or occupational injuries.',
    clinicalScope: [
      'Acute Epidural & Subdural Hematoma Evacuation',
      'Decompressive Craniectomy for Refractory Intracranial Pressure',
      'Depressed & Comminuted Skull Fracture Elevation',
      'Cranioplasty & Post-Traumatic Cranial Reconstruction',
      'Post-Concussion Assessment & Monitoring',
    ],
    imaging: {
      src: '/images/services/head_injury_trauma_1.jpg',
      alt: 'Clinical assessment of acute head trauma',
      caption: 'Emergency neurotrauma triage and surgical intervention protocol.',
    },
    patientFaq: [
      {
        question: 'When is surgical intervention required following a head injury?',
        answer: 'Surgery is indicated when urgent CT neuroimaging demonstrates significant intracranial hemorrhage (such as epidural or acute subdural hematoma) exerting mass effect on the brain, or severely depressed skull fractures.',
      },
      {
        question: 'What initial investigations are essential?',
        answer: 'A non-contrast brain CT scan is the urgent gold-standard examination to rule out bleeding, fractures, or midline shift.',
      },
    ],
  },
  {
    id: '02',
    slug: 'brain-tumors',
    title: 'Brain Tumors',
    shortTitle: 'Brain Tumors',
    category: 'Cranial Surgery & Neuro-Oncology',
    intro: 'Specialist microsurgical management of benign and malignant brain tumours. Clinical practice prioritizes maximal safe tumour resection while diligently preserving neurological function and speech/motor pathways.',
    clinicalScope: [
      'Gliomas, Astrocytomas & Glioblastoma Multiforme (GBM)',
      'Meningiomas (Convexity, Parasagittal & Skull Base)',
      'Pituitary Adenomas & Sellar Lesions',
      'Metastatic Brain Lesions',
      'Intraventricular Tumours & Colloid Cysts',
    ],
    imaging: {
      src: '/images/dr-sylvia-neurosurgery-theatre.jpg',
      alt: 'Dr. Sylvia Shitsama performing microsurgical cranial surgery',
      caption: 'Microsurgical cranial tumour resection under surgical loupes & illumination.',
    },
    patientFaq: [
      {
        question: 'What symptoms suggest a brain tumor evaluation is needed?',
        answer: 'Persistent new-onset headaches (especially waking headaches accompanied by morning nausea/vomiting), new seizures in adults, progressive focal weakness, vision changes, or cognitive/personality changes.',
      },
      {
        question: 'What neuroimaging is required prior to consultation?',
        answer: 'A contrast-enhanced Brain MRI (Magnetic Resonance Imaging) is typically the most definitive diagnostic scan for detailed tumour characterisation and surgical planning.',
      },
    ],
  },
  {
    id: '03',
    slug: 'spine',
    title: 'Spine',
    shortTitle: 'Spine',
    category: 'Spinal Surgery & Reconstruction',
    intro: 'Evaluation and surgical care for conditions affecting the cervical, thoracic, and lumbar spine. Treatment follows an evidence-based pathway, ensuring conservative management is exhausted before considering surgical decompression or stabilization.',
    clinicalScope: [
      'Cervical & Lumbar Disc Herniation (Sciatica / Radiculopathy)',
      'Lumbar Spinal Stenosis & Neurogenic Claudication',
      'Degenerative Spondylolisthesis & Vertebral Instability',
      'Spinal Cord Decompression & Microdiscectomy',
      'Spinal Trauma, Fractures & Instrument-Assisted Fusion',
    ],
    imaging: {
      src: '/images/services/spine_surgery.jpg',
      alt: 'Spine surgery in operating theatre',
      caption: 'Precision spinal decompression and nerve root preservation.',
    },
    patientFaq: [
      {
        question: 'When should someone consider spine surgery?',
        answer: 'Surgery is typically considered when severe nerve compression causes progressive weakness (e.g., foot drop), intractable pain unresponsive to conservative medical therapy, or signs of spinal cord compression (myelopathy / cauda equina syndrome).',
      },
      {
        question: 'What scan is best for assessing back or neck pain radiating to the legs or arms?',
        answer: 'An MRI of the affected spinal segment (Cervical, Thoracic, or Lumbo-Sacral) provides the highest resolution imaging of spinal discs, nerve roots, and the spinal cord.',
      },
    ],
  },
  {
    id: '04',
    slug: 'hydrocephalus',
    title: 'Hydrocephalus',
    shortTitle: 'Hydrocephalus',
    category: 'CSF Circulation & Diversion',
    intro: 'Expert diagnosis, surgical management, and long-term surveillance of hydrocephalus across all age groups, including infants, children, and adults with Normal Pressure Hydrocephalus (NPH).',
    clinicalScope: [
      'Ventriculoperitoneal (VP) Shunt Insertion & Revision',
      'Endoscopic Third Ventriculostomy (ETV)',
      'Normal Pressure Hydrocephalus (NPH) Evaluation',
      'Congenital Aqueductal Stenosis',
      'Post-Meningitic & Post-Hemorrhagic Hydrocephalus',
    ],
    imaging: {
      src: '/images/services/hydrocephalus_patient.jpg',
      alt: 'Clinical assessment and cranial examination for hydrocephalus',
      caption: 'Clinical monitoring and long-term care management for hydrocephalus.',
    },
    patientFaq: [
      {
        question: 'What is the difference between a VP Shunt and ETV?',
        answer: 'A VP Shunt uses a flexible tube with a regulating valve to divert excess cerebrospinal fluid from the brain to the abdomen. ETV is a minimally invasive endoscopic procedure that creates a small opening in the floor of the third ventricle, bypassing blockages without an implant when anatomy permits.',
      },
      {
        question: 'What are the classic symptoms of Normal Pressure Hydrocephalus (NPH) in adults?',
        answer: 'The classic triad involves progressive gait disturbance (shuffling walk), mild cognitive impairment or memory decline, and urinary urgency or incontinence.',
      },
    ],
  },
  {
    id: '05',
    slug: 'congenital-conditions',
    title: 'Congenital Conditions',
    shortTitle: 'Congenital Conditions',
    category: 'Neural Tube & Structural Malformations',
    intro: 'Specialist surgical repair and multidisciplinary coordination for congenital malformations of the nervous system, addressing structural anomalies from the neonatal period through childhood and adult life.',
    clinicalScope: [
      'Spina Bifida (Myelomeningocele & Meningocele Closure)',
      'Encephaloceles (Occipital & Sincipital)',
      'Tethered Cord Syndrome & Surgical Release',
      'Chiari Malformations (Type I Decompression)',
      'Dermal Sinus Tracts & Spinal Dysraphism',
    ],
    imaging: {
      src: '/images/services/delicate_surgery.jpg',
      alt: 'Delicate microsurgery for congenital neural conditions',
      caption: 'Delicate neural reconstruction under operating microscope magnification.',
    },
    patientFaq: [
      {
        question: 'Why is early closure of myelomeningocele critical in neonates?',
        answer: 'Prompt surgical repair within the first 24 to 48 hours after birth protects exposed neural tissue from infection (meningitis) and preserves existing neurological function.',
      },
      {
        question: 'What are the signs of tethered cord syndrome?',
        answer: 'Signs may include cutaneous markers along the spine (such as dimples, tufts of hair, or lipomas), progressive foot deformities, asymmetrical lower limb weakness, or bladder dysfunction.',
      },
    ],
  },
  {
    id: '06',
    slug: 'pediatric-neurosurgery',
    title: 'Pediatric Neurosurgery',
    shortTitle: 'Pediatric Neurosurgery',
    category: 'Pediatric Specialist Neurosurgery',
    intro: 'Gentle, compassionate, highly specialized neurosurgical care tailored specifically to infants, young children, and adolescents, working closely with pediatricians, parents, and rehabilitative teams.',
    clinicalScope: [
      'Pediatric Cranial & Spinal Tumours',
      'Craniosynostosis & Cranial Vault Remodeling',
      'Infant Head Shape Abnormality Assessment',
      'Pediatric Neurotrauma & Accidental Fall Injuries',
      'Arachnoid Cysts & Congenital Ventricular Cysts',
    ],
    imaging: {
      src: '/images/services/paediatric_neurosurgery_1.jpg',
      alt: 'Pediatric neurosurgical consultation and gentle clinical examination',
      caption: 'Child-friendly consultation environment supporting young patients and families.',
    },
    patientFaq: [
      {
        question: 'How is a pediatric neurosurgical consultation conducted?',
        answer: 'Consultations are conducted in an unhurried, reassuring environment where Dr. Shitsama evaluates the child, thoroughly reviews all imaging, and answers parents’ questions in clear, accessible language.',
      },
      {
        question: 'Can parents stay with their child during clinical assessments?',
        answer: 'Yes, parents are encouraged to be present at every stage of the consultation to ensure comfort and clarity for the entire family.',
      },
    ],
  },
];
---

<Layout
  title="Clinical Expertise — Dr. Sylvia Shitsama | Sage Brain & Spine Clinic"
  description="Explore the six core areas of neurosurgical practice led by Dr. Sylvia Shitsama in Nairobi: Brain Trauma, Brain Tumors, Spine, Hydrocephalus, Congenital Conditions, and Pediatric Neurosurgery."
  canonicalUrl="/expertise"
>
  <!-- Global Top Scroll Progress Beam -->
  <div 
    id="expertise-scroll-progress" 
    class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-copper via-gold to-copper z-50 transition-all duration-75 ease-out shadow-[0_0_10px_rgba(193,122,62,0.8)] pointer-events-none"
    style="width: 0%;"
    aria-hidden="true"
  ></div>

  <!-- Page Header with Ambient Neural Glows -->
  <section class="pt-32 pb-16 bg-midnight relative border-b border-ivory/10 overflow-hidden">
    <!-- Ambient Floating Orbs -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div id="expertise-glow-1" class="absolute top-1/4 right-1/4 w-[450px] h-[450px] bg-copper/10 rounded-full blur-[140px] transition-transform duration-700"></div>
      <div id="expertise-glow-2" class="absolute -bottom-20 left-10 w-[380px] h-[380px] bg-gold/5 rounded-full blur-[120px] transition-transform duration-700"></div>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-[2px] bg-copper"></span>
          <span class="font-mono-label text-copper uppercase tracking-[0.2em] text-xs">Sage Brain &amp; Spine Clinic</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory tracking-tight mb-6">
          Clinical Expertise
        </h1>
        <p class="text-sage text-lg sm:text-xl font-light leading-relaxed mb-6">
          Dr. Sylvia Shitsama brings more than two decades of specialist medical experience to consultations and surgical interventions across six primary disciplines.
        </p>
        
        <!-- Physical Location Clarity -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-lg bg-midnight-light border border-ivory/10 text-xs font-mono text-ivory">
          <svg class="w-4 h-4 text-copper shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
          <span>Clinic Location: KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Topic-Based Quick Navigation Bar with Dynamic Scroll Spy Indicator -->
  <nav id="expertise-sticky-nav" class="sticky top-18 z-40 bg-midnight/95 backdrop-blur-md border-b border-ivory/10 shadow-lg" aria-label="Expertise topic navigation">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <div id="nav-pills-container" class="flex items-center gap-2 sm:gap-3 overflow-x-auto py-3.5 hide-scrollbar scroll-smooth">
        <span class="text-xs font-mono text-copper uppercase tracking-wider shrink-0 hidden md:inline-block mr-2">Specialties:</span>
        {specialties.map((item, idx) => (
          <a
            id={`nav-pill-${item.slug}`}
            href={`#${item.slug}`}
            data-target={item.slug}
            class="nav-topic-pill px-3.5 py-1.5 rounded-full text-xs font-medium whitespace-nowrap bg-midnight-light border border-ivory/10 text-ivory/80 hover:border-copper/60 hover:text-white transition-all duration-200 flex items-center gap-1.5"
          >
            <span class="text-[10px] font-mono opacity-60">0{idx + 1}</span>
            <span>{item.shortTitle}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- 6 Clinical Specialty Detailed Sections with Connecting Spine Guide -->
  <div class="divide-y divide-ivory/5 bg-midnight relative">

    {specialties.map((item, index) => (
      <section 
        id={item.slug} 
        class="expertise-specialty-section py-20 sm:py-28 relative scroll-mt-32 overflow-hidden"
        data-specialty-id={item.slug}
      >
        <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

            <!-- Left: Clinical Details & Scope (7 cols) -->
            <div class="lg:col-span-7 specialty-content-col opacity-0 translate-y-8 transition-all duration-700 ease-out">
              
              <!-- Category Pill & Index -->
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-copper/15 border border-copper/30 font-mono text-xs text-copper tracking-wider uppercase font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-copper animate-pulse"></span>
                  0{index + 1} &middot; {item.category}
                </span>
              </div>
              
              <h2 class="font-display text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-ivory mb-6 tracking-tight leading-tight">
                {item.title}
              </h2>

              <p class="text-sage text-base sm:text-lg font-light leading-relaxed mb-8">
                {item.intro}
              </p>

              <!-- Clinical Scope Container with Staggered Scope Bullets -->
              <div class="bg-midnight-light border border-ivory/10 rounded-2xl p-6 sm:p-8 mb-8 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-copper/5 rounded-full blur-2xl group-hover:bg-copper/10 transition-colors pointer-events-none"></div>

                <h3 class="font-display text-lg font-semibold text-ivory mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Clinical &amp; Surgical Scope
                </h3>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {item.clinicalScope.map((scope) => (
                    <li class="text-xs sm:text-sm text-sage flex items-start gap-2.5 p-2 rounded-lg hover:bg-surface/30 transition-colors">
                      <span class="w-2 h-2 rounded-full bg-copper mt-1.5 shrink-0 shadow-[0_0_6px_rgba(193,122,62,0.8)]"></span>
                      <span>{scope}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Patient FAQ / Common Questions with Hover Elevation -->
              <div class="space-y-4 mb-8">
                <h3 class="text-xs font-mono uppercase tracking-widest text-sage flex items-center gap-2 mb-2">
                  <span class="w-3 h-[1px] bg-copper"></span>
                  Patient Guidance &amp; Common Queries
                </h3>
                {item.patientFaq.map((faq) => (
                  <div class="p-4 sm:p-5 rounded-xl bg-surface/50 border border-border-subtle hover:border-copper/40 hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                    <h4 class="text-sm font-medium text-ivory mb-2 flex items-start gap-2">
                      <span class="text-copper font-bold">Q:</span>
                      <span>{faq.question}</span>
                    </h4>
                    <p class="text-xs sm:text-[13px] text-sage font-light leading-relaxed pl-5">
                      {faq.answer}
                    </p>
                  </div>
                ))}
              </div>

              <!-- Consultation CTA Button -->
              <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <a 
                  href={`https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20regarding%20${encodeURIComponent(item.title)}.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-primary text-sm inline-flex items-center gap-2 shadow-lg shadow-copper/20 hover:shadow-copper/40 transition-all hover:-translate-y-0.5"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Book a Consultation
                </a>
                <span class="text-xs text-sage font-light">or call our desk on <strong>0110 090 116</strong></span>
              </div>
            </div>

            <!-- Right: Clinical Imaging / Scan Container with Subtle Parallax (5 cols) -->
            <div class="lg:col-span-5 specialty-media-col opacity-0 translate-y-12 transition-all duration-700 ease-out delay-150">
              <div class="rounded-2xl overflow-hidden border border-ivory/15 bg-midnight-light shadow-2xl group transition-all duration-500 hover:border-copper/40">
                <div class="relative aspect-[4/3] bg-midnight overflow-hidden">
                  <img 
                    src={item.imaging.src} 
                    alt={item.imaging.alt} 
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-midnight/90 via-midnight/20 to-transparent"></div>
                  
                  <div class="absolute top-3 left-3 bg-midnight/85 backdrop-blur-md px-3 py-1.5 rounded-full text-[10px] font-mono text-copper border border-copper/30 uppercase tracking-widest flex items-center gap-1.5 shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-copper animate-ping"></span>
                    Clinical Photography
                  </div>
                </div>
                <div class="p-4 sm:p-5 bg-midnight-light border-t border-ivory/10">
                  <p class="text-xs text-sage font-light leading-relaxed">
                    {item.imaging.caption}
                  </p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Bottom Conversion Section with Staggered Entrance -->
  <section id="expertise-bottom-cta" class="py-24 bg-midnight-light border-t border-ivory/10 text-center relative overflow-hidden">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl relative z-10">
      <div class="cta-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <span class="font-mono-label text-copper uppercase tracking-[0.2em] text-xs mb-3 block">Personalized Care</span>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-ivory mb-4">
          Discuss Your Care with Dr. Sylvia Shitsama
        </h2>
        <p class="text-sage text-base sm:text-lg mb-8 font-light leading-relaxed">
          Consultations take place at KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi. Inpatient surgical procedures are scheduled at affiliated accredited tertiary hospitals.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a 
            href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto btn-primary inline-flex items-center justify-center gap-2 shadow-lg shadow-copper/25 hover:shadow-copper/40"
          >
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Book a Consultation
          </a>
          <a href="/contact" class="w-full sm:w-auto btn-ghost inline-flex items-center justify-center">
            Clinic Details &amp; Directions
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Active Pill Highlight in Sticky Nav */
  .nav-topic-pill.active-nav-pill {
    background-color: #c17a3e !important;
    border-color: #e6a86c !important;
    color: #ffffff !important;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(193, 122, 62, 0.45);
    transform: scale(1.04);
  }

  /* Reveal Animations */
  .is-revealed {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
  }
</style>

<script>
  function initExpertiseScrollAnimations() {
    // 1. Top Reading Progress Beam
    const progressBar = document.getElementById('expertise-scroll-progress');
    function updateProgressBar() {
      if (!progressBar) return;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrolled = (window.scrollY / (docHeight || 1)) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
    }
    window.addEventListener('scroll', updateProgressBar, { passive: true });
    updateProgressBar();

    // 2. Parallax Drift on Ambient Orbs
    const orb1 = document.getElementById('expertise-glow-1');
    const orb2 = document.getElementById('expertise-glow-2');
    function handleOrbParallax() {
      const scrollY = window.scrollY;
      if (scrollY < 800) {
        if (orb1) orb1.style.transform = `translate(${scrollY * -0.06}px, ${scrollY * 0.04}px)`;
        if (orb2) orb2.style.transform = `translate(${scrollY * 0.05}px, ${scrollY * -0.04}px)`;
      }
    }
    window.addEventListener('scroll', handleOrbParallax, { passive: true });

    // 3. Scroll Reveal Observer for Specialty Cards
    const revealTargets = document.querySelectorAll('.specialty-content-col, .specialty-media-col, .cta-reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    }, {
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.15
    });

    revealTargets.forEach(el => observer.observe(el));

    // 4. Dynamic Sticky Navigation Active Scroll Spy with Auto-Scroll Center
    const specialtySections = document.querySelectorAll<HTMLElement>('.expertise-specialty-section');
    const navPills = document.querySelectorAll<HTMLElement>('.nav-topic-pill');
    const pillsContainer = document.getElementById('nav-pills-container');

    function updateActiveNavPill() {
      const scrollPos = window.scrollY + 200; // Trigger threshold
      let currentSectionId = '';

      specialtySections.forEach(section => {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentSectionId = section.getAttribute('id') || '';
        }
      });

      // Default to first section if near top
      if (!currentSectionId && specialtySections.length > 0 && window.scrollY < specialtySections[0].offsetTop) {
        currentSectionId = specialtySections[0].getAttribute('id') || '';
      }

      navPills.forEach(pill => {
        const target = pill.getAttribute('data-target');
        if (target === currentSectionId) {
          if (!pill.classList.contains('active-nav-pill')) {
            pill.classList.add('active-nav-pill');
            // Auto-center active pill in horizontal scrollbar
            if (pillsContainer) {
              const pillLeft = pill.offsetLeft;
              const pillWidth = pill.offsetWidth;
              const containerWidth = pillsContainer.offsetWidth;
              pillsContainer.scrollTo({
                left: pillLeft - (containerWidth / 2) + (pillWidth / 2),
                behavior: 'smooth'
              });
            }
          }
        } else {
          pill.classList.remove('active-nav-pill');
        }
      });
    }

    window.addEventListener('scroll', updateActiveNavPill, { passive: true });
    updateActiveNavPill();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExpertiseScrollAnimations);
  } else {
    initExpertiseScrollAnimations();
  }
</script>
