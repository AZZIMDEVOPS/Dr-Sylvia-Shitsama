---
// expertise.astro
// World-Class Interactive Anatomy & Expertise Experience

import Layout from '../layouts/Layout.astro';

const categories = [
  {
    id: '01',
    title: 'Brain',
    name: 'Brain & Cranial Neurosurgery',
    anatomy: 'brain',
    desc: 'Advanced surgical care involving complex conditions affecting the brain and surrounding structures.',
    conditions: [
      { name: 'Brain Tumours', desc: 'Surgical management of benign and malignant neoplasms.' },
      { name: 'Vascular Lesions', desc: 'Treatment of aneurysms and arteriovenous malformations.' },
      { name: 'Cranial Nerve Disorders', desc: 'Microvascular decompression for trigeminal neuralgia.' }
    ]
  },
  {
    id: '02',
    title: 'Spine',
    name: 'Spinal Surgery',
    anatomy: 'spine',
    desc: 'Surgical and conservative management of degenerative spinal conditions, restoring mobility and relieving pain.',
    conditions: [
      { name: 'Degenerative Disc Disease', desc: 'Microdiscectomy and spinal fusion techniques.' },
      { name: 'Spinal Stenosis', desc: 'Decompression surgery to relieve nerve pressure.' },
      { name: 'Spondylolisthesis', desc: 'Stabilisation of vertebral slippage.' }
    ]
  },
  {
    id: '03',
    title: 'Hydrocephalus',
    name: 'Hydrocephalus Management',
    anatomy: 'brain',
    desc: 'Expert management of hydrocephalus in both paediatric and adult patients, focusing on optimal fluid diversion.',
    conditions: [
      { name: 'Paediatric Hydrocephalus', desc: 'Early intervention and shunt placement.' },
      { name: 'Normal Pressure Hydrocephalus', desc: 'Assessment and treatment in older adults.' },
      { name: 'ETV', desc: 'Endoscopic third ventriculostomy as an alternative to shunts.' }
    ]
  },
  {
    id: '04',
    title: 'Trauma',
    name: 'Head & Spine Trauma',
    anatomy: 'brain',
    desc: 'Emergency and elective neurosurgical intervention for traumatic injuries resulting from accidents and falls.',
    conditions: [
      { name: 'Traumatic Brain Injury', desc: 'Decompressive craniectomy and hematoma evacuation.' },
      { name: 'Spinal Fractures', desc: 'Spinal stabilisation and cord decompression.' },
      { name: 'Cranial Reconstruction', desc: 'Cranioplasty following severe trauma.' }
    ]
  },
  {
    id: '05',
    title: 'Paediatric',
    name: 'Paediatric Neurosurgery',
    anatomy: 'spine',
    desc: 'Specialist care for neural tube defects and congenital neurological conditions.',
    conditions: [
      { name: 'Spina Bifida', desc: 'Surgical repair of myelomeningocele.' },
      { name: 'Tethered Cord Syndrome', desc: 'Surgical release to prevent neurological decline.' },
      { name: 'Congenital Malformations', desc: 'Management of Chiari malformations.' }
    ]
  },
  {
    id: '06',
    title: 'Complex',
    name: 'Neuro-Oncology',
    anatomy: 'brain',
    desc: 'Comprehensive neuro-oncology care from diagnosis through surgical treatment and post-operative management.',
    conditions: [
      { name: 'Gliomas & Glioblastomas', desc: 'Maximal safe resection using advanced imaging.' },
      { name: 'Meningiomas', desc: 'Microsurgical removal of tumours arising from the meninges.' },
      { name: 'Spinal Cord Tumours', desc: 'Delicate resection of intramedullary and extramedullary tumours.' }
    ]
  }
];

---

<Layout
  title="Expertise | Precision in Neurosurgery — Dr. Sylvia V. Shitsama"
  description="Explore Dr. Sylvia V. Shitsama's areas of neurosurgical expertise including brain tumours, spinal surgery, hydrocephalus, trauma, and complex neuro-oncology."
  canonicalUrl="/expertise"
>
  
  <!-- Cinematic Hero Section -->
  <section class="relative min-h-[90vh] bg-midnight overflow-hidden flex items-center pt-24 pb-12 select-none">
    
    <!-- Background Environment -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,_rgba(15,23,42,1)_0%,_rgba(5,10,20,1)_100%)]"></div>
      <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] bg-copper/5 rounded-full blur-[120px] mix-blend-screen"></div>
      <div class="absolute bottom-1/4 right-1/3 w-96 h-96 bg-gold/5 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 opacity-[0.02] bg-[url('/images/noise.png')] mix-blend-overlay"></div>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- Left: Typography & CTAs -->
        <div class="fade-up relative z-20">
          <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-6 block">Expertise</span>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-semibold text-ivory leading-[1.1] mb-6 tracking-tight">
            Precision in Neurosurgery.<br/>
            <span class="text-copper">Experience in Every Decision.</span>
          </h1>
          <p class="text-sage text-lg sm:text-xl font-light max-w-lg leading-relaxed mb-10">
            Specialist neurosurgical care spanning the brain, spine, trauma, hydrocephalus and complex neurological conditions.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
            <a href="/contact" class="inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-lg font-medium transition-all hover:-translate-y-1 shadow-lg hover:shadow-copper/20 group cursor-pointer">
              Book a Consultation
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <button onclick="document.getElementById('interactive-anatomy').scrollIntoView({behavior: 'smooth'})" class="inline-flex items-center justify-center gap-3 border border-ivory/20 hover:border-ivory/50 text-ivory px-8 py-4 rounded-lg font-medium transition-all hover:bg-ivory/5 group">
              Explore Expertise
              <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            </button>
          </div>
        </div>

        <!-- Right: 3D Hero Visual (Realistic Brain) -->
        <div class="hidden lg:flex justify-end items-center relative h-[600px] perspective-container hero-anatomy fade-up">
          <div class="relative w-full max-w-lg aspect-square transform-style-3d anatomy-rig animate-slow-spin">
            <!-- Render the realistic brain image on a 3D plane -->
            <img src="/images/brain.png" alt="3D Human Brain" class="absolute inset-0 w-full h-full object-cover rounded-full shadow-[0_0_80px_rgba(193,122,62,0.1)] transform-style-3d" style="transform: translateZ(50px);" />
            
            <!-- Atmospheric glow rings -->
            <div class="absolute inset-4 rounded-full border border-copper/20 transform-style-3d" style="transform: rotateX(60deg) rotateY(20deg) translateZ(-20px);"></div>
            <div class="absolute inset-8 rounded-full border border-gold/10 transform-style-3d" style="transform: rotateX(45deg) rotateY(-20deg) translateZ(-40px);"></div>
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Interactive Areas of Expertise System -->
  <section class="bg-midnight-light relative border-t border-ivory/5 py-24 sm:py-32" id="interactive-anatomy">
    
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center mb-16 fade-up">
      <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-4 block">Areas of Expertise</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-ivory">
        Specialist Care Across the Brain & Spine
      </h2>
    </div>

    <!-- Alpine.js Architecture for Interactive UI -->
    <div 
      class="container-custom mx-auto px-4 sm:px-6 lg:px-8"
      x-data="{ 
        activeCategory: '01',
        activeAnatomy: 'brain',
        getCategory() {
          return this.categories.find(c => c.id === this.activeCategory);
        },
        selectCategory(id) {
          this.activeCategory = id;
          this.activeAnatomy = this.getCategory().anatomy;
          // Update URL hash without jumping
          if (window.history.pushState) {
            window.history.pushState(null, null, '#' + this.getCategory().slug);
          }
        },
        init() {
          const hash = window.location.hash.substring(1);
          if (hash) {
            const matchedCat = this.categories.find(c => c.slug === hash);
            if (matchedCat) {
              this.activeCategory = matchedCat.id;
              this.activeAnatomy = matchedCat.anatomy;
            }
          }
        },
        categories: [
          { id: '01', slug: 'brain-tumours', title: 'Brain', name: 'Brain & Cranial Neurosurgery', anatomy: 'brain', desc: 'Advanced surgical care involving complex conditions affecting the brain and surrounding structures.', conditions: [{ name: 'Brain Tumours', desc: 'Surgical management of benign and malignant neoplasms.' }, { name: 'Vascular Lesions', desc: 'Treatment of aneurysms and arteriovenous malformations.' }, { name: 'Cranial Nerve Disorders', desc: 'Microvascular decompression for trigeminal neuralgia.' }] },
          { id: '02', slug: 'spinal-conditions', title: 'Spine', name: 'Spinal Surgery', anatomy: 'spine', desc: 'Surgical and conservative management of degenerative spinal conditions, restoring mobility and relieving pain.', conditions: [{ name: 'Degenerative Disc Disease', desc: 'Microdiscectomy and spinal fusion techniques.' }, { name: 'Spinal Stenosis', desc: 'Decompression surgery to relieve nerve pressure.' }, { name: 'Spondylolisthesis', desc: 'Stabilisation of vertebral slippage.' }] },
          { id: '03', slug: 'hydrocephalus', title: 'Hydrocephalus', name: 'Hydrocephalus Management', anatomy: 'hydrocephalus', desc: 'Expert management of hydrocephalus in both paediatric and adult patients, focusing on optimal fluid diversion.', conditions: [{ name: 'Paediatric Hydrocephalus', desc: 'Early intervention and shunt placement.' }, { name: 'Normal Pressure Hydrocephalus', desc: 'Assessment and treatment in older adults.' }, { name: 'ETV', desc: 'Endoscopic third ventriculostomy as an alternative to shunts.' }] },
          { id: '04', slug: 'head-injury-trauma', title: 'Trauma', name: 'Head & Spine Trauma', anatomy: 'head_injury', desc: 'Emergency and elective neurosurgical intervention for traumatic injuries resulting from accidents and falls.', conditions: [{ name: 'Traumatic Brain Injury', desc: 'Decompressive craniectomy and hematoma evacuation.' }, { name: 'Spinal Fractures', desc: 'Spinal stabilisation and cord decompression.' }, { name: 'Cranial Reconstruction', desc: 'Cranioplasty following severe trauma.' }] },
          { id: '05', slug: 'spina-bifida', title: 'Paediatric', name: 'Paediatric Neurosurgery', anatomy: 'spina_bifida', desc: 'Specialist care for neural tube defects and congenital neurological conditions.', conditions: [{ name: 'Spina Bifida', desc: 'Surgical repair of myelomeningocele.' }, { name: 'Tethered Cord Syndrome', desc: 'Surgical release to prevent neurological decline.' }, { name: 'Congenital Malformations', desc: 'Management of Chiari malformations.' }] },
          { id: '06', slug: 'neurological-oncology', title: 'Complex', name: 'Neuro-Oncology', anatomy: 'neuro_oncology', desc: 'Comprehensive neuro-oncology care from diagnosis through surgical treatment and post-operative management.', conditions: [{ name: 'Gliomas & Glioblastomas', desc: 'Maximal safe resection using advanced imaging.' }, { name: 'Meningiomas', desc: 'Microsurgical removal of tumours arising from the meninges.' }, { name: 'Spinal Cord Tumours', desc: 'Delicate resection of intramedullary and extramedullary tumours.' }] }
        ]
      }"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start fade-up">
        
        <!-- Left: Navigation Rail (Desktop) -->
        <div class="hidden lg:block lg:col-span-3 sticky top-32">
          <div class="space-y-2 border-l border-ivory/10 pl-6 relative">
            <!-- Active indicator line -->
            <div 
              class="absolute left-[-1px] w-[2px] bg-copper transition-all duration-300"
              :style="`top: ${(parseInt(activeCategory) - 1) * 3.5}rem; height: 3rem;`"
            ></div>
            
            <template x-for="cat in categories" :key="cat.id">
              <button 
                @click="selectCategory(cat.id)"
                class="w-full text-left h-12 flex items-center gap-4 group transition-colors"
              >
                <span class="font-mono text-xs tracking-widest transition-colors duration-300" :class="activeCategory === cat.id ? 'text-copper' : 'text-sage group-hover:text-ivory'" x-text="cat.id"></span>
                <span class="font-display text-lg font-medium transition-colors duration-300" :class="activeCategory === cat.id ? 'text-ivory' : 'text-sage group-hover:text-ivory'" x-text="cat.title"></span>
              </button>
            </template>
          </div>
        </div>

        <!-- Mobile Horizontal Navigation Rail -->
        <div class="lg:hidden col-span-1 overflow-x-auto pb-4 scrollbar-hide -mx-4 px-4">
          <div class="flex gap-4">
            <template x-for="cat in categories" :key="cat.id">
              <button 
                @click="selectCategory(cat.id)"
                class="whitespace-nowrap px-5 py-2.5 rounded-full border text-sm font-medium transition-all flex items-center gap-2"
                :class="activeCategory === cat.id ? 'bg-copper border-copper text-white' : 'bg-midnight border-ivory/10 text-sage hover:border-ivory/30'"
              >
                <span class="font-mono text-[10px] opacity-70" x-text="cat.id"></span>
                <span x-text="cat.title"></span>
              </button>
            </template>
          </div>
        </div>

        <!-- Center: Interactive 3D Anatomy Visualizer -->
        <div class="lg:col-span-5 relative bg-midnight rounded-3xl border border-ivory/5 shadow-2xl overflow-hidden aspect-square flex items-center justify-center perspective-container explorer-canvas">
          
          <!-- UI Guidance Hint -->
          <div class="absolute top-6 left-6 z-30 ui-hint opacity-50 transition-opacity duration-500 pointer-events-none">
            <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-copper uppercase bg-midnight/80 backdrop-blur px-3 py-1.5 rounded-full border border-copper/20">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
              Drag to explore anatomy
            </div>
          </div>

          <!-- The Anatomy Rig -->
          <div class="relative w-full h-full transform-style-3d cursor-grab active:cursor-grabbing interactive-rig">
            <template x-for="cat in categories" :key="cat.id">
              <div 
                class="absolute inset-0 flex items-center justify-center transition-all duration-1000 transform-style-3d pointer-events-none"
                :class="activeAnatomy === cat.anatomy ? 'opacity-100 scale-100' : 'opacity-0 scale-90 blur-sm'"
              >
                <img :src="`/images/medical/${cat.anatomy}.png`" :alt="`${cat.name} Visualization`" class="w-[85%] h-[85%] object-contain mix-blend-screen drop-shadow-[0_0_40px_rgba(193,122,62,0.15)] pointer-events-auto" style="transform: translateZ(20px);" />
              </div>
            </template>

          </div>
        </div>

        <!-- Right: Editorial Detail Panel -->
        <div class="lg:col-span-4 lg:pl-4">
          <div class="bg-midnight border border-copper/10 rounded-3xl p-8 lg:p-10 shadow-xl transition-all duration-500 h-full flex flex-col justify-between">
            
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xl text-copper opacity-50" x-text="getCategory().id"></span>
                <div class="w-8 h-px bg-copper/30"></div>
                <span class="font-mono-label text-[10px] tracking-widest uppercase text-copper" x-text="getCategory().title"></span>
              </div>
              
              <h3 class="font-display text-3xl sm:text-4xl font-semibold text-ivory mb-6 leading-tight" x-text="getCategory().name"></h3>
              <p class="text-sage text-base leading-relaxed font-light mb-10" x-text="getCategory().desc"></p>
              
              <div class="w-full h-px bg-ivory/5 mb-8"></div>
              
              <h4 class="font-display text-lg font-medium text-ivory mb-6">Conditions treated</h4>
              <ul class="space-y-6">
                <template x-for="(condition, index) in getCategory().conditions" :key="index">
                  <li class="group">
                    <div class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-copper mt-0.5 flex-shrink-0 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                      <div>
                        <h5 class="text-ivory font-medium mb-1 transition-colors group-hover:text-copper" x-text="condition.name"></h5>
                        <p class="text-sage text-sm font-light leading-relaxed" x-text="condition.desc"></p>
                      </div>
                    </div>
                  </li>
                </template>
              </ul>
            </div>
            
            <div class="pt-8 border-t border-ivory/5 mt-auto">
              <a href="/contact" class="inline-flex items-center gap-2 text-copper hover:text-ivory transition-colors font-mono uppercase tracking-widest text-xs font-semibold group">
                Learn More 
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Editorial Section: Why Specialist Care Matters -->
  <section class="py-24 bg-midnight relative overflow-hidden border-t border-ivory/5">
    <!-- Subtle Neurological Line Art Background -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.03] pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M 0 50 Q 20 40 40 50 T 100 30 M 0 60 Q 30 70 50 60 T 100 80 M 30 0 L 20 100 M 70 0 L 80 100" stroke="#F3EFE6" stroke-width="0.2" fill="none"/>
    </svg>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center fade-up">
      <span class="font-mono-label text-sage tracking-[0.2em] uppercase text-xs mb-8 block">Why Specialist Care Matters</span>
      <h3 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium text-ivory mb-10 max-w-4xl mx-auto leading-tight italic">
        "When the nervous system is involved, precision matters."
      </h3>
      <p class="text-sage text-lg sm:text-xl font-light leading-relaxed max-w-3xl mx-auto mb-16">
        The brain and spinal cord form the most complex system in the human body. Every patient requires meticulous assessment, highly individualised treatment planning, and surgical precision informed by deep experience.
      </p>
    </div>
  </section>

  <!-- Trust Metrics Strip -->
  <section class="py-16 bg-midnight-light border-y border-ivory/10">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 fade-up">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto text-center">
        <div>
          <div class="font-display text-5xl font-semibold text-ivory mb-2">20<span class="text-copper">+</span></div>
          <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">Years of Specialist<br/>Experience</div>
        </div>
        <div>
          <div class="font-display text-5xl font-semibold text-ivory mb-2">13</div>
          <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">Peer-Reviewed<br/>Publications</div>
        </div>
        <div>
          <div class="font-display text-5xl font-semibold text-ivory mb-2">34<span class="text-copper">+</span></div>
          <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">Citations</div>
        </div>
        <div class="flex flex-col items-center justify-center">
          <svg class="w-12 h-12 text-ivory mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">International<br/>Training</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 sm:py-32 bg-midnight relative overflow-hidden text-center">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(193,122,62,0.05)_0%,_transparent_70%)] pointer-events-none"></div>
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 fade-up">
      <h2 class="font-display text-4xl sm:text-5xl font-semibold text-ivory mb-6 tracking-tight">
        Your care deserves specialist expertise.
      </h2>
      <p class="text-sage text-lg mb-12 font-light max-w-xl mx-auto">
        Take the next step towards a consultation with Dr. Sylvia Shitsama.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-lg font-medium transition-all hover:-translate-y-1 shadow-lg hover:shadow-copper/20 group">
          Book a Consultation
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        
        <a href="https://wa.me/254110090116" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 border border-ivory/20 hover:border-[#25D366]/50 text-ivory px-8 py-4 rounded-lg font-medium transition-all hover:bg-[#25D366]/10 group">
          <svg class="w-5 h-5 text-[#25D366] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Enquiry
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .perspective-container {
    perspective: 1200px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  @keyframes slow-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-slow-spin {
    animation: slow-spin 60s linear infinite;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(ScrollTrigger, Draggable);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      document.querySelectorAll('.fade-up').forEach(el => {
        if (el instanceof HTMLElement) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }
      });
      return;
    }

    // Standard Fade Ups
    gsap.utils.toArray<HTMLElement>('.fade-up').forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            once: true,
          },
        }
      );
    });

    // 3D Interactive Rig (Drag to rotate)
    const explorerCanvas = document.querySelector('.explorer-canvas');
    const interactiveRig = document.querySelector('.interactive-rig');
    
    if (explorerCanvas && interactiveRig) {
      let currentRotationX = 0;
      let currentRotationY = 0;

      // Create proxy for GSAP Draggable
      const proxy = document.createElement('div');
      
      Draggable.create(proxy, {
        type: "x,y",
        trigger: explorerCanvas,
        inertia: true,
        onDragStart: () => {
          const uiHint = document.querySelector('.ui-hint');
          if (uiHint) uiHint.classList.add('opacity-0');
        },
        onDrag: function() {
          currentRotationY += this.deltaX * 0.5;
          currentRotationX -= this.deltaY * 0.5;
          
          // Clamp X rotation to prevent flipping upside down
          currentRotationX = Math.max(-45, Math.min(45, currentRotationX));

          gsap.set(interactiveRig, { 
            rotationY: currentRotationY,
            rotationX: currentRotationX
          });
        },
        onThrowUpdate: function() {
          currentRotationY += this.deltaX * 0.5;
          currentRotationX -= this.deltaY * 0.5;
          currentRotationX = Math.max(-45, Math.min(45, currentRotationX));
          
          gsap.set(interactiveRig, { 
            rotationY: currentRotationY,
            rotationX: currentRotationX
          });
        }
      });
      
      // Auto-reset rotation when not interacting
      explorerCanvas.addEventListener('mouseleave', () => {
        gsap.to(interactiveRig, { 
          rotationY: 0, 
          rotationX: 0, 
          duration: 1.5, 
          ease: 'power2.out' 
        });
        currentRotationX = 0;
        currentRotationY = 0;
      });
    }
  });
</script>
