---
import Layout from '../../layouts/Layout.astro';
import { insights, categories } from '../../data/insights';
import MedicalVisualization from '../../components/MedicalVisualization.astro';
import ArticleAuthor from '../../components/ArticleAuthor.astro';

const featuredArticle = insights[0];
const gridArticles = insights.slice(1);
---

<Layout
  title="Insights & Articles — Dr. Sylvia Shitsama"
  description="Evidence-based perspectives, patient education and neurosurgical insights from Dr. Sylvia Shitsama."
  canonicalUrl="/blog"
>
  <!-- 1. Editorial Hero -->
  <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 bg-bg-primary overflow-hidden min-h-[85vh] flex items-center border-b border-border-subtle" id="hero-section">
    <!-- Deep navy gradients & depth -->
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 z-0 flex items-center justify-center opacity-30 mix-blend-screen pointer-events-none" aria-hidden="true">
      <div class="w-[80vw] h-[80vw] max-w-4xl max-h-4xl bg-accent/5 rounded-full blur-[100px]"></div>
    </div>
    
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Typography -->
        <div class="lg:col-span-6 fade-up">
          <span class="font-mono-label text-accent tracking-[0.2em] uppercase mb-6 block flex items-center gap-2">
            <span class="w-2 h-2 bg-accent rounded-full"></span>
            Sage Brain & Spine Clinic
          </span>
          
          <h1 class="font-display font-bold text-text-primary leading-[1.05] mb-8" style="font-size: clamp(3rem, 6vw, 6rem);">
            Insights & <br class="hidden sm:block"/>Articles
          </h1>
          
          <p class="font-display italic text-text-secondary text-2xl sm:text-3xl lg:text-4xl leading-tight mb-8">
            Knowledge for Better<br />Brain & Spine Health.
          </p>

          <p class="text-text-muted text-lg font-light leading-relaxed max-w-md mb-10">
            Evidence-based perspectives, patient education and neurosurgical insights from Dr. Sylvia Shitsama.
          </p>
        </div>

        <!-- Right: 3D Composition (Interactive Parallax via GSAP) -->
        <div class="lg:col-span-6 hidden lg:flex items-center justify-center relative h-[600px] fade-up" style="animation-delay: 200ms;" id="hero-3d-container">
          <div class="absolute inset-0 w-full h-full perspective-1000">
            <img 
              src="/images/medical/brain.png" 
              alt="Premium Anatomical Brain Visualization" 
              class="absolute inset-0 w-full h-full object-contain filter drop-shadow-2xl mix-blend-screen opacity-70"
              id="hero-brain"
              loading="eager"
            />
            <!-- Simulated particles -->
            <div id="hero-particles" class="absolute inset-0 w-full h-full mix-blend-screen opacity-40 bg-[url('/images/premium_clinic_map.png')] bg-cover bg-center"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Featured Insight -->
  <section class="py-24 bg-bg-primary border-b border-border-subtle relative z-20">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono-label text-text-muted tracking-[0.2em] uppercase mb-8 block flex items-center gap-2">
        <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
        Featured Insight
      </span>

      <a href={`/blog/${featuredArticle.slug}`} class="block group relative rounded-3xl overflow-hidden bg-bg-secondary border border-border-subtle shadow-xl hover:shadow-2xl transition-all duration-500 hover:border-accent/50 focus-visible:ring-2 focus-visible:ring-accent outline-none">
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[500px]">
          <!-- Image -->
          <div class="lg:col-span-7 relative overflow-hidden h-[300px] lg:h-auto bg-midnight">
            <img 
              src={featuredArticle.image} 
              alt={featuredArticle.title} 
              class="absolute inset-0 w-full h-full object-cover object-center transform group-hover:scale-[1.03] transition-transform duration-700 ease-out opacity-80"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-bg-secondary via-bg-secondary/20 to-transparent"></div>
          </div>
          <!-- Content -->
          <div class="lg:col-span-5 relative flex flex-col justify-center p-10 lg:p-16 z-10 bg-bg-secondary">
            <span class="font-mono-label text-accent text-[11px] uppercase tracking-widest mb-4 block">{featuredArticle.category}</span>
            <h2 class="font-display font-semibold text-text-primary leading-tight mb-6 group-hover:text-accent transition-colors duration-300" style="font-size: clamp(2rem, 4vw, 3rem);">
              {featuredArticle.title}
            </h2>
            <p class="text-text-secondary text-lg font-light leading-relaxed mb-10 line-clamp-3">
              {featuredArticle.excerpt}
            </p>
            
            <div class="mt-auto border-t border-border-subtle pt-6 flex flex-wrap items-center justify-between gap-4">
              <div>
                <div class="font-mono-label text-text-muted text-[9px] mb-1 uppercase">Author</div>
                <div class="font-mono-label text-text-primary text-[11px]">Dr. Sylvia Shitsama</div>
              </div>
              <div>
                <div class="font-mono-label text-text-muted text-[9px] mb-1 uppercase">Published</div>
                <div class="font-mono-label text-text-primary text-[11px]">{featuredArticle.date}</div>
              </div>
              <div class="flex-shrink-0">
                <span class="text-link font-mono-label text-[11px] inline-flex items-center">
                  Read Article
                  <svg class="w-4 h-4 ml-2 transition-transform duration-300 group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- 3. Navigation, Search & Grid -->
  <section class="py-24 bg-bg-primary min-h-[80vh]" x-data="{ 
    searchQuery: '', 
    activeCategory: 'All',
    get filteredArticles() {
      const articles = JSON.parse(document.getElementById('articles-data').textContent);
      return articles.filter(article => {
        const matchesSearch = article.title.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                              article.excerpt.toLowerCase().includes(this.searchQuery.toLowerCase());
        const matchesCategory = this.activeCategory === 'All' || article.category === this.activeCategory;
        return matchesSearch && matchesCategory;
      });
    }
  }">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Search and Topics Header -->
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 mb-16 border-b border-border-subtle pb-8">
        
        <!-- Search -->
        <div class="relative w-full lg:w-96 group">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted group-focus-within:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            x-model="searchQuery"
            placeholder="Search insights, conditions or topics..." 
            class="w-full bg-bg-secondary border border-border-strong rounded-full py-4 pl-12 pr-6 text-base text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all shadow-sm"
          />
        </div>

        <!-- Topics / Categories -->
        <div class="w-full lg:w-auto overflow-x-auto pb-4 lg:pb-0 scrollbar-hide mask-edges">
          <div class="flex items-center gap-2 min-w-max">
            <span class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase mr-4">Explore by Topic:</span>
            {categories.map((cat) => (
              <button 
                @click={`activeCategory = '${cat}'`}
                :class={`activeCategory === '${cat}' ? 'bg-accent text-white border-accent' : 'bg-transparent text-text-muted border-border-strong hover:border-accent hover:text-text-primary'`}
                class="px-5 py-2 rounded-full border text-xs font-mono-label transition-all duration-300 focus-visible:ring-2 focus-visible:ring-accent outline-none"
              >
                {cat}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- JSON Data Injection for Alpine -->
      <script type="application/json" id="articles-data" set:html={JSON.stringify(gridArticles)}></script>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" x-show="filteredArticles.length > 0">
        <template x-for="article in filteredArticles" :key="article.slug">
          <a :href="`/blog/${article.slug}`" class="block group relative bg-bg-secondary rounded-2xl border border-border-subtle overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl focus-visible:ring-2 focus-visible:ring-accent outline-none flex flex-col h-full">
            <div class="relative h-[240px] overflow-hidden bg-midnight">
              <img :src="article.image" :alt="article.title" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-[1.05] transition-transform duration-700 ease-out opacity-90" loading="lazy" />
              <!-- Top orange accent line on hover -->
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            
            <div class="p-8 flex-grow flex flex-col">
              <span class="font-mono-label text-accent text-[10px] uppercase tracking-widest mb-3 block" x-text="article.category"></span>
              <h3 class="font-display text-2xl font-semibold text-text-primary leading-snug mb-4 group-hover:text-accent transition-colors duration-300 line-clamp-3" style="font-size: clamp(1.4rem, 2vw, 1.7rem);" x-text="article.title"></h3>
              <p class="text-text-secondary text-sm font-light leading-relaxed mb-6 line-clamp-3 flex-grow" x-text="article.excerpt"></p>
              
              <div class="mt-auto border-t border-border-subtle pt-4 flex items-center justify-between">
                <span class="font-mono-label text-[10px] text-text-muted" x-text="article.readTime"></span>
                <span class="text-link font-mono-label text-[10px] inline-flex items-center">
                  Read 
                  <svg class="w-3 h-3 ml-1 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </template>
      </div>

      <!-- Empty State -->
      <div x-show="filteredArticles.length === 0" style="display: none;" class="py-20 text-center bg-bg-secondary rounded-2xl border border-border-subtle">
        <svg class="w-12 h-12 text-text-muted mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <h3 class="font-display text-2xl font-semibold text-text-primary mb-2">No Insights Found</h3>
        <p class="text-text-secondary font-light mb-6">Try adjusting your search terms or selecting a different topic.</p>
        <button @click="searchQuery = ''; activeCategory = 'All';" class="btn-ghost-dark text-sm">
          View All Insights
        </button>
      </div>
    </div>
  </section>

  <!-- 4. Editorial Statistics -->
  <section class="py-12 bg-bg-secondary border-y border-border-subtle">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-border-strong">
        <div class="pt-4 md:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-bold text-text-primary mb-2">13<span class="text-accent">+</span></div>
          <div class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase">Peer-reviewed publications</div>
        </div>
        <div class="pt-8 md:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-bold text-text-primary mb-2">34<span class="text-accent">+</span></div>
          <div class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase">Research citations</div>
        </div>
        <div class="pt-8 md:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-bold text-text-primary mb-2">20<span class="text-accent">+</span></div>
          <div class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase">Years of experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. From Research to Patient Care CTA -->
  <section class="py-24 bg-bg-primary relative overflow-hidden">
    <!-- Subtle Neural Network Background -->
    <div class="absolute right-0 top-0 w-1/2 h-full opacity-10 pointer-events-none">
      <MedicalVisualization type="research" />
    </div>
    
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-2xl">
        <span class="font-mono-label text-accent tracking-[0.2em] uppercase mb-4 block">Academic Excellence</span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-text-primary mb-6">From Research to<br />Patient Care</h2>
        <p class="text-text-secondary text-lg font-light leading-relaxed mb-10">
          Explore the evidence and global research informing modern neurosurgical practice at Sage Brain & Spine Clinic.
        </p>
        <a href="/research" class="btn-primary">
          Explore Academic Research 
          <svg class="w-4 h-4 ml-2 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Author Presence & Disclaimer -->
  <section class="py-20 bg-bg-secondary border-t border-border-subtle">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <span class="font-mono-label text-[10px] text-text-muted tracking-widest uppercase block mb-8 text-center sm:text-left">Insights Curated By</span>
        <ArticleAuthor />
        
        <!-- Medical Disclaimer -->
        <div class="mt-12 p-6 rounded-xl border border-border-subtle bg-bg-primary/50 text-center">
          <p class="font-mono-label text-[10px] text-text-muted uppercase tracking-widest mb-2">Medical Disclaimer</p>
          <p class="text-text-secondary text-xs font-light max-w-2xl mx-auto">
            The information provided on this platform is for educational purposes only and does not replace personalised medical advice, diagnosis, or treatment. Always seek the advice of a qualified healthcare provider with any questions regarding a medical condition.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Fade-up scroll animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px' });

    document.querySelectorAll('.fade-up').forEach(el => {
      observer.observe(el);
    });

    // Check for prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    // GSAP Interactive Parallax for the Hero
    if (!prefersReducedMotion && window.innerWidth > 1024) {
      try {
        const heroSection = document.getElementById('hero-section');
        const brain = document.getElementById('hero-brain');
        const particles = document.getElementById('hero-particles');
        
        if (heroSection && brain && particles) {
          heroSection.addEventListener('mousemove', (e) => {
            const xAxis = (window.innerWidth / 2 - e.pageX) / 50;
            const yAxis = (window.innerHeight / 2 - e.pageY) / 50;
            
            gsap.to(brain, {
              rotationY: xAxis,
              rotationX: yAxis,
              x: -xAxis * 2,
              y: -yAxis * 2,
              duration: 1,
              ease: "power2.out"
            });
            
            gsap.to(particles, {
              x: xAxis * 3,
              y: yAxis * 3,
              duration: 2,
              ease: "power2.out"
            });
          });
          
          // Reset on mouse leave
          heroSection.addEventListener('mouseleave', () => {
            gsap.to([brain, particles], {
              rotationY: 0,
              rotationX: 0,
              x: 0,
              y: 0,
              duration: 1.5,
              ease: "power2.out"
            });
          });
        }
      } catch (e) {
        console.log("GSAP not loaded for hero interaction");
      }
    }
  });
</script>
