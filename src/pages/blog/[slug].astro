---
// [slug].astro
// Clean, patient-centric article template answering common neurosurgical questions

import Layout from '../../layouts/Layout.astro';
import { insights } from '../../data/insights';

export async function getStaticPaths() {
  return insights.map((insight) => ({
    params: { slug: insight.slug },
    props: { insight },
  }));
}

const { insight } = Astro.props;

// Other related patient insights
const otherInsights = insights.filter((i) => i.slug !== insight.slug);
---

<Layout
  title={`${insight.title} — Insights | Dr. Sylvia Shitsama`}
  description={insight.excerpt}
  canonicalUrl={`/blog/${insight.slug}`}
  isArticle={true}
  articlePublishDate={insight.date}
  articleAuthor="Dr. Sylvia Shitsama"
>
  <!-- Reading Progress Bar -->
  <div class="fixed top-0 left-0 h-1 bg-midnight z-[100] w-full" aria-hidden="true">
    <div id="reading-progress" class="h-full bg-copper w-0 transition-all duration-150 ease-out"></div>
  </div>

  <!-- Breadcrumbs -->
  <div class="pt-28 pb-4 bg-midnight border-b border-ivory/5">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 font-mono text-xs text-sage" aria-label="Breadcrumb">
        <a href="/" class="hover:text-copper transition-colors">Home</a>
        <span aria-hidden="true">&rarr;</span>
        <a href="/insights" class="hover:text-copper transition-colors">Insights</a>
        <span aria-hidden="true">&rarr;</span>
        <span class="text-ivory line-clamp-1" aria-current="page">{insight.title}</span>
      </nav>
    </div>
  </div>

  <!-- Article Hero Header -->
  <header class="py-16 sm:py-20 bg-midnight relative border-b border-ivory/10">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[10px] font-mono uppercase tracking-widest text-copper bg-copper/10 border border-copper/20 px-3 py-1 rounded-full">
          {insight.category}
        </span>
        <span class="text-xs text-sage font-mono">&middot;</span>
        <span class="text-xs text-sage font-mono">{insight.readTime}</span>
        <span class="text-xs text-sage font-mono">&middot;</span>
        <span class="text-xs text-sage font-mono">{insight.date}</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory tracking-tight leading-[1.15] mb-6">
        {insight.title}
      </h1>

      <p class="text-sage text-lg font-light leading-relaxed mb-8">
        {insight.excerpt}
      </p>

      <!-- Author Byline -->
      <div class="flex items-center gap-4 pt-6 border-t border-ivory/10">
        <img 
          src="/images/dr-shitsama-lab-coat.jpg" 
          alt="Dr. Sylvia Shitsama" 
          class="w-12 h-12 rounded-full object-cover border border-copper/30"
        />
        <div>
          <div class="text-sm font-display font-medium text-ivory">Dr. Sylvia Shitsama</div>
          <div class="text-xs text-sage font-light">Consultant Neurosurgeon &middot; Sage Brain &amp; Spine Clinic</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Article Body structured around Patient Questions -->
  <article class="py-16 bg-midnight-light border-b border-ivory/10" id="article-content">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      
      <!-- Article Featured Image -->
      <div class="rounded-2xl overflow-hidden mb-12 border border-ivory/10 bg-midnight shadow-xl">
        <img 
          src={insight.image} 
          alt={insight.title} 
          class="w-full h-auto max-h-[440px] object-cover"
        />
      </div>

      <!-- Structured Content Blocks -->
      <div class="space-y-12">
        
        <!-- 1. Patient Question -->
        <section class="p-6 sm:p-8 rounded-2xl bg-midnight border border-copper/30 shadow-md">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-copper"></span>
            <h2 class="font-mono text-xs uppercase tracking-widest text-copper font-semibold">Patient Question</h2>
          </div>
          <blockquote class="font-display text-xl sm:text-2xl text-ivory font-medium italic leading-relaxed">
            "{insight.sections.patientQuestion}"
          </blockquote>
        </section>

        <!-- 2. What You Should Know -->
        <section class="space-y-4">
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ivory tracking-tight">
            What You Should Know
          </h2>
          <p class="text-sage text-base sm:text-lg font-light leading-relaxed">
            {insight.sections.whatYouShouldKnow}
          </p>
        </section>

        <!-- 3. When Should You Seek Medical Attention? -->
        <section class="space-y-4 p-6 sm:p-8 rounded-2xl bg-midnight border border-ivory/10">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <h2 class="font-display text-xl sm:text-2xl font-semibold text-ivory tracking-tight">
              When Should You Seek Medical Attention?
            </h2>
          </div>
          <p class="text-xs font-mono text-sage uppercase tracking-wider mb-4">Warning Signs &amp; Clinical Indicators</p>
          <ul class="space-y-3">
            {insight.sections.whenToSeekAttention.map((point) => (
              <li class="text-sage text-sm sm:text-base font-light flex items-start gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-copper mt-2 shrink-0"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 4. What Happens Next? -->
        <section class="space-y-4">
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ivory tracking-tight">
            What Happens Next?
          </h2>
          <p class="text-sage text-base sm:text-lg font-light leading-relaxed">
            {insight.sections.whatHappensNext}
          </p>
        </section>

        <!-- 5. Key Takeaway -->
        <section class="p-6 sm:p-8 rounded-2xl bg-midnight border-l-4 border-copper">
          <h2 class="font-mono text-xs uppercase tracking-widest text-copper font-semibold mb-2">Key Takeaway</h2>
          <p class="text-ivory font-display text-lg sm:text-xl font-medium leading-relaxed">
            {insight.sections.keyTakeaway}
          </p>
        </section>

      </div>

      <!-- Consultation CTA at End of Article -->
      <div class="mt-16 pt-12 border-t border-ivory/10 text-center">
        <h3 class="font-display text-2xl font-semibold text-ivory mb-3">
          Have Questions About Your Symptoms?
        </h3>
        <p class="text-sage text-sm font-light max-w-xl mx-auto mb-6">
          Consult with Dr. Sylvia Shitsama at Sage Brain &amp; Spine Clinic, KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a 
            href={`https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20read%20the%20article%20on%20${encodeURIComponent(insight.title)}%20and%20would%20like%20to%20enquire%20about%20a%20consultation.`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary text-sm inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Book a Consultation
          </a>
          <a href="/contact" class="btn-ghost text-sm">
            Clinic Contact Details
          </a>
        </div>
      </div>

    </div>
  </article>

  <!-- More Patient Education Articles -->
  {otherInsights.length > 0 && (
    <section class="py-20 bg-midnight">
      <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
        <h3 class="font-display text-2xl font-semibold text-ivory mb-8">
          Related Patient Insights
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {otherInsights.map((item) => (
            <a href={`/blog/${item.slug}`} class="p-6 rounded-2xl bg-midnight-light border border-ivory/10 hover:border-copper/40 transition-colors block group">
              <span class="text-[10px] font-mono uppercase tracking-wider text-copper mb-2 block">{item.category}</span>
              <h4 class="font-display text-lg font-medium text-ivory group-hover:text-copper transition-colors mb-2">
                {item.title}
              </h4>
              <p class="text-xs text-sage font-light line-clamp-2">{item.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  window.addEventListener('scroll', () => {
    const el = document.getElementById('reading-progress');
    if (el) {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = (window.scrollY / scrollHeight) * 100;
      el.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  });
</script>
