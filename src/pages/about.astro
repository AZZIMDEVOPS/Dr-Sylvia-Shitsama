---
// about.astro
// Clean, streamlined biography page for Dr. Sylvia Shitsama
// Featuring Hero Section, Consultation CTA, and Footer

import Layout from '../layouts/Layout.astro';
import CTAStrip from '../components/CTAStrip.astro';
---

<Layout
  title="About Dr. Sylvia Shitsama — Neurosurgeon | Nairobi, Kenya"
  description="Learn about Dr. Sylvia Shitsama, Neurosurgeon at Kenyatta National Referral Hospital, Senior Lecturer at JKUAT, and Founder of Sage Brain & Spine Clinic."
  canonicalUrl="/about"
>
  <!-- 01 / BIOGRAPHY HERO SECTION -->
  <section class="relative bg-white pt-32 sm:pt-36 pb-20 sm:pb-28 overflow-hidden" id="biography">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Text Column (7 Cols) -->
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-[2px] bg-copper"></span>
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs font-semibold">Consultant Neurosurgeon</span>
          </div>
          
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-text-primary leading-[1.1] mb-6 tracking-tight">
            Dr. Sylvia Shitsama
          </h1>
          
          <!-- Key Credentials Badges -->
          <div class="flex flex-wrap items-center gap-2.5 mb-8">
            <span class="font-mono text-xs text-copper px-3.5 py-1 bg-copper/10 rounded-full border border-copper/20 font-semibold shadow-xs">MBChB</span>
            <span class="font-mono text-xs text-copper px-3.5 py-1 bg-copper/10 rounded-full border border-copper/20 font-semibold shadow-xs">MMed Neurosurgery (2015)</span>
            <span class="font-mono text-xs text-slate-700 px-3.5 py-1 bg-slate-100 rounded-full border border-slate-200 font-medium shadow-xs">U of Toronto Fellow (2019)</span>
          </div>

          <!-- Comprehensive Narrative Bio -->
          <div class="space-y-4 text-text-secondary text-base sm:text-lg font-light leading-relaxed mb-10 max-w-xl">
            <p class="text-text-primary font-normal">
              Specialist neurosurgeon dedicated to delivering clinical excellence, evidence-based surgical care, and compassionate patient support in Nairobi, Kenya.
            </p>
            <p class="text-sm sm:text-base text-slate-600">
              Dr. Sylvia Shitsama graduated with her Bachelor of Medicine and Bachelor of Surgery (MBChB) and completed her postgraduate Master of Medicine in Neurosurgery (MMed) in 2015 from the University of Nairobi. In 2019, she completed an advanced Clinical and Research Fellowship in General Neurosurgery at the <strong class="text-slate-900 font-medium">University of Toronto, Canada</strong>, bringing modern microsurgical techniques and international protocols back to clinical practice in East Africa.
            </p>
            <p class="text-sm sm:text-base text-slate-600">
              Since 2016, she has served as Senior Lecturer at Jomo Kenyatta University of Agriculture &amp; Technology (JKUAT), teaching medical students and resident trainees, while contributing actively to peer-reviewed neurosurgical literature. She founded <strong class="text-slate-900 font-medium">Sage Brain &amp; Spine Clinic</strong> to provide focused, accessible, and compassionate neurosurgical consultation and operative care.
            </p>
          </div>

          <!-- Action Links -->
          <div class="flex flex-wrap items-center gap-4">
            <a href="#consultation-cta" class="btn-primary inline-flex items-center gap-2">
              <span>Book a Consultation</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
            </a>
            
            <a 
              href="https://www.linkedin.com/in/sylvia-shitsama" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 text-xs font-mono text-slate-700 hover:text-copper border border-slate-200 hover:border-copper/40 px-4 py-3 rounded-lg transition-colors bg-white shadow-xs"
              title="Explore professional profile on LinkedIn"
            >
              <svg class="w-4 h-4 text-copper" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.75-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              <span>LinkedIn Profile</span>
            </a>
          </div>
        </div>

        <!-- Authentic Portrait Image Column (5 Cols) -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-sm">
            <div class="relative rounded-2xl overflow-hidden aspect-[4/5] bg-slate-100 border border-slate-200 shadow-xl group">
              <img 
                src="/images/dr-shitsama-headshot.jpg" 
                alt="Dr. Sylvia Shitsama, Consultant Neurosurgeon"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-102"
                width="600"
                height="750"
                loading="eager"
              />
              
              <!-- Clean Surgeon Badge -->
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-white/95 backdrop-blur-md border border-slate-200 shadow-md">
                <div class="flex items-center gap-2 mb-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-[11px] font-mono uppercase tracking-wider text-copper font-semibold">Consultant Neurosurgeon</span>
                </div>
                <div class="text-sm font-semibold text-text-primary">Dr. Sylvia Shitsama</div>
                <div class="text-xs text-text-muted font-light">Sage Brain &amp; Spine Clinic &middot; Nairobi</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 02 / SURGICAL EXCELLENCE & THEATRE STANDARDS -->
  <section class="py-20 sm:py-24 bg-slate-50 border-t border-slate-200/80" id="theatre-standards">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-copper/10 border border-copper/20 text-copper text-xs font-mono uppercase tracking-widest font-semibold mb-4">
          <span class="w-2 h-2 rounded-full bg-copper animate-pulse"></span>
          Clinical Excellence in Action
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Inside the Operating Theatre
        </h2>
        <p class="text-text-secondary text-base sm:text-lg font-light leading-relaxed">
          Operating with state-of-the-art neurosurgical technology, high-magnification microsurgical optics, and rigorous intraoperative monitoring to protect neurological function at every step.
        </p>
      </div>

      <!-- Feature Grid: Lead Photo + 4 Technology Pillars -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-10">
        <!-- Lead Feature: Dr. Sylvia Operating Under Theatre Lamp (7 cols) -->
        <div class="lg:col-span-7 rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-md flex flex-col group">
          <div class="relative aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-slate-900">
            <img
              src="/images/dr-sylvia-operating-theatre-lamp.jpg"
              alt="Dr. Sylvia Shitsama performing neurosurgery under theatre illumination"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="1200"
              height="800"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/30 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-copper text-white text-[11px] font-mono uppercase tracking-wider font-semibold mb-2 shadow-xs">
                Operative Care &middot; Dr. Sylvia Shitsama
              </span>
              <h3 class="font-display text-2xl sm:text-3xl font-bold text-white mb-2">
                Microsurgical Mastery &amp; Patient Dedication
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 font-light max-w-xl leading-relaxed">
                Leading complex cranial and spinal procedures with meticulous precision, rigorous infection control, and evidence-based surgical protocols.
              </p>
            </div>
          </div>
        </div>

        <!-- Secondary Feature: Operating Microscope (5 cols) -->
        <div class="lg:col-span-5 rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-md flex flex-col group">
          <div class="relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:h-full overflow-hidden bg-slate-900">
            <img
              src="/images/advanced-neurosurgical-microscope.jpg"
              alt="Advanced neurosurgical operating microscope and theatre suite"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="900"
              height="1100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/30 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-mono uppercase tracking-wider font-semibold mb-2 border border-white/20">
                Advanced Optics
              </span>
              <h3 class="font-display text-xl sm:text-2xl font-bold text-white mb-1.5">
                High-Magnification Neuro-Microscopy
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 font-light leading-relaxed">
                Sub-millimetre optical visualization of critical vessels, cranial nerves, and delicate brain structures.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 3-Column Supporting Equipment Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Precision Instruments -->
        <div class="rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden bg-slate-100 relative">
            <img
              src="/images/precision-neurosurgical-instruments.jpg"
              alt="Precision micro-neurosurgical instruments laid on sterile tray"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="text-[11px] font-mono uppercase tracking-wider text-copper font-semibold mb-1">Instrumentation</div>
            <h4 class="font-display text-lg font-bold text-text-primary mb-2">Micro-Neurosurgical Tooling</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-relaxed">
              Specialized micro-forceps, bipolar coagulators, and micro-dissectors designed specifically for delicate brain and spinal cord manipulation.
            </p>
          </div>
        </div>

        <!-- Card 2: Vital Monitoring Station -->
        <div class="rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden bg-slate-100 relative">
            <img
              src="/images/theatre-vital-monitoring-station.jpg"
              alt="Intraoperative patient vital monitoring system in theatre"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="text-[11px] font-mono uppercase tracking-wider text-copper font-semibold mb-1">Patient Safety</div>
            <h4 class="font-display text-lg font-bold text-text-primary mb-2">Continuous Neuro-Monitoring</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-relaxed">
              Multi-parameter hemodynamic, intracranial pressure, and anesthetic monitoring ensuring absolute physiological stability throughout surgery.
            </p>
          </div>
        </div>

        <!-- Card 3: Theatre Team & Protocol -->
        <div class="rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex flex-col group">
          <div class="aspect-[16/10] overflow-hidden bg-slate-100 relative">
            <img
              src="/images/neurosurgery-theatre-team-instruments.jpg"
              alt="Surgical theatre team and sterile field preparation"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="text-[11px] font-mono uppercase tracking-wider text-copper font-semibold mb-1">Theatre Team</div>
            <h4 class="font-display text-lg font-bold text-text-primary mb-2">Sterile Field &amp; Teamwork</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-relaxed">
              Synchronized theatre nursing, neuro-anesthesia coordination, and strict infection prevention guidelines matching global benchmarks.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 03 / CONSULTATION CTA SECTION -->
  <CTAStrip />
</Layout>
