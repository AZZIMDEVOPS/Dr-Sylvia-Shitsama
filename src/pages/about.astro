---
// about.astro
// Professional biography & verified career narrative for Dr. Sylvia Shitsama
// Enriched with creative scroll-driven animations, timeline beam tracking, and narrative chapter navigation

import Layout from '../layouts/Layout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';

const careerHighlights = [
  {
    metric: '20+',
    label: 'Years in Clinical Practice',
    detail: 'Extensive surgical experience across complex cranial, spinal, and trauma neurosurgery.'
  },
  {
    metric: '2019',
    label: 'Toronto Fellowship',
    detail: 'Specialized Clinical & Research Fellowship in General Neurosurgery at the University of Toronto.'
  },
  {
    metric: '2016',
    label: 'Senior Lecturer, JKUAT',
    detail: 'Directing academic teaching, mentoring neurosurgery residents, and authoring clinical research.'
  }
];

const clinicalAreas = [
  { title: 'Brain Trauma & Head Injuries', desc: 'Emergency neurosurgical management of traumatic intracranial hematomas, fractures, and edema.' },
  { title: 'Brain Tumors & Cranial Surgery', desc: 'Meticulous microsurgical resection of benign and malignant brain lesions, meningiomas, and glioma.' },
  { title: 'Spine Surgery & Stabilization', desc: 'Decompression and instrumentation for spinal trauma, disc herniation, stenosis, and instability.' },
  { title: 'Hydrocephalus (Adult & Pediatric)', desc: 'Ventriculoperitoneal (VP) shunt placement, revisions, and endoscopic third ventriculostomy.' },
  { title: 'Congenital Neurological Conditions', desc: 'Surgical repair of neural tube defects including spina bifida and encephalocele in infants.' },
  { title: 'Pediatric Neurosurgery', desc: 'Specialized operative intervention tailored for neonatal, infant, and childhood cranial and spinal conditions.' },
];
---

<Layout
  title="About Dr. Sylvia Shitsama — Neurosurgeon | Nairobi, Kenya"
  description="Learn about Dr. Sylvia Shitsama, Neurosurgeon at Kenyatta National Referral Hospital, Senior Lecturer at JKUAT, and Founder of Sage Brain & Spine Clinic."
  canonicalUrl="/about"
>
  <!-- Global Scroll Reading Progress Bar -->
  <div 
    id="about-scroll-progress" 
    class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-copper via-gold to-copper z-50 transition-all duration-100 ease-out shadow-[0_0_10px_rgba(193,122,62,0.8)] pointer-events-none"
    style="width: 0%;"
    aria-hidden="true"
  ></div>

  <!-- 01 / BIOGRAPHY HERO -->
  <section class="relative bg-midnight pt-32 sm:pt-36 pb-20 sm:pb-28 overflow-hidden" id="biography">
    <!-- Ambient Neural Glow Orbs with Parallax Float -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <div id="hero-glow-1" class="absolute top-1/4 right-1/4 w-[500px] h-[500px] bg-copper/10 rounded-full blur-[140px] transition-transform duration-700"></div>
      <div id="hero-glow-2" class="absolute -bottom-20 left-10 w-[400px] h-[400px] bg-gold/5 rounded-full blur-[120px] transition-transform duration-700"></div>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Text Column (7 Cols) -->
        <div class="lg:col-span-7">
          <div class="about-hero-item opacity-0 translate-y-6 transition-all duration-700 ease-out">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-8 h-[2px] bg-copper"></span>
              <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Neurosurgeon</span>
            </div>
          </div>
          
          <div class="about-hero-item opacity-0 translate-y-6 transition-all duration-700 ease-out delay-100">
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-ivory leading-[1.1] mb-6 tracking-tight">
              Dr. Sylvia Shitsama
            </h1>
          </div>
          
          <div class="about-hero-item opacity-0 translate-y-6 transition-all duration-700 ease-out delay-200">
            <div class="flex flex-wrap items-center gap-2.5 mb-8">
              <span class="font-mono text-xs text-gold px-3.5 py-1 bg-gold/10 rounded-full border border-gold/20 font-semibold shadow-sm">MBChB</span>
              <span class="font-mono text-xs text-gold px-3.5 py-1 bg-gold/10 rounded-full border border-gold/20 font-semibold shadow-sm">MMed Neurosurgery (2015)</span>
              <span class="font-mono text-xs text-copper px-3.5 py-1 bg-copper/10 rounded-full border border-copper/20 font-medium shadow-sm">U of Toronto Fellow (2019)</span>
            </div>
          </div>

          <div class="about-hero-item opacity-0 translate-y-6 transition-all duration-700 ease-out delay-300">
            <p class="text-sage text-lg font-light leading-relaxed mb-8 max-w-xl">
              Specialist neurosurgeon dedicated to delivering clinical excellence, evidence-based surgical care, and compassionate patient support in Nairobi, Kenya.
            </p>
          </div>

          <div class="about-hero-item opacity-0 translate-y-6 transition-all duration-700 ease-out delay-400">
            <div class="flex flex-wrap items-center gap-4">
              <a href="#milestones-section" class="btn-ghost inline-flex items-center gap-2 group">
                <span>View Career Milestones</span>
                <svg class="w-4 h-4 text-copper group-hover:translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </a>
              
              <a 
                href="https://www.linkedin.com/in/sylvia-shitsama" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2 text-xs font-mono text-sage hover:text-copper border border-ivory/10 hover:border-copper/40 px-4 py-3 rounded-lg transition-colors"
                title="Explore professional profile on LinkedIn"
              >
                <svg class="w-4 h-4 text-copper" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.75-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span>LinkedIn Profile</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Authentic Portrait Image Column with Parallax Depth (5 Cols) -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-sm about-portrait-wrapper opacity-0 translate-y-10 scale-95 transition-all duration-1000 ease-out delay-200">
            
            <!-- Outer Glow Halo -->
            <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-copper/30 via-gold/15 to-transparent blur-lg opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>

            <div class="relative rounded-2xl overflow-hidden aspect-[4/5] bg-midnight-light border border-ivory/10 shadow-2xl group transition-transform duration-500 hover:scale-[1.01]">
              <img 
                src="/images/dr-shitsama-headshot.jpg" 
                alt="Dr. Sylvia Shitsama, Neurosurgeon"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                width="600"
                height="750"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-midnight/90 via-midnight/20 to-transparent"></div>
              
              <!-- Floating Glassmorphic Surgeon Badge -->
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-midnight/90 backdrop-blur-md border border-copper/30 shadow-lg">
                <div class="flex items-center gap-2 mb-1">
                  <span class="w-2 h-2 rounded-full bg-copper animate-pulse"></span>
                  <span class="text-[11px] font-mono uppercase tracking-wider text-copper font-semibold">Neurosurgeon</span>
                </div>
                <div class="text-sm font-semibold text-ivory">Dr. Sylvia Shitsama</div>
                <div class="text-xs text-sage font-light">Lead Neurosurgeon &middot; Sage Brain &amp; Spine Clinic</div>
              </div>
            </div>

            <!-- Corner Geometric Accents -->
            <div class="absolute -bottom-3 -right-3 w-20 h-20 border border-copper/30 rounded-2xl -z-10 hidden sm:block"></div>
            <div class="absolute -top-3 -left-3 w-16 h-16 border border-gold/20 rounded-2xl -z-10 hidden sm:block"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 02 / ACADEMIC RIGOUR & CLINICAL LEADERSHIP -->
  <section class="py-20 sm:py-28 border-t border-ivory/5 bg-midnight-light/50 relative overflow-hidden" id="background">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-5xl">
      
      <!-- Section Header -->
      <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out mb-12">
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-3 block">Professional Background</span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory mb-6 leading-tight">
          Academic Rigour. Surgical Precision.
        </h2>
        <div class="w-16 h-[2px] bg-gradient-to-r from-copper to-gold mb-8"></div>

        <div class="space-y-6 text-sage text-base sm:text-lg font-light leading-relaxed max-w-3xl">
          <p>
            Dr. Sylvia Shitsama received her Bachelor of Medicine and Bachelor of Surgery (MBChB) and completed her postgraduate Master of Medicine in Neurosurgery (MMed) in 2015 from the University of Nairobi.
          </p>
          <p>
            In 2019, she undertook a specialized Clinical and Research Fellowship in General Neurosurgery at the <strong class="text-ivory font-medium">University of Toronto, Canada</strong>, bringing advanced international neurosurgical protocols and microsurgical techniques back to clinical practice in East Africa.
          </p>
          <p>
            Since 2016, she has served as Senior Lecturer at Jomo Kenyatta University of Agriculture &amp; Technology (JKUAT), teaching medical students and resident trainees, while contributing actively to peer-reviewed neurosurgical literature. She founded Sage Brain &amp; Spine Clinic to provide focused, accessible neurosurgical care for patients in Kenya.
          </p>
        </div>
      </div>

      <!-- 3 Key Metric / Credential Cards (Staggered Scroll Entrance) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        {careerHighlights.map((item, idx) => (
          <div 
            class="stat-reveal-card p-6 sm:p-7 rounded-2xl bg-midnight border border-ivory/10 hover:border-copper/40 transition-all duration-500 shadow-xl opacity-0 translate-y-8 hover:-translate-y-1 group"
            style={`transition-delay: ${idx * 150}ms;`}
          >
            <div class="font-display text-4xl sm:text-5xl font-bold text-copper mb-2 group-hover:text-gold transition-colors">
              {item.metric}
            </div>
            <div class="text-sm font-semibold text-ivory mb-2">
              {item.label}
            </div>
            <p class="text-xs text-sage leading-relaxed font-light">
              {item.detail}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 03 / VERIFIED CAREER MILESTONES (INTERACTIVE TIMELINE) -->
  <JourneyTimeline />

  <!-- 04 / CLINICAL PRACTICE SCOPE -->
  <section id="practice" class="relative bg-midnight-light py-20 sm:py-28 border-t border-ivory/5 overflow-hidden">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-5xl">
      
      <!-- Section Header -->
      <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out mb-12">
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-3 block">Practice Focus</span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory mb-4 leading-tight">
          Areas of Clinical Practice
        </h2>
        <p class="text-sage text-base sm:text-lg font-light leading-relaxed max-w-2xl">
          Dr. Shitsama's practice at Sage Brain &amp; Spine Clinic encompasses adult and pediatric neurosurgery across six primary clinical disciplines:
        </p>
      </div>

      <!-- 6 Clinical Specialty Cards with Staggered Cascading Entrance -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {clinicalAreas.map((area, idx) => (
          <div 
            class="practice-card p-6 rounded-2xl bg-midnight border border-ivory/10 hover:border-copper/50 transition-all duration-500 shadow-lg opacity-0 translate-y-8 hover:-translate-y-1.5 group relative overflow-hidden"
            style={`transition-delay: ${idx * 100}ms;`}
          >
            <!-- Hover Top Gradient Accent -->
            <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-copper to-gold opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="flex items-center gap-3 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-copper group-hover:scale-125 group-hover:shadow-[0_0_8px_#C17A3E] transition-all shrink-0"></span>
              <h3 class="text-ivory font-semibold text-base group-hover:text-copper transition-colors">
                {area.title}
              </h3>
            </div>
            
            <p class="text-sage text-xs leading-relaxed font-light pl-5.5">
              {area.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Outbound Link to Expertise -->
      <div class="scroll-reveal opacity-0 translate-y-6 transition-all duration-700 ease-out text-center sm:text-left">
        <a 
          href="/expertise" 
          class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-copper hover:text-gold transition-colors font-semibold group"
        >
          <span>Explore Clinical Services In Detail</span>
          <span class="group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 05 / LOWER PAGE CONSULTATION CTA -->
  <section class="py-24 sm:py-32 bg-midnight relative overflow-hidden text-center border-t border-ivory/5" id="consultation">
    <!-- Ambient Consultation Glow Halo -->
    <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
      <div class="w-[600px] h-[600px] bg-copper/10 rounded-full blur-[160px] animate-pulse"></div>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-3xl scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out">
      <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-3 block">Consultation</span>
      
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ivory mb-6 tracking-tight">
        Ready to Discuss Your Care?
      </h2>
      
      <p class="text-sage text-base sm:text-lg mb-3 font-light leading-relaxed">
        Dr. Shitsama conducts consultations at Sage Brain &amp; Spine Clinic located at <strong class="text-ivory font-medium">KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi</strong>.
      </p>

      <p class="text-sage/70 text-sm mb-10 font-light">
        Self-referrals, second opinions, and physician referrals are welcome.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
        <a 
          href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-xl font-medium transition-all hover:-translate-y-0.5 shadow-lg shadow-copper/25 group"
        >
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>Book a Consultation</span>
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-ivory/20 hover:border-ivory/50 text-ivory px-8 py-4 rounded-xl font-medium transition-all hover:bg-ivory/5"
        >
          <span>Contact Details &amp; Directions</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Floating Minimal Chapter Indicator Pill (Desktop) -->
  <aside 
    id="chapter-nav-pill" 
    class="fixed bottom-6 right-6 z-40 hidden xl:flex items-center gap-1.5 p-1.5 rounded-full bg-midnight/90 backdrop-blur-xl border border-ivory/10 shadow-2xl transition-all duration-300"
    aria-label="Story chapters"
  >
    <a href="#biography" class="chapter-dot px-3 py-1.5 rounded-full text-[11px] font-mono text-sage hover:text-ivory transition-colors" data-section="biography">
      01 Bio
    </a>
    <a href="#background" class="chapter-dot px-3 py-1.5 rounded-full text-[11px] font-mono text-sage hover:text-ivory transition-colors" data-section="background">
      02 Background
    </a>
    <a href="#milestones-section" class="chapter-dot px-3 py-1.5 rounded-full text-[11px] font-mono text-sage hover:text-ivory transition-colors" data-section="milestones-section">
      03 Milestones
    </a>
    <a href="#practice" class="chapter-dot px-3 py-1.5 rounded-full text-[11px] font-mono text-sage hover:text-ivory transition-colors" data-section="practice">
      04 Practice
    </a>
    <a href="#consultation" class="chapter-dot px-3 py-1.5 rounded-full text-[11px] font-mono text-sage hover:text-ivory transition-colors" data-section="consultation">
      05 Book
    </a>
  </aside>

</Layout>

<style>
  /* Reveal states triggered by scroll observers */
  .is-revealed {
    opacity: 1 !important;
    transform: translate(0, 0) scale(1) !important;
  }

  /* Active chapter dot styling */
  .chapter-dot.active-chapter {
    background-color: rgba(193, 122, 62, 0.2);
    color: #C17A3E;
    font-weight: 600;
  }

  /* Reduced motion fallback */
  @media (prefers-reduced-motion: reduce) {
    .about-hero-item,
    .about-portrait-wrapper,
    .scroll-reveal,
    .stat-reveal-card,
    .practice-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    #about-scroll-progress {
      display: none !important;
    }
  }
</style>

<script>
  function initAboutScrollAnimations() {
    // 1. Top Scroll Reading Progress Line
    const progressBar = document.getElementById('about-scroll-progress');
    function updateProgressBar() {
      if (!progressBar) return;
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      progressBar.style.width = `${progress}%`;
    }
    window.addEventListener('scroll', updateProgressBar, { passive: true });
    updateProgressBar();

    // 2. Hero entrance trigger on mount
    const heroItems = document.querySelectorAll('.about-hero-item');
    const portrait = document.querySelector('.about-portrait-wrapper');
    
    setTimeout(() => {
      heroItems.forEach(el => el.classList.add('is-revealed'));
      if (portrait) portrait.classList.add('is-revealed');
    }, 100);

    // 3. General Scroll Reveal Observer
    const revealElements = document.querySelectorAll('.scroll-reveal, .stat-reveal-card, .practice-card');
    const scrollObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.1 });

    revealElements.forEach(el => scrollObserver.observe(el));

    // 4. Parallax Depth on Hero Portrait and Ambient Orbs
    const glow1 = document.getElementById('hero-glow-1');
    const glow2 = document.getElementById('hero-glow-2');

    function handleParallax() {
      const scrollY = window.scrollY;
      if (scrollY < 900) {
        if (portrait) {
          portrait.style.transform = `translateY(${scrollY * 0.08}px)`;
        }
        if (glow1) {
          glow1.style.transform = `translate(${scrollY * -0.05}px, ${scrollY * 0.05}px)`;
        }
        if (glow2) {
          glow2.style.transform = `translate(${scrollY * 0.04}px, ${scrollY * -0.03}px)`;
        }
      }
    }
    window.addEventListener('scroll', handleParallax, { passive: true });

    // 5. Chapter Indicator Active Detection
    const sections = ['biography', 'background', 'milestones-section', 'practice', 'consultation'];
    const chapterDots = document.querySelectorAll('.chapter-dot');

    function updateActiveChapter() {
      const scrollPosition = window.scrollY + (window.innerHeight * 0.35);
      
      let currentSection = sections[0];
      for (const sectionId of sections) {
        const el = document.getElementById(sectionId);
        if (el) {
          const top = el.offsetTop;
          if (scrollPosition >= top) {
            currentSection = sectionId;
          }
        }
      }

      chapterDots.forEach(dot => {
        if (dot.getAttribute('data-section') === currentSection) {
          dot.classList.add('active-chapter');
        } else {
          dot.classList.remove('active-chapter');
        }
      });
    }

    window.addEventListener('scroll', updateActiveChapter, { passive: true });
    updateActiveChapter();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutScrollAnimations);
  } else {
    initAboutScrollAnimations();
  }
</script>
