---
// about.astro
// Cinematic Continuous Biography Experience

import Layout from '../layouts/Layout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import RecognitionAwards from '../components/RecognitionAwards.astro';
import CTAStrip from '../components/CTAStrip.astro';

// Chapters for the Scroll Indicator
const chapters = [
  { id: 'intro', label: '01 Intro' },
  { id: 'journey', label: '02 Journey' },
  { id: 'expertise', label: '03 Expertise' },
  { id: 'recognition', label: '04 Recognition' },
  { id: 'research', label: '05 Research' },
  { id: 'impact', label: '06 Impact' },
];

---

<Layout
  title="About Dr. Sylvia V. Shitsama | Neurosurgery, Precision, Purpose"
  description="The professional journey of Dr. Sylvia V. Shitsama — Consultant Neurosurgeon, researcher, educator and advocate advancing neurosurgical care across East Africa."
  canonicalUrl="/about"
>
  
  <!-- Fixed Scroll Progress Indicator (Desktop) -->
  <nav class="hidden lg:flex fixed left-8 top-1/2 -translate-y-1/2 z-50 flex-col gap-6" aria-label="Page chapters" x-data="{ activeSection: 'intro' }" @scroll.window="let current = 'intro'; const sections = ['intro', 'journey', 'expertise', 'recognition', 'research', 'impact']; for(const section of sections) { const el = document.getElementById(section); if(el && window.scrollY >= (el.offsetTop - window.innerHeight/2)) { current = section; } } activeSection = current;">
    {chapters.map((chapter) => (
      <a 
        href={`#${chapter.id}`}
        class="flex items-center gap-4 group transition-all"
        :class={`activeSection === '${chapter.id}' ? 'opacity-100' : 'opacity-30 hover:opacity-70'`}
      >
        <span class="font-mono text-[9px] uppercase tracking-[0.2em] transition-colors" :class={`activeSection === '${chapter.id}' ? 'text-copper' : 'text-ivory'`}>{chapter.label}</span>
        <div class="w-8 h-px transition-colors" :class={`activeSection === '${chapter.id}' ? 'bg-copper' : 'bg-ivory'`}></div>
      </a>
    ))}
  </nav>

  <!-- Mobile Top Progress Bar -->
  <div class="lg:hidden fixed top-0 left-0 w-full h-1 bg-midnight z-50" x-data="{ progress: 0 }" @scroll.window="progress = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100">
    <div class="h-full bg-copper transition-all duration-100" :style="`width: ${progress}%`"></div>
  </div>

  <!-- 01 / INTRO (HERO & BIOGRAPHY) -->
  <div id="intro" class="relative bg-midnight pt-24">
    
    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center overflow-hidden">
      <!-- Ambient background -->
      <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute top-1/4 right-1/3 w-[600px] h-[600px] bg-copper/5 rounded-full blur-[120px]"></div>
        <div class="absolute inset-0 opacity-[0.02] bg-[url('/images/noise.png')] mix-blend-overlay"></div>
        <!-- Subtle anatomical grid -->
        <svg class="absolute inset-0 w-full h-full opacity-[0.03]" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M 0 20 L 100 20 M 0 40 L 100 40 M 0 60 L 100 60 M 0 80 L 100 80 M 20 0 L 20 100 M 40 0 L 40 100 M 60 0 L 60 100 M 80 0 L 80 100" stroke="#F3EFE6" stroke-width="0.1" fill="none"/>
        </svg>
      </div>

      <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 relative z-10 lg:pl-48 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          
          <div class="fade-up">
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase mb-6 block">About Dr. Sylvia Shitsama</span>
            <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-semibold text-ivory leading-[1.1] mb-6 tracking-tight">
              Neurosurgery.<br/>
              <span class="text-copper italic">Precision. Purpose. Impact.</span>
            </h1>
            <p class="text-sage text-lg sm:text-xl font-light max-w-lg leading-relaxed mb-10">
              A pioneering neurosurgeon committed to delivering the highest quality care, advancing global neurosurgical knowledge, and expanding access to specialist care.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
              <a href="#journey" class="inline-flex items-center justify-center gap-3 bg-copper hover:bg-copper-dark text-white px-8 py-4 rounded-lg font-medium transition-all hover:-translate-y-1 shadow-lg hover:shadow-copper/20 group cursor-pointer">
                Explore Her Journey
                <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              </a>
              <a href="/contact" class="inline-flex items-center justify-center gap-3 border border-ivory/20 hover:border-ivory/50 text-ivory px-8 py-4 rounded-lg font-medium transition-all hover:bg-ivory/5 group">
                Book a Consultation
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>

          <!-- Layered Portrait Composition -->
          <div class="relative w-full max-w-md mx-auto fade-up delay-200 parallax-portrait">
            <!-- Decorative framing -->
            <div class="absolute -inset-4 border border-copper/20 rounded-2xl transform translate-x-4 translate-y-4"></div>
            <div class="absolute -inset-4 border border-ivory/10 rounded-2xl transform -translate-x-4 -translate-y-4"></div>
            
            <div class="relative rounded-2xl overflow-hidden aspect-[3/4] bg-midnight-light border border-ivory/10 shadow-2xl">
              <!-- Portrait Image -->
              <img 
                src="/images/dr-shitsama-headshot.jpg" 
                alt="Dr. Sylvia Shitsama"
                class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-midnight via-transparent to-transparent"></div>
            </div>
            
            <!-- Connection Line connecting Hero to Bio -->
            <div class="absolute -bottom-24 left-1/2 w-px h-24 bg-gradient-to-b from-copper to-transparent"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- The Specialist (Biography) -->
    <section class="py-24 sm:py-32 relative">
      <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 lg:pl-48 relative z-10">
        <div class="max-w-4xl">
          <span class="font-mono-label text-sage tracking-[0.2em] uppercase text-xs mb-8 block fade-up">The Specialist</span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-ivory mb-16 leading-tight fade-up delay-100">
            A pioneering neurosurgeon committed to advancing care, knowledge, and opportunity.
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-24">
            <div class="md:col-span-7 space-y-8 fade-up delay-200">
              <p class="text-sage text-lg font-light leading-relaxed">
                Born in Kakamega County, Dr. Sylvia Shitsama's journey into medicine was driven by an early fascination with human anatomy and an unwavering determination to master one of the most demanding surgical disciplines.
              </p>
              <p class="text-sage text-lg font-light leading-relaxed">
                Her qualification made history, breaking gender barriers in East African neurosurgery. Today, she combines rigorous clinical practice with academic research, holding an international fellowship from the University of Toronto.
              </p>
            </div>
            <div class="md:col-span-5 space-y-8 fade-up delay-300 border-l border-ivory/10 pl-8">
              <div>
                <div class="text-ivory font-medium mb-1">Mmed Neurosurgery</div>
                <div class="text-sage text-sm">University of Nairobi</div>
              </div>
              <div>
                <div class="text-ivory font-medium mb-1">Clinical Fellowship</div>
                <div class="text-sage text-sm">University of Toronto, Canada</div>
              </div>
              <div>
                <div class="text-ivory font-medium mb-1">Former Board Member</div>
                <div class="text-sage text-sm">Hydrocephalus Society</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Visual bridge to Journey -->
      <svg class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-full max-w-2xl h-32 pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path class="neural-pathway" d="M 50 0 C 50 40, 20 60, 50 100" stroke="#C17A3E" stroke-width="0.5" fill="none" stroke-dasharray="2 4"/>
      </svg>
    </section>
  </div>

  <!-- 02 / JOURNEY -->
  <div id="journey" class="relative">
    <JourneyTimeline />
  </div>

  <!-- 03 / EXPERTISE PREVIEW -->
  <div id="expertise" class="relative bg-midnight py-24 sm:py-32 border-t border-ivory/5">
    
    <!-- Transition Line -->
    <div class="absolute -top-1 left-1/2 w-px h-16 bg-gradient-to-b from-copper to-transparent"></div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 lg:pl-48 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <div class="fade-up">
          <span class="font-mono-label text-sage tracking-[0.2em] uppercase text-xs mb-8 block">Specialist Expertise</span>
          <h2 class="font-display text-4xl lg:text-5xl font-medium text-ivory mb-6 leading-tight">
            Where Precision Meets Experience
          </h2>
          <p class="text-sage text-lg font-light leading-relaxed mb-10 max-w-lg">
            Comprehensive surgical care spanning complex cranial neurosurgery, spinal reconstruction, neuro-oncology, and paediatric hydrocephalus.
          </p>
          <ul class="space-y-4 mb-10 border-l border-ivory/10 pl-6">
            <li class="text-ivory font-medium">Brain & Cranial Neurosurgery</li>
            <li class="text-ivory font-medium">Spinal Surgery</li>
            <li class="text-ivory font-medium">Head & Spine Trauma</li>
            <li class="text-ivory font-medium">Paediatric Neurosurgery</li>
          </ul>
          <a href="/expertise" class="inline-flex items-center gap-2 text-copper hover:text-ivory transition-colors font-mono uppercase tracking-widest text-sm font-semibold group">
            Explore All Expertise 
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Mini Interactive Anatomy Viewer -->
        <div class="relative aspect-square bg-midnight-light border border-ivory/5 rounded-3xl shadow-2xl flex items-center justify-center fade-up delay-200 overflow-hidden group perspective-container" x-data="{ view: 'brain' }">
          
          <!-- Toggle -->
          <div class="absolute top-6 left-1/2 -translate-x-1/2 z-20 flex bg-midnight border border-ivory/10 rounded-full p-1">
            <button @click="view = 'brain'" class="px-4 py-1.5 rounded-full text-xs font-mono tracking-widest transition-colors" :class="view === 'brain' ? 'bg-copper text-white' : 'text-sage hover:text-ivory'">BRAIN</button>
            <button @click="view = 'spine'" class="px-4 py-1.5 rounded-full text-xs font-mono tracking-widest transition-colors" :class="view === 'spine' ? 'bg-copper text-white' : 'text-sage hover:text-ivory'">SPINE</button>
          </div>

          <!-- Brain -->
          <div class="absolute inset-0 flex items-center justify-center transition-all duration-700 transform-style-3d group-hover:rotate-x-12" :class="view === 'brain' ? 'opacity-100 scale-100' : 'opacity-0 scale-90 blur-sm pointer-events-none'">
            <img src="/images/brain.png" alt="Brain Anatomy Preview" class="w-[70%] h-[70%] object-contain drop-shadow-[0_0_30px_rgba(193,122,62,0.15)] transform-style-3d" style="transform: translateZ(30px);" />
          </div>
          
          <!-- Spine -->
          <div class="absolute inset-0 flex items-center justify-center transition-all duration-700 transform-style-3d group-hover:rotate-x-12" :class="view === 'spine' ? 'opacity-100 scale-100' : 'opacity-0 scale-90 blur-sm pointer-events-none'">
            <img src="/images/spine.png" alt="Spine Anatomy Preview" class="w-[70%] h-[70%] object-contain drop-shadow-[0_0_30px_rgba(193,122,62,0.15)] transform-style-3d" style="transform: translateZ(30px);" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- 04 / RECOGNITION -->
  <div id="recognition" class="relative">
    <RecognitionAwards />
  </div>

  <!-- 05 / RESEARCH PREVIEW -->
  <div id="research" class="relative bg-midnight-light py-24 sm:py-32 border-y border-ivory/5">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 lg:pl-48 relative z-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
        <div class="lg:col-span-8 fade-up">
          <span class="font-mono-label text-sage tracking-[0.2em] uppercase text-xs mb-8 block">Academic Research</span>
          <h2 class="font-display text-4xl lg:text-5xl font-medium text-ivory mb-6 leading-tight">
            Evidence Is the Foundation of Care.
          </h2>
          <p class="text-sage text-lg font-light leading-relaxed max-w-xl">
            Committed to advancing the field of neurosurgery through active research, peer-reviewed publication, and data-driven clinical practice.
          </p>
        </div>
        
        <div class="lg:col-span-4 flex flex-row lg:flex-col gap-8 fade-up delay-200 border-l border-ivory/10 pl-8">
          <div>
            <div class="font-display text-4xl font-semibold text-ivory mb-1">20</div>
            <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">Peer-Reviewed Pubs</div>
          </div>
          <div>
            <div class="font-display text-4xl font-semibold text-ivory mb-1">58<span class="text-copper">+</span></div>
            <div class="font-mono-label text-copper text-[10px] uppercase tracking-widest">Citations</div>
          </div>
        </div>
      </div>

      <!-- Selected Research Rows with Keynote Feature Image -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-center">
        <div class="lg:col-span-6 space-y-4 fade-up delay-300">
          <a href="/research" class="block group">
            <div class="bg-midnight border border-ivory/5 hover:border-copper/30 transition-colors rounded-2xl p-6 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-copper">Medical Teacher · 2026</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-copper/10 text-copper border border-copper/20">Featured Keynote</span>
              </div>
              <h3 class="font-display text-lg text-ivory group-hover:text-copper transition-colors">Fit for Context: Faculty Perspectives on Mentorship & Culture in Sub-Saharan Africa</h3>
              <p class="text-sage text-xs font-light leading-relaxed">Qualitative research with Maastricht University School of Health Professions Education presented at AMEE Vienna.</p>
            </div>
          </a>
          <a href="/research" class="block group">
            <div class="bg-midnight border border-ivory/5 hover:border-copper/30 transition-colors rounded-2xl p-6 flex flex-col gap-2">
              <div class="font-mono text-xs text-copper">Neurosurgical Review · 2025</div>
              <h3 class="font-display text-lg text-ivory group-hover:text-copper transition-colors">Neurosurgical Workforce & Capacity in East Africa</h3>
              <p class="text-sage text-xs font-light leading-relaxed">A landmark collaborative survey establishing baseline infrastructure and training needs across the region.</p>
            </div>
          </a>
          <a href="/research" class="block group">
            <div class="bg-midnight border border-ivory/5 hover:border-copper/30 transition-colors rounded-2xl p-6 flex flex-col gap-2">
              <div class="font-mono text-xs text-copper">PLOS ONE · 2025</div>
              <h3 class="font-display text-lg text-ivory group-hover:text-copper transition-colors">Leadership Education in Neurosurgery</h3>
              <p class="text-sage text-xs font-light leading-relaxed">Evaluating the curriculum needs, rationale, and career outcomes for surgical leadership programs.</p>
            </div>
          </a>
        </div>

        <!-- Right: Keynote Presentation Frame -->
        <div class="lg:col-span-6 fade-up delay-400">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-ivory/15 bg-midnight group">
            <img
              src="/images/dr-sylvia-amee-presentation-wide.jpg"
              alt="Dr. Sylvia Shitsama presenting at AMEE Vienna"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700 block"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-midnight/90 via-midnight/20 to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-midnight/90 backdrop-blur-md border border-copper/30">
              <span class="text-[10px] font-mono text-copper uppercase tracking-wider block mb-1">AMEE Vienna Keynote Lecture</span>
              <p class="text-xs text-ivory font-light">
                Presenting qualitative findings on building sustainable mentorship ecosystems across Sub-Saharan Africa.
              </p>
            </div>
          </div>
        </div>
      </div>

      <a href="/research" class="inline-flex items-center gap-2 text-copper hover:text-ivory transition-colors font-mono uppercase tracking-widest text-sm font-semibold group fade-up delay-400">
        Explore All 20+ Peer-Reviewed Publications 
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>

    </div>
  </div>

  <!-- 06 / IMPACT -->
  <div id="impact" class="relative bg-midnight py-24 sm:py-32">
    <!-- Visual background connection -->
    <svg class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-full opacity-5 pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path class="neural-pathway" d="M 50 0 C 80 30, 20 70, 50 100" stroke="#F3EFE6" stroke-width="0.2" fill="none"/>
    </svg>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 lg:pl-48 relative z-10 text-center mb-16 fade-up">
      <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-8 block">Beyond the Operating Theatre</span>
      <h2 class="font-display text-4xl lg:text-5xl font-medium text-ivory">
        A Broader Impact
      </h2>
    </div>

    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 lg:pl-48 relative z-10">
      <!-- 4 Pillars Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <div class="bg-midnight-light border border-ivory/5 p-6 rounded-2xl text-center group hover:border-copper/20 transition-colors fade-up">
          <div class="w-10 h-10 rounded-full bg-copper/10 text-copper flex items-center justify-center mx-auto mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 12m-9 0a9 9 0 1018 0 9 9 0 10-18 0zm0 0m-5 0a5 5 0 1010 0 5 5 0 10-10 0zm0 0m-1 0a1 1 0 102 0 1 1 0 10-2 0"/></svg>
          </div>
          <h3 class="font-display text-lg text-ivory mb-2">Clinical Care</h3>
          <p class="text-sage text-xs font-light">Delivering specialist surgical intervention to patients across East Africa.</p>
        </div>
        <div class="bg-midnight-light border border-ivory/5 p-6 rounded-2xl text-center group hover:border-copper/20 transition-colors fade-up delay-100">
          <div class="w-10 h-10 rounded-full bg-copper/10 text-copper flex items-center justify-center mx-auto mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          </div>
          <h3 class="font-display text-lg text-ivory mb-2">Research</h3>
          <p class="text-sage text-xs font-light">Contributing valuable data and outcomes to global neurosurgical literature.</p>
        </div>
        <div class="bg-midnight-light border border-ivory/5 p-6 rounded-2xl text-center group hover:border-copper/20 transition-colors fade-up delay-200">
          <div class="w-10 h-10 rounded-full bg-copper/10 text-copper flex items-center justify-center mx-auto mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="font-display text-lg text-ivory mb-2">Education</h3>
          <p class="text-sage text-xs font-light">Training the next generation of surgeons as an academic and lecturer at JKUAT.</p>
        </div>
        <div class="bg-midnight-light border border-ivory/5 p-6 rounded-2xl text-center group hover:border-copper/20 transition-colors fade-up delay-300">
          <div class="w-10 h-10 rounded-full bg-copper/10 text-copper flex items-center justify-center mx-auto mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
          </div>
          <h3 class="font-display text-lg text-ivory mb-2">Mentorship</h3>
          <p class="text-sage text-xs font-light">Advocating for women in surgery and expanding healthcare access.</p>
        </div>
      </div>

      <!-- Photographic Impact Visual Card -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-midnight-light border border-ivory/10 rounded-3xl p-6 sm:p-8 shadow-2xl fade-up">
        <div class="rounded-2xl overflow-hidden border border-ivory/15 bg-midnight">
          <img
            src="/images/dr-sylvia-amee-vienna-connect.jpg"
            alt="Dr. Sylvia Shitsama at AMEE Connect Grow Inspire"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
        <div class="space-y-4">
          <span class="text-xs font-mono text-copper uppercase tracking-wider block">Global Leadership & Advocacy</span>
          <h3 class="font-display text-2xl sm:text-3xl font-semibold text-ivory">
            Connecting Regional Excellence with the Global Stage
          </h3>
          <p class="text-sage text-sm font-light leading-relaxed">
