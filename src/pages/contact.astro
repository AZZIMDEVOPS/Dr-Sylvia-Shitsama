---
// contact.astro
// Clean, simplified contact and consultation booking page
// Official clinic contact details, location prominence, interactive map, and WhatsApp CTA

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Book a Consultation — Dr. Sylvia Shitsama | Sage Brain & Spine Clinic"
  description="Contact Sage Brain & Spine Clinic in Nairobi. Book a neurosurgical consultation with Dr. Sylvia Shitsama at KNH Doctors Plaza, Suite 43. Phone: 0110 090 116."
  canonicalUrl="/contact"
>
  <!-- Page Header -->
  <section class="pt-32 pb-16 bg-midnight border-b border-ivory/10 relative overflow-hidden">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-[1px] bg-copper"></span>
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs">Consultation &amp; Inquiries</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ivory tracking-tight mb-6">
        Contact Sage Brain &amp; Spine Clinic
      </h1>
      <p class="text-sage text-lg sm:text-xl font-light leading-relaxed max-w-2xl mb-8">
        We welcome patients for consultations, surgical evaluations, second opinions, and physician referrals in Nairobi.
      </p>

      <!-- Primary Action CTA Banner -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a 
          href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Sylvia%20Shitsama." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-primary flex items-center justify-center gap-2 text-base px-8 py-4"
        >
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Book a Consultation (WhatsApp)
        </a>
        <a 
          href="tel:0110090116" 
          class="btn-ghost flex items-center justify-center gap-2 text-base px-6 py-4"
        >
          <svg class="w-5 h-5 text-copper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call Desk: 0110 090 116
        </a>
      </div>
    </div>
  </section>

  <!-- Main Grid: Clinic Details & Inquiry Options -->
  <section class="py-20 bg-midnight-light border-b border-ivory/10">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

        <!-- Left Column: Official Contact Information (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-3 block">Clinic Details</span>
            <h2 class="font-display text-3xl font-semibold text-ivory mb-6">Official Practice Information</h2>
          </div>

          <!-- Physical Address Card -->
          <div class="p-6 rounded-2xl bg-midnight border border-ivory/10 shadow-lg">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-copper/10 text-copper flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-display text-lg font-semibold text-ivory mb-1">Physical Clinic Location</h3>
                <p class="text-sm text-ivory font-medium">Sage Brain &amp; Spine Clinic</p>
                <p class="text-sm text-sage font-light mt-0.5">KNH Doctors Plaza, Suite 43 (4th Floor)</p>
                <p class="text-sm text-sage font-light">Hospital Road, Nairobi, Kenya</p>
                <p class="text-xs text-copper/80 font-mono mt-2">Opposite Kenyatta National Hospital Main Entrance</p>
              </div>
            </div>
          </div>

          <!-- Phone Lines Card -->
          <div class="p-6 rounded-2xl bg-midnight border border-ivory/10 shadow-lg">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-copper/10 text-copper flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="font-display text-lg font-semibold text-ivory mb-1">Telephone &amp; Office Lines</h3>
                <div>
                  <a href="tel:0110090116" class="text-ivory font-mono text-base hover:text-copper transition-colors block">
                    0110 090 116
                  </a>
                  <a href="tel:0793886357" class="text-ivory font-mono text-base hover:text-copper transition-colors block">
                    0793 886 357
                  </a>
                </div>
                <p class="text-xs text-sage font-light pt-1">Mon – Fri: 8:00 AM – 5:00 PM</p>
              </div>
            </div>
          </div>

          <!-- WhatsApp Direct Card -->
          <div class="p-6 rounded-2xl bg-midnight border border-[#25D366]/30 shadow-lg">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <h3 class="font-display text-lg font-semibold text-ivory mb-1">Official Clinic WhatsApp</h3>
                <a 
                  href="https://wa.me/254110090116?text=Hello%20Sage%20Brain%20%26%20Spine%20Clinic%2C%20I%20would%20like%20to%20book%20a%20consultation." 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-[#25D366] font-mono text-base font-medium hover:underline block"
                >
                  +254 110 090 116
                </a>
                <p class="text-xs text-sage font-light mt-1">Direct messaging with clinic front desk</p>
              </div>
            </div>
          </div>

          <!-- Email Card (Retained primarily for international inquiries) -->
          <div class="p-6 rounded-2xl bg-midnight border border-ivory/10 shadow-lg">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-copper/10 text-copper flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <h3 class="font-display text-lg font-semibold text-ivory mb-1">Email (International Inquiries)</h3>
                <a href="mailto:info@drsylviashitsama.com" class="text-sage hover:text-copper transition-colors text-sm font-light block">
                  info@drsylviashitsama.com
                </a>
                <p class="text-xs text-sage/70 font-light mt-1">Recommended for international second opinions and formal referrals</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Consultation Inquiry Form (7 cols) -->
        <div class="lg:col-span-7">
          <div 
            class="bg-midnight border border-ivory/10 rounded-2xl p-8 lg:p-10 shadow-2xl relative"
            x-data="{
              step: 1,
              type: 'consultation',
              fullName: '',
              phone: '',
              email: '',
              message: '',
              submitting: false,
              submitted: false,
              error: false,
              submitInquiry() {
                this.submitting = true;
                // Redirect user to WhatsApp with prefilled message containing their inquiry details
                const text = `Hello Sage Brain & Spine Clinic,\n\nName: ${this.fullName}\nPhone: ${this.phone}\nEmail: ${this.email}\nInquiry Type: ${this.type}\nMessage: ${this.message}`;
                const waUrl = `https://wa.me/254110090116?text=${encodeURIComponent(text)}`;
                setTimeout(() => {
                  this.submitting = false;
                  this.submitted = true;
                  window.open(waUrl, '_blank');
                }, 500);
              }
            }"
          >
            <div class="mb-8">
              <span class="font-mono text-xs text-copper uppercase tracking-wider block mb-2">Consultation Booking</span>
              <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ivory">Send an Online Inquiry</h2>
              <p class="text-xs sm:text-sm text-sage font-light mt-2 leading-relaxed">
                Provide your details below to connect directly with the clinic front desk via WhatsApp or phone.
              </p>
            </div>

            <!-- Success Message -->
            <div x-show="submitted" class="text-center py-8" style="display: none;">
              <div class="w-16 h-16 rounded-full bg-copper/10 border border-copper/30 flex items-center justify-center mx-auto mb-4 text-copper">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="font-display text-2xl font-semibold text-ivory mb-2">Inquiry Forwarded</h3>
              <p class="text-sage text-sm font-light max-w-md mx-auto mb-6">
                Your consultation request has been forwarded to our WhatsApp clinic line. A team member will assist you shortly.
              </p>
              <button @click="submitted = false; step = 1" class="btn-ghost text-xs">
                Submit Another Request
              </button>
            </div>

            <!-- Form -->
            <form x-show="!submitted" @submit.prevent="submitInquiry" class="space-y-6">
              
              <!-- Referral Type -->
              <div>
                <label class="block text-xs font-mono uppercase tracking-wider text-sage mb-2">Inquiry Type</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <label class="p-3 rounded-xl border border-ivory/10 flex items-center gap-2 cursor-pointer transition-colors" :class="type === 'consultation' ? 'bg-copper/10 border-copper text-ivory' : 'text-sage hover:border-ivory/30'">
                    <input type="radio" name="type" value="consultation" x-model="type" class="text-copper focus:ring-copper">
                    <span class="text-xs">Patient Self-Referral</span>
                  </label>
                  <label class="p-3 rounded-xl border border-ivory/10 flex items-center gap-2 cursor-pointer transition-colors" :class="type === 'physician' ? 'bg-copper/10 border-copper text-ivory' : 'text-sage hover:border-ivory/30'">
                    <input type="radio" name="type" value="physician" x-model="type" class="text-copper focus:ring-copper">
                    <span class="text-xs">Physician Referral</span>
                  </label>
                  <label class="p-3 rounded-xl border border-ivory/10 flex items-center gap-2 cursor-pointer transition-colors" :class="type === 'general' ? 'bg-copper/10 border-copper text-ivory' : 'text-sage hover:border-ivory/30'">
                    <input type="radio" name="type" value="general" x-model="type" class="text-copper focus:ring-copper">
                    <span class="text-xs">General / Other</span>
                  </label>
                </div>
              </div>

              <!-- Full Name -->
              <div>
                <label class="block text-xs font-mono uppercase tracking-wider text-sage mb-2">Patient / Doctor Full Name</label>
                <input 
                  type="text" 
                  x-model="fullName" 
                  required 
                  placeholder="e.g. John Kamau"
                  class="w-full bg-midnight-light border border-ivory/15 focus:border-copper rounded-xl px-4 py-3 text-ivory placeholder-sage/40 text-sm focus:outline-none transition-colors"
                >
              </div>

              <!-- Phone & Email Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-mono uppercase tracking-wider text-sage mb-2">Phone Number</label>
                  <input 
                    type="tel" 
                    x-model="phone" 
                    required 
                    placeholder="e.g. 0712 345 678"
                    class="w-full bg-midnight-light border border-ivory/15 focus:border-copper rounded-xl px-4 py-3 text-ivory placeholder-sage/40 text-sm focus:outline-none transition-colors"
                  >
                </div>
                <div>
                  <label class="block text-xs font-mono uppercase tracking-wider text-sage mb-2">Email Address</label>
                  <input 
                    type="email" 
                    x-model="email" 
                    placeholder="e.g. name@example.com"
                    class="w-full bg-midnight-light border border-ivory/15 focus:border-copper rounded-xl px-4 py-3 text-ivory placeholder-sage/40 text-sm focus:outline-none transition-colors"
                  >
                </div>
              </div>

              <!-- Brief Message -->
              <div>
                <label class="block text-xs font-mono uppercase tracking-wider text-sage mb-2">Brief Summary of Condition or Referral</label>
                <textarea 
                  rows="3" 
                  x-model="message"
                  placeholder="Briefly state symptoms, duration, or whether you have recent MRI/CT scans..."
                  class="w-full bg-midnight-light border border-ivory/15 focus:border-copper rounded-xl px-4 py-3 text-ivory placeholder-sage/40 text-sm focus:outline-none transition-colors resize-none"
                ></textarea>
                <p class="text-[11px] text-sage/60 font-light mt-1">Please do not include sensitive financial or private records in this message.</p>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button 
                  type="submit" 
                  :disabled="submitting"
                  class="w-full btn-primary py-3.5 flex items-center justify-center gap-2 text-sm font-medium"
                >
                  <span x-show="!submitting">Continue to WhatsApp Booking &rarr;</span>
                  <span x-show="submitting">Connecting...</span>
                </button>
              </div>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Interactive Map & Physical Location Section -->
  <section class="py-20 bg-midnight" id="clinic-map">
    <div class="container-custom mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="font-mono-label text-copper tracking-[0.2em] uppercase text-xs mb-2 block">Map &amp; Directions</span>
        <h2 class="font-display text-3xl font-semibold text-ivory mb-3">Clinic Location Map</h2>
        <p class="text-sage text-sm font-light leading-relaxed">
          KNH Doctors Plaza, Suite 43, Hospital Road, Nairobi. Easily accessible via Hospital Road or Mbagathi Way. Secure parking available on-site.
        </p>
      </div>

      <!-- Google Maps Embed -->
      <div class="relative w-full h-96 sm:h-[480px] rounded-3xl overflow-hidden bg-midnight-light border border-ivory/15 shadow-2xl">
        <iframe
          title="Sage Brain & Spine Clinic - KNH Doctors Plaza Nairobi"
          src="https://maps.google.com/maps?q=KNH+Doctors+Plaza,+Hospital+Road,+Nairobi,+Kenya&t=&z=16&ie=UTF8&iwloc=&output=embed"
          class="w-full h-full border-0 filter invert-[90%] hue-rotate-[180deg] contrast-[90%] brightness-[85%]"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Directions Footnote -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-midnight-light border border-ivory/10 text-xs text-sage">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-copper shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Visiting Suite 43: Take the main elevators to the 4th Floor of KNH Doctors Plaza.</span>
        </div>
        <a 
          href="https://maps.google.com/?q=KNH+Doctors+Plaza+Nairobi" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-copper hover:text-white uppercase font-mono tracking-wider font-semibold shrink-0"
        >
          Open in Google Maps &rarr;
        </a>
      </div>

    </div>
  </section>
</Layout>
